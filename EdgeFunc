function parseImdbRatingPercent(raw) {
  const s = String(raw ?? "").trim();
  if (!s || s.toUpperCase() === "N/A") return null;
  const n = Number(s);
  if (!Number.isFinite(n) || n <= 0) return null;
  // OMDb imdbRating is typically 0-10 (string). Convert to 0-100 percent.
  const pct = Math.round(n * 10);
  if (!Number.isFinite(pct)) return null;
  return Math.max(0, Math.min(100, pct));
}

async function fetchOmdbImdbRatingPercent({ imdb_id, title, year, omdbApiKey }) {
  if (!omdbApiKey) return { ok: false, pct: null, reason: "Missing OMDB_API_KEY" };

  const id = String(imdb_id ?? "").trim();
  const t = String(title ?? "").trim();
  const y = year === null || year === undefined ? null : Number(year);

  const url = new URL("https://www.omdbapi.com/");
  url.searchParams.set("apikey", String(omdbApiKey));
  if (id) url.searchParams.set("i", id);
  else if (t) url.searchParams.set("t", t);
  else return { ok: false, pct: null, reason: "Missing imdb_id/title" };
  if (Number.isFinite(y) && y > 0) url.searchParams.set("y", String(Math.floor(y)));

  const res = await fetch(url.toString());
  if (!res.ok) {
    const details = await res.text().catch(() => "");
    return { ok: false, pct: null, reason: `OMDb HTTP ${res.status}${details ? `: ${details}` : ""}` };
  }

  const json = await res.json().catch(() => null);
  const ok = String(json?.Response ?? "").toLowerCase() === "true";
  if (!ok) {
    const err = String(json?.Error ?? "").trim();
    return { ok: false, pct: null, reason: err || "OMDb lookup failed" };
  }

  const pct = parseImdbRatingPercent(json?.imdbRating);
  return { ok: pct !== null, pct, reason: pct === null ? "Missing/invalid imdbRating" : null };
}

