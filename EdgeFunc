function extractTmdbYearFromReleaseDate(releaseDate) {
  const y = releaseDate ? Number(String(releaseDate).slice(0, 4)) : null;
  return Number.isFinite(y) ? y : null;
}

function inferYearRangeFromSimilarMovie(year) {
  if (!Number.isFinite(year)) return { from: null, to: null };
  const start = Math.floor(year / 10) * 10;
  return { from: start, to: start + 10 };
}

function promptMentionsRuntime(prompt) {
  const p = String(prompt ?? "").toLowerCase();
  if (!p) return false;
  const explicit = /\b(runtime|length|duration|minutes?|mins?|hours?|hrs?|hr\b)\b/.test(p);
  const numeric = /\b\d{1,3}\s*(min|mins|minutes|hr|hrs|hour|hours)\b/.test(p);
  const comparative = /\b(shorter|longer)\s+than\b/.test(p);
  return explicit || numeric || comparative;
}

function inferGenresFromPrompt(prompt) {
  const p = String(prompt ?? "").toLowerCase();
  if (!p) return [];
  const rules = [
    { genre: "Action", kws: ["action", "explosion", "gunfight", "car chase", "martial", "kung fu", "superhero"] },
    { genre: "Adventure", kws: ["adventure", "quest", "journey", "expedition"] },
    { genre: "Animation", kws: ["animated", "animation", "anime", "pixar", "cartoon"] },
    { genre: "Comedy", kws: ["comedy", "funny", "hilarious", "rom-com", "romcom", "satire"] },
    { genre: "Crime", kws: ["crime", "heist", "detective", "murder", "gangster", "mob"] },
    { genre: "Documentary", kws: ["documentary", "docu", "true story"] },
    { genre: "Drama", kws: ["drama", "emotional", "character study", "heartfelt"] },
    { genre: "Family", kws: ["family", "kids", "kid-friendly", "all ages"] },
    { genre: "Fantasy", kws: ["fantasy", "magic", "wizard", "myth", "dragon"] },
    { genre: "History", kws: ["historical", "history", "period piece", "biopic"] },
    { genre: "Horror", kws: ["horror", "scary", "haunted", "slasher", "creepy", "ghost"] },
    { genre: "Music", kws: ["music", "musical", "concert", "band"] },
    { genre: "Mystery", kws: ["mystery", "whodunit", "investigation"] },
    { genre: "Romance", kws: ["romance", "romantic", "love story"] },
    { genre: "Sci-Fi", kws: ["sci-fi", "science fiction", "space", "alien", "dystopian", "future"] },
    { genre: "Thriller", kws: ["thriller", "suspense", "edge of your seat"] },
    { genre: "War", kws: ["war", "ww2", "world war", "battlefield", "military"] },
    { genre: "Western", kws: ["western", "cowboy", "outlaw", "frontier"] },
  ];

  const hits = [];
  for (const r of rules) {
    if (r.kws.some((k) => p.includes(k))) hits.push(r.genre);
  }
  return uniqStrings(hits);
}


async function callAnthropicJson({ apiKey, model, schemaName, schema, system, user, maxTokens }) {
  if (!apiKey) throw new Error("Missing ANTHROPIC_API_KEY");
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "x-api-key": apiKey,
      "anthropic-version": "2023-06-01",
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      model,
      max_tokens: maxTokens || 4096,
      system,
      messages: [{ role: "user", content: user }],
      tools: [{
        name: schemaName,
        description: "Return the result as structured JSON matching the schema.",
        input_schema: schema,
      }],
      tool_choice: { type: "tool", name: schemaName },
    }),
  });

  const json = await res.json().catch(() => null);
  if (!res.ok) {
    const msg = json?.error?.message || `Anthropic HTTP ${res.status}`;
    throw new Error(msg);
  }

  const content = Array.isArray(json?.content) ? json.content : [];
  for (const block of content) {
    if (block?.type === "tool_use" && block?.input) {
      return block.input;
    }
  }
  throw new Error("Anthropic returned no tool_use block.");
}

async function callAnthropicJsonWithSearch({ apiKey, model, schemaName, schema, system, user }) {
  if (!apiKey) throw new Error("Missing ANTHROPIC_API_KEY");
  const messages = [{ role: "user", content: user }];
  const tools = [
    { type: "web_search_20250305", name: "web_search" },
    {
      name: schemaName,
      description: "Return the result as structured JSON matching the schema.",
      input_schema: schema,
    },
  ];
  for (let i = 0; i < 6; i++) {
    const res = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: {
        "x-api-key": apiKey,
        "anthropic-version": "2023-06-01",
        "anthropic-beta": "web-search-2025-03-05",
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        model,
        max_tokens: 8192,
        system,
        messages,
        tools,
        tool_choice: { type: "any" },
      }),
    });
    const json = await res.json().catch(() => null);
    if (!res.ok) {
      const msg = json?.error?.message || `Anthropic HTTP ${res.status}`;
      throw new Error(msg);
    }
    const content = Array.isArray(json?.content) ? json.content : [];
    const outputBlock = content.find(
      (b) => b?.type === "tool_use" && b?.name === schemaName
    );
    if (outputBlock?.input) return outputBlock.input;
    if (json?.stop_reason === "end_turn") break;
    messages.push({ role: "assistant", content });
  }
  throw new Error("Anthropic did not return structured output after web search.");
}

// ─── Iconify icon library (achievement badge art) ───
// We don't have the LLM draw SVGs (it produces crude geometry). Instead the LLM
// proposes concrete object keywords, and we pull real, professional SVG icons
// from Iconify — preferring game-icons.net (a large, badge-style set). Returned
// icons are monochrome, recolored light so they read inside the tinted medallion
// frame (the tier color comes from the frame, not the icon).
// Preferred icon sets (game-icons rarely shows in search, but keep it first in
// case it does; the rest are clean, well-stocked sets that DO appear in search).
const ICONIFY_BADGE_PREFIXES = [
  "game-icons", "ph", "material-symbols", "mdi", "solar",
  "tabler", "fluent", "mingcute", "lucide", "ri", "fa6-solid",
];
const ICONIFY_ICON_COLOR = "#f4f4f6";

// Solid/filled icons read better as badge emblems than thin outlines.
function iconifyScore(id) {
  const s = String(id || "");
  const prefix = s.split(":")[0];
  let score = ICONIFY_BADGE_PREFIXES.indexOf(prefix);
  score = score === -1 ? 50 : score;
  if (/fill|filled|bold|solid|duotone/i.test(s)) score -= 3; // prefer filled
  if (/outline|thin|light|line|two-tone/i.test(s)) score += 3; // de-prefer outline
  return score;
}

// Iconify search is LITERAL (no fuzzy): "lightsaber" -> 0, but "light-saber",
// "light saber" and the head noun "saber" all match. So expand every keyword
// into spelling/format variants before searching, broadest matches included.
// strict=true (admin typed the term): only format variants of the EXACT phrase
// (space/hyphen/concat + plural). strict=false (auto AI keywords): also broaden
// to the bare head noun ("light saber" -> "saber") to cast a wider net.
function expandKeywordVariants(kw, strict) {
  const base = String(kw || "").trim().toLowerCase().replace(/[^a-z0-9\s-]/g, " ").replace(/\s+/g, " ").trim();
  if (!base) return [];
  const tokens = base.split(/[\s-]+/).filter(Boolean);
  const out = [];
  const add = (s) => {
    const v = String(s || "").trim();
    if (v && v.length >= 2 && !out.includes(v)) out.push(v);
  };
  if (tokens.length > 1) {
    add(tokens.join(" "));   // "light saber"
    add(tokens.join("-"));   // "light-saber"
    add(tokens.join(""));    // "lightsaber"
    if (!strict) add(tokens[tokens.length - 1]); // head noun: "saber" (broad only)
  } else {
    add(base);
  }
  // singular/plural toggle on each form (catches "saber" vs "sabers").
  out.slice().forEach((f) => {
    if (/s$/.test(f)) add(f.replace(/s$/, ""));
    else add(f + "s");
  });
  return out;
}

async function iconifySearchRaw(query, limit) {
  const q = String(query || "").trim();
  if (!q) return [];
  try {
    const url = new URL("https://api.iconify.design/search");
    url.searchParams.set("query", q);
    url.searchParams.set("limit", String(limit || 32));
    const res = await fetch(url.toString());
    if (!res.ok) return [];
    const json = await res.json().catch(() => null);
    return Array.isArray(json?.icons) ? json.icons : [];
  } catch (_) {
    return [];
  }
}

// Search ONE keyword across its spelling variants until it yields icons.
async function iconifySearch(query, limit, strict) {
  const variants = expandKeywordVariants(query, strict);
  const found = [];
  let searches = 0;
  for (const v of variants) {
    if (searches >= 4) break; // cap per-keyword fan-out
    searches += 1;
    const ids = await iconifySearchRaw(v, limit);
    for (const id of ids) if (!found.includes(id)) found.push(id);
    if (found.length >= 12) break; // enough from this keyword
  }
  // Fallback for a GLUED compound the LLM didn't separate ("lightsaber"): the
  // expander can't know where to split, so probe hyphen positions until one hits
  // ("light-saber" -> game-icons:light-sabers). Broad mode only — in strict mode
  // we respect exactly what the admin typed.
  if (!found.length && !strict) {
    const tok = String(query || "").trim().toLowerCase().replace(/[^a-z0-9]/g, "");
    const hadSeparator = /[\s-]/.test(String(query || ""));
    if (!hadSeparator && tok.length >= 7) {
      for (let i = 3; i <= tok.length - 3 && searches < 10; i++) {
        searches += 1;
        const ids = await iconifySearchRaw(tok.slice(0, i) + "-" + tok.slice(i), limit);
        if (ids.length) {
          for (const id of ids) if (!found.includes(id)) found.push(id);
          break;
        }
      }
    }
  }
  return found.slice().sort((a, b) => iconifyScore(a) - iconifyScore(b));
}

async function iconifyFetchSvg(iconId, color) {
  const [prefix, name] = String(iconId || "").split(":");
  if (!prefix || !name) return null;
  try {
    const url = new URL(`https://api.iconify.design/${prefix}/${name}.svg`);
    url.searchParams.set("color", color || ICONIFY_ICON_COLOR);
    url.searchParams.set("width", "64");
    url.searchParams.set("height", "64");
    const res = await fetch(url.toString());
    if (!res.ok) return null;
    const svg = await res.text();
    return /^<svg[\s>]/i.test(svg) && /<\/svg>\s*$/i.test(svg) ? svg : null;
  } catch (_) {
    return null;
  }
}

// Turn a list of concept keywords into ~`count` real icon SVG strings.
// strict=true respects exactly what was typed (admin-edited terms); strict=false
// broadens (auto AI keywords).
async function iconsFromKeywords(keywords, count, shuffle, strict) {
  const kws = (Array.isArray(keywords) ? keywords : [])
    .map((k) => String(k || "").trim())
    .filter(Boolean)
    .slice(0, 8);
  if (!kws.length) return [];

  // Gather candidate icon ids, preserving keyword priority + game-icons bias.
  const seen = new Set();
  const candidates = [];
  for (const kw of kws) {
    const ids = await iconifySearch(kw, 12, strict);
    for (const id of ids) {
      if (!seen.has(id)) { seen.add(id); candidates.push(id); }
    }
    if (candidates.length >= 40) break;
  }
  if (!candidates.length) return [];

  let pool = candidates;
  if (shuffle) {
    pool = candidates.slice();
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
  }

  const pick = pool.slice(0, Math.max(count || 4, 1) + 4); // over-fetch; some may 404
  const svgs = (await Promise.all(pick.map((id) => iconifyFetchSvg(id, ICONIFY_ICON_COLOR))))
    .filter(Boolean)
    .slice(0, count || 4);
  return svgs;
}

// ─── TMDB resolvers for source-aware movie_set achievements ───
// A movie_set can be backed by a TMDB person (director/actor filmography) or a
// TMDB collection (franchise). We store that person/collection id on the rule so
// the set can be REFRESHED later when new films release. resolveMovieSet returns
// the canonical source + its current film list, so the admin can CONFIRM TMDB has
// the right thing before saving.
async function tmdbGetJson(path, params, token) {
  try {
    const url = new URL(`https://api.themoviedb.org/3/${path}`);
    for (const [k, v] of Object.entries(params || {})) {
      if (v !== null && v !== undefined && v !== "") url.searchParams.set(k, String(v));
    }
    const res = await fetch(url.toString(), { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) return null;
    return await res.json().catch(() => null);
  } catch (_) {
    return null;
  }
}

function normalizeTmdbFilms(list) {
  const out = [];
  const seen = new Set();
  for (const f of Array.isArray(list) ? list : []) {
    const id = Number(f?.id);
    const title = String(f?.title || f?.name || "").trim();
    const rd = String(f?.release_date || "").trim();
    if (!id || !title || seen.has(id)) continue;
    if (!rd) continue; // skip undated/announced entries — they can't be "watched"
    seen.add(id);
    out.push({ tmdb_id: id, title, year: rd.slice(0, 4), release_date: rd, poster_path: f?.poster_path || null });
  }
  out.sort((a, b) => String(a.release_date).localeCompare(String(b.release_date)));
  return out;
}

async function resolveMovieSet(setSource, token) {
  const kind = String(setSource?.kind || "").trim().toLowerCase();
  const query = String(setSource?.query || "").trim();
  const role = String(setSource?.role || "Director").trim();
  const source = { kind: kind || "manual" };
  let films = [];

  if (kind === "person" && query) {
    const sj = await tmdbGetJson("search/person", { query }, token);
    const hit = Array.isArray(sj?.results) ? sj.results[0] : null;
    if (hit?.id) {
      source.person_tmdb_id = Number(hit.id);
      source.name = hit.name || query;
      source.role = role === "Actor" ? "Actor" : "Director";
      const cj = await tmdbGetJson(`person/${hit.id}/movie_credits`, {}, token);
      const raw = source.role === "Actor"
        ? (Array.isArray(cj?.cast) ? cj.cast : [])
        : (Array.isArray(cj?.crew) ? cj.crew : []).filter((c) => String(c?.job || "") === "Director");
      films = normalizeTmdbFilms(raw);
    }
  } else if (kind === "collection" && query) {
    const sj = await tmdbGetJson("search/collection", { query }, token);
    const hit = Array.isArray(sj?.results) ? sj.results[0] : null;
    if (hit?.id) {
      source.collection_tmdb_id = Number(hit.id);
      const cj = await tmdbGetJson(`collection/${hit.id}`, {}, token);
      source.name = cj?.name || hit.name || query;
      films = normalizeTmdbFilms(cj?.parts);
    }
  }
  return { source, films };
}

// Fold a resolved source + film list into the rule JSON we persist.
function applyMovieSetSourceToRule(rule, source, films) {
  rule.type = "movie_set";
  rule.source_kind = source?.kind || "manual";
  if (source?.person_tmdb_id) rule.person_tmdb_id = source.person_tmdb_id;
  if (source?.collection_tmdb_id) rule.collection_tmdb_id = source.collection_tmdb_id;
  if (source?.role) rule.person_role = source.role;
  if (source?.name) rule.source_name = source.name;
  rule.tmdb_ids = (Array.isArray(films) ? films : []).map((f) => f.tmdb_id).filter(Boolean);
  rule.require_count = rule.tmdb_ids.length;
  delete rule.movies;
  return rule;
}

// ---- Games: daily movie games (Games page, assets/js/25-games.js) ------------
// Three daily games seeded server-side from the cached "Game Pool": spottle
// (guess-the-movie via attribute feedback), rank (sort 4 by IMDb), poster
// (un-blur). The puzzle "day" boundary is FIXED to America/Los_Angeles (Pacific)
// so every user worldwide gets the same daily puzzle regardless of local timezone /
// the UTC cron that seeds it — the day rolls over at 12:00 AM Pacific.
const GAME_LIST = ["spottle", "rank", "poster", "cast"];
const GAME_MAX_GUESSES = { spottle: 10, poster: 6, cast: 6 };
// Cast ("Starring"): the daily film needs at least this many top-billed cast
// members for a fair progressive reveal (one new face per wrong guess).
const GAME_CAST_MIN = 4;
const GAME_POSTER_MAX_BLUR = 36; // px at zero guesses; steps to 0 exactly on the 6th guess
const GAME_RANK_COUNT = 6;
// RANK uses this FIXED set of 6 well-known films EVERY day (never rotates) so the
// game doesn't burn through the pool. Curated for distinct IMDb ratings; must exist
// in "Game Pool" (built by build_game_pool). Falls back to a deterministic pool
// pick if any aren't present. tmdb: Shawshank / Godfather / Dark Knight / Inception /
// The Matrix / Gladiator.
const RANK_FIXED_TMDB_IDS = [278, 238, 155, 27205, 603, 98];
// Spottle + Poster: the FIRST (vague) hint unlocks after this many guesses. The
// button shows "Hint in N" until then. Later, progressively-more-revealing hint
// tiers unlock at the thresholds in GAME_HINT_THRESHOLDS below.
const GAME_SPOTTLE_HINT_AFTER = 3;
const GAME_POSTER_HINT_AFTER = 3;
const GAME_CAST_HINT_AFTER = 3;
// The guesses-after threshold for the FIRST hint of each guess-based game.
const GAME_HINT_AFTER = { spottle: GAME_SPOTTLE_HINT_AFTER, poster: GAME_POSTER_HINT_AFTER, cast: GAME_CAST_HINT_AFTER };
// Per-game unlock thresholds for the ORDERED, increasingly-revealing hint tiers
// (see spottleHints). Tier i unlocks after GAME_HINT_THRESHOLDS[game][i] guesses;
// tiers beyond the list unlock one guess later each. spottle (10 guesses): era/genre
// @3, studio/box office @6, lead actor @8, director @9. poster (6 guesses) surfaces
// the first three.
const GAME_HINT_THRESHOLDS = { spottle: [3, 6, 8, 9], poster: [3, 4, 5], cast: [3, 5] };
// Rank: the hint reveals the single highest-rated film (locks its #1 slot). Using
// it costs this many points on submit (offsets the free correct placement).
const GAME_RANK_HINT_PENALTY = 2;

function gamePuzzleDatePT(d = new Date()) {
  try {
    // en-CA formats as YYYY-MM-DD; timeZone shifts wall-clock to Pacific so the
    // puzzle "day" rolls over at 12:00 AM America/Los_Angeles.
    return new Intl.DateTimeFormat("en-CA", {
      timeZone: "America/Los_Angeles",
      year: "numeric", month: "2-digit", day: "2-digit",
    }).format(d);
  } catch (_) {
    return d.toISOString().slice(0, 10);
  }
}

// Turn a TMDB movie details response (fetched with
// append_to_response=credits,release_dates) into a "Game Pool" row.
function tmdbToPoolRow(det, bucket) {
  if (!det || !det.id) return null;
  const genres = Array.isArray(det.genres)
    ? det.genres.map((g) => String(g?.name || "").trim()).filter(Boolean) : [];
  const crew = Array.isArray(det?.credits?.crew) ? det.credits.crew : [];
  const dirObj = crew.find((c) => String(c?.job || "") === "Director") || null;
  const director = (dirObj?.name || "").trim() || null;
  const directorProfile = dirObj?.profile_path || null;
  const cast = Array.isArray(det?.credits?.cast) ? det.credits.cast : [];
  const topCast = cast.slice(0, 8)
    .map((c) => ({ id: Number(c?.id) || null, name: String(c?.name || "").trim(), profile_path: c?.profile_path || null }))
    .filter((c) => c.name);
  let mpa = null;
  const rd = Array.isArray(det?.release_dates?.results) ? det.release_dates.results : [];
  const us = rd.find((r) => String(r?.iso_3166_1 || "") === "US");
  if (us && Array.isArray(us.release_dates)) {
    const cert = us.release_dates.map((x) => String(x?.certification || "").trim()).find((c) => c);
    if (cert) mpa = cert;
  }
  const companies = Array.isArray(det?.production_companies) ? det.production_companies : [];
  const primaryCo = companies.find((c) => String(c?.name || "").trim()) || null;
  const studio = (primaryCo?.name || "").trim() || null;
  const studioLogo = primaryCo?.logo_path || null;
  const boxOffice = Number(det?.revenue) > 0 ? Math.round(Number(det.revenue)) : null;
  const yr = String(det?.release_date || "").slice(0, 4);
  return {
    tmdb_id: Number(det.id),
    imdb_id: det?.imdb_id || null,
    title: String(det?.title || det?.name || "").trim() || null,
    release_year: yr ? Number(yr) : null,
    runtime_minutes: Number(det?.runtime) > 0 ? Math.round(Number(det.runtime)) : null,
    mpa_rating: mpa,
    poster_path: det?.poster_path || null,
    genres,
    director,
    director_profile_path: directorProfile,
    studio,
    studio_logo_path: studioLogo,
    box_office: boxOffice,
    top_cast: topCast,
    popularity: Number(det?.popularity) || null,
    bucket,
  };
}

// Resolve a spottle/poster GUESS movie to a pool-row-shaped object, allowing the
// user to guess ANY movie on TMDB (not just the cached "Game Pool"). Order:
//   1) the Game Pool row (fast, fully enriched) if we have it;
//   2) else build one live from TMDB details via tmdbToPoolRow, filling the IMDb
//      rating (for the SCORE tile) from the shared catalog ("Movie External
//      Ratings") first and only falling back to OMDb — so common guesses don't
//      each burn an OMDb call.
// Returns null only when TMDB has no such movie.
async function resolveGuessMovie(admin, tmdbId, tmdbToken, omdbKey) {
  const id = Number(tmdbId);
  if (!id) return null;
  const { data: pooled } = await admin
    .from("Game Pool").select("*").eq("tmdb_id", id).maybeSingle();
  if (pooled) return pooled;

  if (!tmdbToken) return null;
  const det = await tmdbGetJson(
    `movie/${id}`, { append_to_response: "credits,release_dates" }, tmdbToken);
  const gm = tmdbToPoolRow(det, "guess");
  if (!gm) return null;

  // IMDb rating (0-100) for the SCORE tile: catalog first, then OMDb.
  let imdb = null;
  try {
    const { data: mv } = await admin
      .from("Movies").select("id").eq("tmdb_id", id).maybeSingle();
    if (mv?.id) {
      const { data: ext } = await admin
        .from("Movie External Ratings").select("rating")
        .eq("movie_id", mv.id).eq("source", "imdb").maybeSingle();
      if (ext && ext.rating != null) imdb = Number(ext.rating);
    }
  } catch (_) { /* non-fatal — score tile just stays gray */ }
  if (imdb == null && omdbKey) {
    try {
      const r = await fetchOmdbImdbRatingPercent({
        imdb_id: gm.imdb_id, title: gm.title, year: gm.release_year, omdbApiKey: omdbKey,
      });
      if (r?.pct != null) imdb = Number(r.pct);
    } catch (_) { /* non-fatal */ }
  }
  gm.imdb_rating = imdb;
  return gm;
}

// Compact US$ box-office string, e.g. 710_000_000 → "$710M".
function formatBoxOffice(n) {
  const v = Number(n);
  if (!Number.isFinite(v) || v <= 0) return "—";
  if (v >= 1e9) return `$${(v / 1e9).toFixed(1)}B`;
  if (v >= 1e6) return `$${Math.round(v / 1e6)}M`;
  if (v >= 1e3) return `$${Math.round(v / 1e3)}K`;
  return `$${Math.round(v)}`;
}

// Progressive, increasingly-revealing movie hints (used by BOTH spottle + poster).
// Returns an ORDERED list of hint tiers, each with the guess count it unlocks after
// (`after`). The FIRST tier is intentionally vague (decade + primary genre); later
// tiers reveal more (studio + box office → lead actor → director, the most
// revealing). Only non-empty tiers are included, then given unlock thresholds from
// GAME_HINT_THRESHOLDS. The server sends a tier's `text` only once unlocked (see
// gameHintsForResponse) so content can't be read early.
function spottleHints(a, game) {
  if (!a || typeof a !== "object") return [];
  const yr = Number(a.release_year);
  const decade = Number.isFinite(yr) && yr > 0 ? `${Math.floor(yr / 10) * 10}s` : null;
  const genres = Array.isArray(a.genres) ? a.genres.filter(Boolean).map(String) : [];
  const studio = a.studio ? String(a.studio) : null;
  const box = Number(a.box_office) > 0 ? formatBoxOffice(a.box_office) : null;
  const director = a.director ? String(a.director) : null;
  const lead = Array.isArray(a.top_cast) && a.top_cast.length
    ? String(a.top_cast[0]?.name || "").trim() : null;

  const raw = [];
  const t1 = [decade && `Released in the ${decade}`, genres[0]].filter(Boolean).join(" · ");
  if (t1) raw.push({ label: "Era & genre", text: t1 });
  const t2 = [studio && `Studio: ${studio}`, box && `Box office ${box}`].filter(Boolean).join(" · ");
  if (t2) raw.push({ label: "Studio & box office", text: t2 });
  if (lead) raw.push({ label: "Lead actor", text: `Stars ${lead}` });
  if (director) raw.push({ label: "Director", text: `Directed by ${director}` });

  const thr = GAME_HINT_THRESHOLDS[game] || GAME_HINT_THRESHOLDS.spottle;
  const last = thr.length - 1;
  return raw.map((h, i) => ({
    ...h,
    after: (i <= last) ? thr[i] : thr[last] + (i - last),
  }));
}

// Shape the hint tiers for a client response: reveal a tier's TEXT only once the
// player has enough guesses (attempts >= after); locked tiers carry no text so the
// content can't be read early, only the countdown ("Hint in N").
function gameHintsForResponse(a, game, attempts) {
  return spottleHints(a, game).map((t) => ({
    after: t.after,
    label: t.label,
    locked: attempts < t.after,
    text: attempts >= t.after ? t.text : null,
  }));
}

// Spottle attribute-closeness feedback comparing a GUESS pool row to the ANSWER.
// Numeric fields → { value, status: green|yellow|gray, dir?: up|down } where dir
// points from the guess toward the answer (higher/lower). The card shows the
// GUESS's own attributes tinted by closeness: year / box office / rated (MPA) /
// score (IMDb) / studio (with logo), genre pills, plus director + lead actor +
// supporting cast (each green when that person is also in the answer's cast).
function spottleGuessFeedback(g, a) {
  const fb = {};
  const cmpNum = (gv, av, near) => {
    const x = Number(gv), y = Number(av);
    if (!Number.isFinite(x) || !Number.isFinite(y)) return { status: "gray", dir: null };
    if (x === y) return { status: "green", dir: null };
    return { status: Math.abs(x - y) <= near ? "yellow" : "gray", dir: y > x ? "up" : "down" };
  };
  // Year (🟨 within 5 yr)
  const yc = cmpNum(g.release_year, a.release_year, 5);
  fb.year = { value: g.release_year ?? "—", status: yc.status, dir: yc.dir };
  // Box office (🟨 within $50M)
  const bc = cmpNum(g.box_office, a.box_office, 50e6);
  fb.box_office = { value: formatBoxOffice(g.box_office), status: bc.status, dir: bc.dir };
  // Score = IMDb rating (stored 0-100; shown as NN/100; 🟨 within 10 pts)
  const ic = cmpNum(g.imdb_rating, a.imdb_rating, 10);
  fb.score = {
    value: Number(g.imdb_rating) > 0 ? `${Math.round(Number(g.imdb_rating))}/100` : "—",
    status: ic.status, dir: ic.dir,
  };
  // MPA / Rated (exact)
  const mpaMatch = g.mpa_rating && a.mpa_rating && String(g.mpa_rating) === String(a.mpa_rating);
  fb.mpa = { value: g.mpa_rating || "—", status: mpaMatch ? "green" : "gray", dir: null };
  // Studio (exact by name; carries the guess's studio LOGO for the tile image)
  const studioMatch = g.studio && a.studio && String(g.studio).toLowerCase() === String(a.studio).toLowerCase();
  fb.studio = {
    value: g.studio || "—", status: studioMatch ? "green" : "gray", dir: null,
    logo_path: g.studio_logo_path || null,
  };
  // Genre pills — each guess genre tinted green when it's also in the answer.
  const aset = new Set((a.genres || []).map((x) => String(x).toLowerCase()));
  fb.genres = (g.genres || []).map((name) => ({
    name: String(name), match: aset.has(String(name).toLowerCase()),
  }));
  // People — director + lead actor + supporting cast, each green when that TMDB
  // person also appears in the answer (director by name, cast by person id).
  const aCast = Array.isArray(a.top_cast) ? a.top_cast : [];
  const gCast = Array.isArray(g.top_cast) ? g.top_cast : [];
  const aCastIds = new Set(aCast.map((c) => Number(c?.id)).filter(Boolean));
  const dirMatch = g.director && a.director && String(g.director).toLowerCase() === String(a.director).toLowerCase();
  fb.director = {
    name: g.director || "—", status: dirMatch ? "green" : "gray",
    profile_path: g.director_profile_path || null,
  };
  const castPerson = (c) => ({
    name: c?.name || "—", profile_path: c?.profile_path || null,
    status: Number(c?.id) && aCastIds.has(Number(c.id)) ? "green" : "gray",
  });
  fb.lead = gCast.length ? castPerson(gCast[0]) : null;
  fb.supporting = gCast.slice(1, 5).map(castPerson);
  return fb;
}

// Points earned for a SOLVED spottle/poster game (0 if unsolved / gave up).
//   spottle: 25 max, −2 per extra guess beyond the first, −1 if the hint was used.
//   poster : 12 max, −2 per extra guess beyond the first, −1 if the hint was used.
// (rank is scored separately in game_submit: 2 pts per movie in its correct slot.)
function gameGuessScore(game, solved, attempts, usedHint) {
  if (!solved) return 0;
  const a = Math.max(1, Number(attempts) || 1);
  if (game === "spottle") return Math.max(1, 25 - 2 * (a - 1) - (usedHint ? 1 : 0));
  if (game === "poster") return Math.max(1, 12 - 2 * (a - 1) - (usedHint ? 1 : 0));
  if (game === "cast") return Math.max(1, 14 - 2 * (a - 1) - (usedHint ? 1 : 0));
  return 0;
}

// Best-effort cumulative game-points total on the user row (tracked over time).
// Read-modify-write is fine here: a user only completes their own daily games.
async function addUserGamePoints(admin, userId, delta) {
  const d = Number(delta) || 0;
  if (!d || !userId) return;
  try {
    const { data } = await admin.from("Users").select("game_points").eq("id", userId).maybeSingle();
    const cur = Number(data?.game_points) || 0;
    await admin.from("Users").update({ game_points: cur + d }).eq("id", userId);
  } catch (_) { /* non-fatal — the per-result score is still stored in Game Results */ }
}

// Poster blur in px for the current attempt count (clears once the game is done).
function gamePosterBlur(attempts, max, done) {
  if (done) return 0;
  const frac = Math.max(0, (max - attempts) / max);
  return Math.round(GAME_POSTER_MAX_BLUR * frac);
}

// Cast ("Starring") progressive reveal: the cast headshots visible for the current
// attempt count. Reveals the LEAST-prominent billed actor first and adds one more
// (working UP the billing order toward the lead) per wrong guess, so the marquee
// name is the last clue. Server-controlled so the full cast can't be read early —
// only the currently-revealed slice is returned (all of it once the game is done).
// Each face carries only name + headshot path (no character — too revealing).
function gameCastReveal(answer, attempts, done) {
  const cast = Array.isArray(answer?.top_cast) ? answer.top_cast : [];
  if (!cast.length) return [];
  const lite = (c) => ({ name: String(c?.name || "").trim(), profile_path: c?.profile_path || null });
  if (done) return cast.map(lite);
  // 1 face before the first guess, +1 per attempt, revealing bottom-of-billing first.
  const count = Math.min(cast.length, (Number(attempts) || 0) + 1);
  return cast.slice(cast.length - count).map(lite);
}

// A trimmed answer object safe to reveal to the client once a game is OVER.
function gameAnswerLite(a) {
  if (!a || typeof a !== "object") return null;
  return {
    tmdb_id: a.tmdb_id ?? null,
    title: a.title ?? null,
    release_year: a.release_year ?? null,
    poster_path: a.poster_path ?? null,
    director: a.director ?? null,
    genres: Array.isArray(a.genres) ? a.genres : [],
    imdb_rating: a.imdb_rating ?? null,
  };
}

function extractDirectorNameFromCredits(creditsJson) {
  const crew = Array.isArray(creditsJson?.crew) ? creditsJson.crew : [];
  const directors = crew
    .filter((c) => String(c?.job ?? "").trim().toLowerCase() === "director")
    .map((c) => String(c?.name ?? "").trim())
    .filter(Boolean);
  const unique = uniqStrings(directors);
  return unique.length ? unique.join(", ") : null;
}

// Headshot of the first-credited director (for the Movie Spotlight Details tab).
function extractDirectorProfilePath(creditsJson) {
  const crew = Array.isArray(creditsJson?.crew) ? creditsJson.crew : [];
  const dir = crew.find((c) => String(c?.job ?? "").trim().toLowerCase() === "director" && c?.profile_path);
  return dir?.profile_path ? String(dir.profile_path) : null;
}

function extractUsCertification(releaseDatesJson) {
  const results = Array.isArray(releaseDatesJson?.results) ? releaseDatesJson.results : [];
  const us = results.find((r) => String(r?.iso_3166_1 ?? "").toUpperCase() === "US") || null;
  const entries = Array.isArray(us?.release_dates) ? us.release_dates : [];

  for (const e of entries) {
    const cert = String(e?.certification ?? "").trim();
    if (cert) return cert;
  }
  return "";
}

function pickBestSearchResult(
  results,
  releaseYear,
) {
  if (!Array.isArray(results) || results.length === 0) return null;

  if (releaseYear) {
    const exact = results.find((r) => {
      const y = r?.release_date ? Number(String(r.release_date).slice(0, 4)) : null;
      return y === releaseYear;
    });
    if (exact) return exact;
  }

  // TMDb already sorts by relevance
  return results[0];
}

function normalizeTitleForMatch(s) {
  return String(s ?? "")
    .toLowerCase()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "")
    .trim();
}

function titleMatchScore({ query, title }) {
  const nq = normalizeTitleForMatch(query);
  const nt = normalizeTitleForMatch(title);
  if (!nq || !nt) return 0;
  if (nt === nq) return 100;
  if (nt.startsWith(nq)) return 70;
  if (nt.includes(nq)) return 40;
  return 0;
}

async function mapWithConcurrency(items, concurrency, fn) {
  const list = Array.isArray(items) ? items : [];
  const limit = Math.max(1, Number(concurrency) || 1);
  const out = new Array(list.length);
  let idx = 0;

  const workers = Array.from({ length: Math.min(limit, list.length) }, async () => {
    while (idx < list.length) {
      const i = idx++;
      out[i] = await fn(list[i], i);
    }
  });

  await Promise.all(workers);
  return out;
}

function normalizePosterPath(raw) {
  const s = String(raw ?? "").trim();
  if (!s) return null;
  return s.startsWith("/") ? s : `/${s}`;
}

function normalizePlatformName(raw) {
  const s = String(raw ?? "").trim();
  if (!s) return "";
  return s.replace(/\s+/g, " ").trim();
}

function extractProviderNamesFromWatchProvidersJson(json, region = "US") {
  const results = json?.results && typeof json.results === "object" ? json.results : {};
  const regionKey = String(region || "US").trim().toUpperCase() || "US";
  const bucket = results?.[regionKey] && typeof results[regionKey] === "object" ? results[regionKey] : null;
  if (!bucket) return [];

  const collect = (arr) => {
    const list = Array.isArray(arr) ? arr : [];
    return list
      .map((p) => normalizePlatformName(p?.provider_name))
      .filter(Boolean);
  };

  const names = uniqStrings([
    ...collect(bucket?.flatrate),
    ...collect(bucket?.free),
    ...collect(bucket?.ads),
    ...collect(bucket?.rent),
    ...collect(bucket?.buy),
  ]);

  return names;
}

async function syncMovieWatchPlatforms({
  supabaseAdmin,
  movie_id,
  tmdb_id,
  tmdbReadAccessToken,
  region = "US",
  timeoutMs = 1400,
}) {
  const out = {
    region: String(region || "US").trim().toUpperCase() || "US",
    requested: 0,
    created_platforms: 0,
    linked: 0,
    error: null,
  };

  const movieId = String(movie_id || "").trim();
  const tid = Number(tmdb_id);
  if (!movieId) {
    out.error = "Missing movie_id.";
    return out;
  }
  if (!Number.isFinite(tid) || tid <= 0) {
    out.error = "Missing/invalid tmdb_id.";
    return out;
  }
  if (!tmdbReadAccessToken) {
    out.error = "Missing TMDB token.";
    return out;
  }

  try {
    const url = new URL(`https://api.themoviedb.org/3/movie/${tid}/watch/providers`);
    const r = await fetchJsonWithTimeout(
      url.toString(),
      { headers: { Authorization: `Bearer ${tmdbReadAccessToken}` } },
      timeoutMs,
    );

    if (!r.ok) {
      out.error = `TMDb watch/providers failed: HTTP ${r.status || 0}`;
      return out;
    }

    const providerNames = extractProviderNamesFromWatchProvidersJson(r.json, out.region);
    out.requested = providerNames.length;

    // Stamp the staleness marker now that the TMDb check succeeded (covers the
    // zero-providers case too — the movie WAS checked). Best-effort; never fail the
    // sync over it. Read by the refresh_list_watch_platforms cron to rotate stalest-first.
    try {
      await supabaseAdmin
        .from("Movies")
        .update({ platforms_synced_at: new Date().toISOString() })
        .eq("id", movieId);
    } catch (_) { /* ignore — marker is best-effort */ }

    // Always refresh join rows for this movie (idempotent).
    const { error: delErr } = await supabaseAdmin
      .from("Movie Platforms")
      .delete()
      .eq("movie_id", movieId);

    if (delErr) {
      out.error = `Failed to clear Movie Platforms: ${delErr.message}`;
      return out;
    }

    if (providerNames.length === 0) {
      // No providers for region; leave joins cleared.
      return out;
    }

    const { data: existingPlatforms, error: platErr } = await supabaseAdmin
      .from("Platforms")
      .select("id, name");
    if (platErr) {
      out.error = `Failed to load Platforms: ${platErr.message}`;
      return out;
    }

    const byLowerName = new Map();
    for (const p of Array.isArray(existingPlatforms) ? existingPlatforms : []) {
      const name = normalizePlatformName(p?.name);
      const id = p?.id;
      if (!name || id === null || id === undefined) continue;
      byLowerName.set(name.toLowerCase(), id);
    }

    const missing = [];
    for (const name of providerNames) {
      const key = name.toLowerCase();
      if (!byLowerName.has(key)) missing.push({ name });
    }

    if (missing.length > 0) {
      // Insert missing Platforms. Recommend a UNIQUE constraint on Platforms.name.
      const { data: inserted, error: insErr } = await supabaseAdmin
        .from("Platforms")
        .insert(missing)
        .select("id, name");

      if (insErr) {
        // If this is a uniqueness race, we can still proceed by reloading.
        const msg = String(insErr?.message || insErr);
        if (!/duplicate|unique/i.test(msg)) {
          out.error = `Failed to insert Platforms: ${msg}`;
          return out;
        }
      } else {
        out.created_platforms = Array.isArray(inserted) ? inserted.length : 0;
        for (const p of Array.isArray(inserted) ? inserted : []) {
          const name = normalizePlatformName(p?.name);
          const id = p?.id;
          if (!name || id === null || id === undefined) continue;
          byLowerName.set(name.toLowerCase(), id);
        }
      }

      // Re-fetch to ensure we have IDs for all names (covers uniqueness races).
      const { data: allPlatforms2, error: platErr2 } = await supabaseAdmin
        .from("Platforms")
        .select("id, name");
      if (!platErr2) {
        for (const p of Array.isArray(allPlatforms2) ? allPlatforms2 : []) {
          const name = normalizePlatformName(p?.name);
          const id = p?.id;
          if (!name || id === null || id === undefined) continue;
          byLowerName.set(name.toLowerCase(), id);
        }
      }
    }

    const joinRows = [];
    const seen = new Set();
    for (const name of providerNames) {
      const pid = byLowerName.get(String(name).toLowerCase());
      if (pid === null || pid === undefined) continue;
      const key = `${movieId}|${pid}`;
      if (seen.has(key)) continue;
      seen.add(key);
      joinRows.push({ movie_id: movieId, platform_id: pid });
    }

    if (joinRows.length > 0) {
      const { error: joinErr } = await supabaseAdmin
        .from("Movie Platforms")
        .insert(joinRows);
      if (joinErr) {
        out.error = `Failed to insert Movie Platforms: ${joinErr.message}`;
        return out;
      }
      out.linked = joinRows.length;
    }

    return out;
  } catch (e) {
    out.error = `Platform sync crashed: ${String(e?.message ?? e)}`;
    return out;
  }
}

async function fetchJsonWithTimeout(url, { headers } = {}, timeoutMs = 1200) {
  const ms = Number(timeoutMs);
  const useTimeout = Number.isFinite(ms) && ms > 0 ? ms : 1200;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), useTimeout);
  try {
    const res = await fetch(String(url), {
      headers,
      signal: controller.signal,
    });
    const text = await res.text().catch(() => "");
    const json = text ? (JSON.parse(text)) : null;
    return { ok: res.ok, status: res.status, json };
  } catch (e) {
    return { ok: false, status: 0, json: null, error: String(e?.message ?? e) };
  } finally {
    clearTimeout(timer);
  }
}

async function tryRepairPosterPathByTmdbId({
  supabaseAdmin,
  tmdbId,
  tmdbReadAccessToken,
  timeoutMs = 1200,
}) {
  const id = Number(tmdbId);
  if (!Number.isFinite(id) || id <= 0) return { ok: false, reason: "invalid_tmdb_id" };

  const { data: rows, error: readErr } = await supabaseAdmin
    .from("Movies")
    .select("id, tmdb_id, poster_path")
    .eq("tmdb_id", id)
    .limit(1);

  if (readErr) return { ok: false, reason: `db_read_failed: ${readErr.message}` };
  const row = Array.isArray(rows) && rows.length ? rows[0] : null;
  if (!row?.id) return { ok: false, reason: "movie_not_found" };

  const existing = String(row?.poster_path ?? "").trim();
  if (existing) return { ok: true, updated: false, reason: "already_present" };

  const url = new URL(`https://api.themoviedb.org/3/movie/${id}`);
  url.searchParams.set("language", "en-US");

  const r = await fetchJsonWithTimeout(
    url.toString(),
    { headers: { Authorization: `Bearer ${tmdbReadAccessToken}` } },
    timeoutMs,
  );

  if (!r.ok) {
    return { ok: false, updated: false, reason: `tmdb_details_failed: HTTP ${r.status || 0}` };
  }

  const poster_path = normalizePosterPath(r?.json?.poster_path);
  if (!poster_path) return { ok: true, updated: false, reason: "tmdb_missing_poster" };

  const { error: updErr } = await supabaseAdmin
    .from("Movies")
    .update({ poster_path })
    .eq("id", row.id);

  if (updErr) return { ok: false, updated: false, reason: `db_update_failed: ${updErr.message}` };
  return { ok: true, updated: true };
}

async function tryRepairSomeMissingPosterPaths({
  supabaseAdmin,
  tmdbReadAccessToken,
  limit = 1,
  perFetchTimeoutMs = 1200,
}) {
  const lim = Number.isFinite(Number(limit)) ? Math.max(1, Math.floor(Number(limit))) : 1;

  const { data: rows, error: readErr } = await supabaseAdmin
    .from("Movies")
    .select("id, tmdb_id, poster_path")
    .or("poster_path.is.null,poster_path.eq.")
    .not("tmdb_id", "is", null)
    .limit(lim);

  if (readErr) return { ok: false, attempted: 0, updated: 0, reason: `db_read_failed: ${readErr.message}` };
  const list = Array.isArray(rows) ? rows : [];
  if (!list.length) return { ok: true, attempted: 0, updated: 0 };

  let attempted = 0;
  let updated = 0;
  for (const r of list) {
    const tmdbId = Number(r?.tmdb_id);
    if (!Number.isFinite(tmdbId) || tmdbId <= 0) continue;
    attempted += 1;
    const res = await tryRepairPosterPathByTmdbId({
      supabaseAdmin,
      tmdbId,
      tmdbReadAccessToken,
      timeoutMs: perFetchTimeoutMs,
    });
    if (res?.updated) updated += 1;
  }

  return { ok: true, attempted, updated };
}

async function tryRepairAllMissingPosterPathsUncapped({
  supabaseAdmin,
  tmdbReadAccessToken,
  pageSize = 100,
  perFetchTimeoutMs = 1200,
  concurrency = 6,
}) {
  const size = Number.isFinite(Number(pageSize))
    ? Math.max(1, Math.min(500, Math.floor(Number(pageSize))))
    : 100;
  const conc = Number.isFinite(Number(concurrency))
    ? Math.max(1, Math.min(12, Math.floor(Number(concurrency))))
    : 6;

  const attemptedIds = new Set();
  let attempted = 0;
  let updated = 0;

  while (true) {
    const { data: rows, error: readErr } = await supabaseAdmin
      .from("Movies")
      .select("id, tmdb_id, poster_path")
      .or("poster_path.is.null,poster_path.eq.")
      .not("tmdb_id", "is", null)
      .limit(size);

    if (readErr) {
      return {
        ok: false,
        attempted,
        updated,
        reason: `db_read_failed: ${readErr.message}`,
      };
    }

    const list = (Array.isArray(rows) ? rows : [])
      .filter((r) => r?.id && !attemptedIds.has(String(r.id)));

    if (list.length === 0) break;

    for (const r of list) attemptedIds.add(String(r.id));
    attempted += list.length;

    const results = await mapWithConcurrency(list, conc, async (r) => {
      const tmdbId = Number(r?.tmdb_id);
      if (!Number.isFinite(tmdbId) || tmdbId <= 0) return { updated: false };

      return await tryRepairPosterPathByTmdbId({
        supabaseAdmin,
        tmdbId,
        tmdbReadAccessToken,
        timeoutMs: perFetchTimeoutMs,
      });
    });

    updated += (Array.isArray(results) ? results : []).filter((r) => Boolean(r?.updated)).length;
  }

  return { ok: true, attempted, updated };
}

function uuidLike(s) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
    String(s || "").trim(),
  );
}

Deno.serve(async (req) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });

  try {
    const SUPABASE_URL = Deno.env.get("SUPABASE_URL");
    const SUPABASE_ANON_KEY = Deno.env.get("SUPABASE_ANON_KEY");
    const SUPABASE_SERVICE_ROLE_KEY = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
    const TMDB_READ_ACCESS_TOKEN = Deno.env.get("TMDB_READ_ACCESS_TOKEN");

    // Parse body early (some actions are public and don't require a Supabase session).
    let body = {};
    try {
      body = await req.json();
    } catch (_) {
      body = {};
    }

    const action = String(body?.action ?? "").trim().toLowerCase();

    if (!SUPABASE_URL || !SUPABASE_ANON_KEY || !SUPABASE_SERVICE_ROLE_KEY) {
      return jsonResponse({ code: 500, message: "Missing Supabase env vars." }, 500);
    }
    if (!TMDB_READ_ACCESS_TOKEN) {
      return jsonResponse({ code: 500, message: "Missing TMDB_READ_ACCESS_TOKEN." }, 500);
    }

    // Service role client for server-side repairs and upserts.
    const supabaseAdmin = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY);

    // ---- Scheduled IMDb-rating refresh (cron job, no user session) ------------
    // Re-pulls OMDb IMDb ratings for the movies whose stored rating is the STALEST
    // (oldest `Movie External Ratings.fetched_at`) and overwrites them in place, so a
    // film's rating drifts as more people rate it over time. Refreshed rows get a new
    // fetched_at and move to the back of the queue, so daily runs rotate through the
    // whole catalog. Gated by a shared CRON_SECRET so only the scheduled job can call
    // it. Triggered daily by .github/workflows/refresh-imdb.yml.
    if (action === "refresh_imdb_ratings") {
      const provided = String(req.headers.get("x-cron-secret") ?? "").trim();
      const expected = String(Deno.env.get("CRON_SECRET") ?? "").trim();
      if (!expected || provided !== expected) {
        return jsonResponse({ code: 401, message: "Invalid or missing cron secret." }, 401);
      }

      const OMDB_API_KEY = Deno.env.get("OMDB_API_KEY");
      if (!OMDB_API_KEY) {
        return jsonResponse({ ok: false, message: "Missing OMDB_API_KEY." }, 200);
      }

      // Per-run cap — stay well under OMDb's ~1000/day free-tier limit.
      const limit = Math.max(1, Math.min(900, Number(body?.limit) || 300));

      // Oldest-fetched IMDb ratings first.
      const { data: stale, error: staleErr } = await supabaseAdmin
        .from("Movie External Ratings")
        .select("movie_id, fetched_at")
        .eq("source", "imdb")
        .order("fetched_at", { ascending: true, nullsFirst: true })
        .limit(limit);
      if (staleErr) {
        return jsonResponse({ ok: false, message: `Select failed: ${staleErr.message}` }, 200);
      }
      const rows = Array.isArray(stale) ? stale : [];
      if (rows.length === 0) {
        return jsonResponse({ ok: true, checked: 0, updated: 0, failed: 0 }, 200);
      }

      // Movie identity (imdb_id / title / year) needed to query OMDb.
      const movieIds = rows.map((r) => r.movie_id).filter(Boolean);
      const { data: movies } = await supabaseAdmin
        .from("Movies")
        .select("id, imdb_id, title, release_year")
        .in("id", movieIds);
      const movieById = new Map((Array.isArray(movies) ? movies : []).map((m) => [m.id, m]));

      let checked = 0, updated = 0, failed = 0;
      let idx = 0;
      const CONCURRENCY = 6; // modest parallelism so N fetches don't hit the timeout
      const worker = async () => {
        while (idx < rows.length) {
          const m = movieById.get(rows[idx++]?.movie_id);
          if (!m?.id) continue;
          checked++;
          try {
            const r = await fetchOmdbImdbRatingPercent({
              imdb_id: m.imdb_id,
              title: m.title,
              year: m.release_year,
              omdbApiKey: OMDB_API_KEY,
            });
            // Only overwrite when OMDb returns a REAL, positive rating. If OMDb has
            // nothing (null / 0 / "N/A"), leave the stored row untouched — this is what
            // protects a user's MANUALLY-entered IMDb rating from being reset to 0.
            // (Manual rows are still re-checked every run, so the moment OMDb finally
            // has a real value it replaces the manual one.)
            if (r?.ok && r.pct !== null && Number(r.pct) > 0) {
              // Votes ride along on the SAME OMDb call + row. Only include the key
              // when OMDb returned a real positive count, so we never clobber a
              // stored value with null (ON CONFLICT updates only provided columns).
              const row = { movie_id: m.id, source: "imdb", rating: r.pct, fetched_at: new Date().toISOString() };
              if (Number(r?.votes) > 0) row.votes = Math.round(Number(r.votes));
              const { error: upErr } = await supabaseAdmin
                .from("Movie External Ratings")
                .upsert(row, { onConflict: "movie_id,source" });
              upErr ? failed++ : updated++;
            } else {
              // No real OMDb value — keep whatever is stored (incl. manual values).
              failed++;
            }
          } catch (_) { failed++; }
        }
      };
      await Promise.all(Array.from({ length: Math.min(CONCURRENCY, rows.length) }, worker));

      return jsonResponse({ ok: true, checked, updated, failed }, 200);
    }

    // ---- Games: build the cached movie pool (cron job, no user session) -------
    // Pulls candidates from TMDB /discover (or /trending) for one BUCKET across a
    // page range, enriches each NEW candidate with details+credits + the real IMDb
    // rating/votes via OMDb, and upserts into "Game Pool" (keyed by tmdb_id; movies
    // already present are skipped, so re-runs are cheap). Batched — run repeatedly
    // (build-game-pool.yml) until pool_total reaches ~1000. Gated by CRON_SECRET.
    if (action === "build_game_pool") {
      const provided = String(req.headers.get("x-cron-secret") ?? "").trim();
      const expected = String(Deno.env.get("CRON_SECRET") ?? "").trim();
      if (!expected || provided !== expected) {
        return jsonResponse({ code: 401, message: "Invalid or missing cron secret." }, 401);
      }
      const OMDB_API_KEY = Deno.env.get("OMDB_API_KEY");

      const bucket = ["rating", "most_voted", "trending"].includes(String(body?.bucket || "").trim())
        ? String(body.bucket).trim() : "most_voted";
      const pageStart = Math.max(1, Number(body?.page_start) || 1);
      const pages = Math.max(1, Math.min(10, Number(body?.pages) || 3));
      const limit = Math.max(1, Math.min(500, Number(body?.limit) || 60));
      const voteFloor = Math.max(0, Number(body?.vote_count_gte) || 5000);
      const target = Math.max(1, Number(body?.target) || 1000);

      // 1) Gather candidate tmdb ids from TMDB across the page range.
      const candidateIds = [];
      const seenIds = new Set();
      for (let p = pageStart; p < pageStart + pages; p++) {
        let path, params;
        if (bucket === "trending") {
          path = "trending/movie/week";
          params = { page: p };
        } else if (bucket === "rating") {
          path = "discover/movie";
          params = {
            sort_by: "vote_average.desc", "vote_count.gte": voteFloor,
            include_adult: "false", include_video: "false", page: p,
          };
        } else {
          path = "discover/movie";
          params = { sort_by: "vote_count.desc", include_adult: "false", include_video: "false", page: p };
        }
        const j = await tmdbGetJson(path, params, TMDB_READ_ACCESS_TOKEN);
        const results = Array.isArray(j?.results) ? j.results : [];
        for (const r of results) {
          const id = Number(r?.id);
          if (id && !seenIds.has(id)) { seenIds.add(id); candidateIds.push(id); }
        }
      }

      // 2) Skip candidates already in the pool.
      let alreadyHave = new Set();
      if (candidateIds.length) {
        const { data: existing } = await supabaseAdmin
          .from("Game Pool").select("tmdb_id").in("tmdb_id", candidateIds);
        alreadyHave = new Set((existing || []).map((e) => Number(e.tmdb_id)));
      }
      const todo = candidateIds.filter((id) => !alreadyHave.has(id)).slice(0, limit);

      // 3) Enrich + upsert (bounded concurrency).
      let inserted = 0, failed = 0;
      let idx = 0;
      const CONCURRENCY = 5;
      const worker = async () => {
        while (idx < todo.length) {
          const id = todo[idx++];
          try {
            const det = await tmdbGetJson(`movie/${id}`,
              { append_to_response: "credits,release_dates" }, TMDB_READ_ACCESS_TOKEN);
            const row = tmdbToPoolRow(det, bucket);
            if (!row || !row.title) { failed++; continue; }
            if (OMDB_API_KEY) {
              const om = await fetchOmdbImdbRatingPercent({
                imdb_id: row.imdb_id, title: row.title, year: row.release_year, omdbApiKey: OMDB_API_KEY,
              });
              if (om?.ok && Number(om.pct) > 0) {
                row.imdb_rating = om.pct;
                if (Number(om.votes) > 0) row.imdb_votes = Math.round(Number(om.votes));
              }
            }
            row.updated_at = new Date().toISOString();
            const { error: upErr } = await supabaseAdmin
              .from("Game Pool").upsert(row, { onConflict: "tmdb_id" });
            upErr ? failed++ : inserted++;
          } catch (_) { failed++; }
        }
      };
      await Promise.all(Array.from({ length: Math.min(CONCURRENCY, todo.length) }, worker));

      const { count } = await supabaseAdmin
        .from("Game Pool").select("*", { count: "exact", head: true });
      const poolTotal = Number(count) || 0;
      return jsonResponse({
        ok: true, bucket, considered: candidateIds.length, enriched: todo.length,
        inserted, failed, pool_total: poolTotal,
        remaining: Math.max(0, target - poolTotal), next_page: pageStart + pages,
      }, 200);
    }

    // ---- Games: seed today's puzzles (cron job, no user session) --------------
    // For each game with no row for today's date (America/Los_Angeles), picks movies
    // from "Game Pool" and writes a "Game Daily" row whose payload holds the ANSWER
    // (server-only table). Idempotent. Gated by CRON_SECRET; run daily by
    // seed-daily-games.yml.
    if (action === "seed_daily_games") {
      const provided = String(req.headers.get("x-cron-secret") ?? "").trim();
      const expected = String(Deno.env.get("CRON_SECRET") ?? "").trim();
      if (!expected || provided !== expected) {
        return jsonResponse({ code: 401, message: "Invalid or missing cron secret." }, 401);
      }
      const force = !!body?.force;
      const date = String(body?.date || "").trim() || gamePuzzleDatePT();
      const RECENT_DAYS = 60;
      // Optional: restrict seeding to specific games (e.g. {"games":["cast"]} to add
      // a newly-launched game to a day whose OTHER puzzles were already played — the
      // un-requested games are never touched, even with force). Null = all games.
      const onlyGames = Array.isArray(body?.games) && body.games.length
        ? new Set(body.games.map((g) => String(g).trim().toLowerCase()))
        : null;
      const wantsGame = (g) => !onlyGames || onlyGames.has(g);

      const { data: existingRows } = await supabaseAdmin
        .from("Game Daily").select("game").eq("puzzle_date", date);
      const alreadySeeded = new Set((existingRows || []).map((r) => r.game));

      // Load a working set of recognizable films (has a real IMDb rating + poster).
      const { data: pool } = await supabaseAdmin
        .from("Game Pool")
        .select("tmdb_id,title,release_year,runtime_minutes,mpa_rating,poster_path,genres,director,director_profile_path,studio,studio_logo_path,box_office,top_cast,imdb_rating,imdb_votes,last_used_date")
        .not("imdb_rating", "is", null)
        .not("poster_path", "is", null)
        .order("imdb_votes", { ascending: false, nullsFirst: false })
        .limit(600);
      const all = Array.isArray(pool) ? pool : [];
      const notRecent = (m) => {
        if (!m.last_used_date) return true;
        const used = new Date(m.last_used_date + "T00:00:00Z").getTime();
        return (Date.now() - used) > RECENT_DAYS * 86400000;
      };
      const recognizable = all.filter((m) =>
        notRecent(m) && Array.isArray(m.genres) && m.genres.length > 0 && m.director);
      const shuffle = (arr) => {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      };

      const seeded = {};
      const usedIds = [];
      const mkAnswer = (m) => ({
        tmdb_id: Number(m.tmdb_id), title: m.title, release_year: m.release_year,
        runtime_minutes: m.runtime_minutes, mpa_rating: m.mpa_rating, poster_path: m.poster_path,
        genres: m.genres || [], director: m.director, director_profile_path: m.director_profile_path,
        studio: m.studio, studio_logo_path: m.studio_logo_path, box_office: m.box_office,
        top_cast: Array.isArray(m.top_cast) ? m.top_cast : [], imdb_rating: m.imdb_rating,
      });

      // spottle + poster: one recognizable film each (distinct).
      const pickPool = shuffle(recognizable);
      let pi = 0;
      for (const game of ["spottle", "poster"]) {
        if (!wantsGame(game)) continue;   // not requested — leave its row untouched
        if (alreadySeeded.has(game) && !force) { seeded[game] = "exists"; continue; }
        const m = pickPool[pi++];
        if (!m) { seeded[game] = "no_candidate"; continue; }
        usedIds.push(Number(m.tmdb_id));
        const payload = { answer: mkAnswer(m), max_guesses: GAME_MAX_GUESSES[game] };
        const { error } = await supabaseAdmin.from("Game Daily")
          .upsert({ puzzle_date: date, game, payload }, { onConflict: "puzzle_date,game" });
        seeded[game] = error ? `error: ${error.message}` : "seeded";
      }

      // cast ("Starring"): a DISTINCT film with enough top-billed cast for a fair
      // progressive reveal (one face per wrong guess). Scan the remaining shuffled
      // pool for the first candidate with >= GAME_CAST_MIN named cast members.
      if (!wantsGame("cast")) {
        // not requested — skip
      } else if (alreadySeeded.has("cast") && !force) {
        seeded.cast = "exists";
      } else {
        const m = pickPool.slice(pi).find((x) =>
          !usedIds.includes(Number(x.tmdb_id)) &&
          Array.isArray(x.top_cast) &&
          x.top_cast.filter((c) => c && String(c.name || "").trim()).length >= GAME_CAST_MIN);
        if (!m) {
          seeded.cast = "no_candidate";
        } else {
          usedIds.push(Number(m.tmdb_id));
          const payload = { answer: mkAnswer(m), max_guesses: GAME_MAX_GUESSES.cast };
          const { error } = await supabaseAdmin.from("Game Daily")
            .upsert({ puzzle_date: date, game: "cast", payload }, { onConflict: "puzzle_date,game" });
          seeded.cast = error ? `error: ${error.message}` : "seeded";
        }
      }

      // rank: the SAME fixed set of 6 films every day (never rotates) so we don't
      // burn through the pool. Prefer the curated RANK_FIXED_TMDB_IDS; if any aren't
      // in the pool, fall back to a DETERMINISTIC pool pick (top-by-votes, spread ≥3,
      // no shuffle / no recency) so it's still identical day to day. Rank films are
      // NOT added to usedIds — they're reused forever and never marked as used.
      if (!wantsGame("rank")) {
        // not requested — leave today's rank puzzle untouched
      } else if (alreadySeeded.has("rank") && !force) {
        seeded.rank = "exists";
      } else {
        const byId = new Map(all.map((m) => [Number(m.tmdb_id), m]));
        let picks = RANK_FIXED_TMDB_IDS
          .map((id) => byId.get(Number(id)))
          .filter((m) => m && Number(m.imdb_rating) > 0 && m.poster_path);
        if (picks.length < GAME_RANK_COUNT) {
          // Deterministic fallback — `all` is already ordered by imdb_votes desc.
          picks = [];
          for (const m of all) {
            if (picks.length >= GAME_RANK_COUNT) break;
            if (!(Array.isArray(m.genres) && m.genres.length && m.director)) continue;
            if (!(Number(m.imdb_rating) > 0 && m.poster_path)) continue;
            if (picks.some((p) => Number(p.tmdb_id) === Number(m.tmdb_id))) continue;
            if (picks.every((p) => Math.abs(Number(p.imdb_rating) - Number(m.imdb_rating)) >= 3)) {
              picks.push(m);
            }
          }
        }
        if (picks.length < GAME_RANK_COUNT) {
          seeded.rank = "insufficient_pool";
        } else {
          const movies = picks.slice(0, GAME_RANK_COUNT).map((m) => ({
            tmdb_id: Number(m.tmdb_id), title: m.title, release_year: m.release_year,
            poster_path: m.poster_path, imdb_rating: m.imdb_rating,
          }));
          const { error } = await supabaseAdmin.from("Game Daily")
            .upsert({ puzzle_date: date, game: "rank", payload: { movies } }, { onConflict: "puzzle_date,game" });
          seeded.rank = error ? `error: ${error.message}` : "seeded";
        }
      }

      // Stamp last_used_date so these films aren't reused for RECENT_DAYS.
      if (usedIds.length) {
        await supabaseAdmin.from("Game Pool")
          .update({ last_used_date: date }).in("tmdb_id", usedIds);
      }

      return jsonResponse({ ok: true, date, seeded, pool_available: recognizable.length }, 200);
    }

    // ---- Games: fetch today's puzzles + the caller's progress (authenticated) --
    // Returns each game's ANSWER-STRIPPED payload plus the caller's Game Results
    // so an in-progress or finished game resumes. Never leaks ratings/answers for
    // unfinished games.
    if (action === "game_today") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);

      const date = gamePuzzleDatePT();
      const { data: dailyRows } = await supabaseAdmin
        .from("Game Daily").select("game,payload").eq("puzzle_date", date);
      const { data: resRows } = await supabaseAdmin
        .from("Game Results").select("game,solved,attempts,score,guesses,completed_at")
        .eq("user_id", me.id).eq("puzzle_date", date);
      const resByGame = new Map((resRows || []).map((r) => [r.game, r]));

      // Per-game current solve streaks (from full history).
      const { data: hist } = await supabaseAdmin
        .from("Game Results").select("game,puzzle_date,solved")
        .eq("user_id", me.id).eq("solved", true).order("puzzle_date", { ascending: false });
      const streakFor = (game) => {
        const days = (hist || []).filter((h) => h.game === game).map((h) => h.puzzle_date);
        const uniq = [...new Set(days)];
        if (!uniq.length) return 0;
        // Count consecutive days back from the most recent solved day.
        let streak = 1;
        for (let i = 1; i < uniq.length; i++) {
          const prev = new Date(uniq[i - 1] + "T00:00:00Z").getTime();
          const cur = new Date(uniq[i] + "T00:00:00Z").getTime();
          if (Math.round((prev - cur) / 86400000) === 1) streak++;
          else break;
        }
        return streak;
      };

      const games = {};
      for (const row of (dailyRows || [])) {
        const game = row.game;
        const p = row.payload || {};
        const res = resByGame.get(game) || null;
        const max = GAME_MAX_GUESSES[game] || 6;
        const attempts = res?.attempts || 0;
        const solved = !!res?.solved;

        if (game === "spottle") {
          const done = solved || attempts >= max;
          const gaveUp = Array.isArray(res?.guesses) && res.guesses.some((x) => x && x.gave_up);
          games.spottle = {
            max_guesses: max, attempts, solved, done, gave_up: gaveUp,
            guesses: Array.isArray(res?.guesses) ? res.guesses : [],
            score: res?.score || 0,
            answer: done ? gameAnswerLite(p.answer) : null,
            hint_after: GAME_SPOTTLE_HINT_AFTER,
            hints: p.answer ? gameHintsForResponse(p.answer, "spottle", attempts) : [],
            streak: streakFor("spottle"),
          };
        } else if (game === "poster") {
          const done = solved || attempts >= max;
          const gaveUp = Array.isArray(res?.guesses) && res.guesses.some((x) => x && x.gave_up);
          games.poster = {
            max_guesses: max, attempts, solved, done, gave_up: gaveUp,
            poster_path: p?.answer?.poster_path || null,
            blur: gamePosterBlur(attempts, max, done),
            guesses: Array.isArray(res?.guesses) ? res.guesses : [],
            score: res?.score || 0,
            answer: done ? gameAnswerLite(p.answer) : null,
            hint_after: GAME_POSTER_HINT_AFTER,
            hints: p.answer ? gameHintsForResponse(p.answer, "poster", attempts) : [],
            streak: streakFor("poster"),
          };
        } else if (game === "cast") {
          const done = solved || attempts >= max;
          const gaveUp = Array.isArray(res?.guesses) && res.guesses.some((x) => x && x.gave_up);
          games.cast = {
            max_guesses: max, attempts, solved, done, gave_up: gaveUp,
            cast_revealed: p.answer ? gameCastReveal(p.answer, attempts, done) : [],
            guesses: Array.isArray(res?.guesses) ? res.guesses : [],
            score: res?.score || 0,
            answer: done ? gameAnswerLite(p.answer) : null,
            hint_after: GAME_CAST_HINT_AFTER,
            hints: p.answer ? gameHintsForResponse(p.answer, "cast", attempts) : [],
            streak: streakFor("cast"),
          };
        } else if (game === "rank") {
          const movies = Array.isArray(p.movies) ? p.movies : [];
          const gaveUp = Array.isArray(res?.guesses) && res.guesses.some((x) => x && x.gave_up);
          const done = !!res; // rank is one-shot (a submit OR a give-up writes a row)
          // Strip imdb_rating + scramble for the unplayed board.
          const board = movies.map((m) => ({
            tmdb_id: m.tmdb_id, title: m.title, release_year: m.release_year, poster_path: m.poster_path,
          }));
          for (let i = board.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [board[i], board[j]] = [board[j], board[i]];
          }
          const trueOrder = movies.slice().sort((a, b) => Number(b.imdb_rating) - Number(a.imdb_rating));
          games.rank = {
            movies: board, done, solved, gave_up: gaveUp, score: res?.score || 0,
            submitted_order: done && Array.isArray(res?.guesses) ? (res.guesses[0]?.order || null) : null,
            result: done ? trueOrder.map((m) => ({
              tmdb_id: m.tmdb_id, title: m.title, release_year: m.release_year,
              poster_path: m.poster_path, imdb_rating: m.imdb_rating,
            })) : null,
            streak: streakFor("rank"),
          };
        }
      }

      const { data: meRow } = await supabaseAdmin
        .from("Users").select("game_points").eq("id", me.id).maybeSingle();
      return jsonResponse({
        ok: true, date, games, game_points: Number(meRow?.game_points) || 0,
      }, 200);
    }

    // ---- Games: pool-scoped autocomplete for guess boxes (authenticated) ------
    // Returns only title/year/poster (NO ratings) so guesses are bounded to real
    // answers without leaking the attributes the games test.
    if (action === "game_search") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      if (userErr || !userData?.user?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);

      // `all:true` returns the WHOLE pool's title index (id/title/year/poster,
      // NO ratings) so the client can cache it once and filter instantly on every
      // keystroke — the movie NAMES aren't secret, only the answers/ratings are.
      const wantAll = body?.all === true;
      let rows;
      if (wantAll) {
        const { data } = await supabaseAdmin
          .from("Game Pool").select("tmdb_id,title,release_year,poster_path")
          .order("imdb_votes", { ascending: false, nullsFirst: false })
          .limit(2000);
        rows = data;
      } else {
        const q = String(body?.query || "").trim();
        if (q.length < 1) return jsonResponse({ ok: true, results: [] }, 200);
        const { data } = await supabaseAdmin
          .from("Game Pool").select("tmdb_id,title,release_year,poster_path")
          .ilike("title", `%${q}%`)
          .order("imdb_votes", { ascending: false, nullsFirst: false })
          .limit(8);
        rows = data;
      }
      return jsonResponse({
        ok: true,
        results: (rows || []).map((m) => ({
          tmdb_id: Number(m.tmdb_id), title: m.title, release_year: m.release_year, poster_path: m.poster_path,
        })),
      }, 200);
    }

    // ---- Games: submit a spottle/poster guess (authenticated) -----------------
    // Compares the guess's pool attributes to the secret answer server-side and
    // returns feedback; writes Game Results with the service role.
    if (action === "game_guess") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);

      const game = String(body?.game || "").trim().toLowerCase();
      if (game !== "spottle" && game !== "poster" && game !== "cast") {
        return jsonResponse({ ok: false, message: "Unknown game." }, 200);
      }
      const guessId = Number(body?.tmdb_id);
      if (!guessId) return jsonResponse({ ok: false, message: "Missing tmdb_id." }, 200);

      const date = gamePuzzleDatePT();
      const { data: dailyRow } = await supabaseAdmin
        .from("Game Daily").select("payload").eq("puzzle_date", date).eq("game", game).maybeSingle();
      const answer = dailyRow?.payload?.answer;
      if (!answer) return jsonResponse({ ok: false, message: "No puzzle for today." }, 200);

      const max = GAME_MAX_GUESSES[game] || 6;
      const { data: resRow } = await supabaseAdmin
        .from("Game Results").select("*")
        .eq("user_id", me.id).eq("puzzle_date", date).eq("game", game).maybeSingle();
      let attempts = resRow?.attempts || 0;
      let solved = !!resRow?.solved;
      const guesses = Array.isArray(resRow?.guesses) ? resRow.guesses.slice() : [];
      if (solved || attempts >= max) {
        return jsonResponse({ ok: false, done: true, message: "Already played today." }, 200);
      }

      // Allow ANY TMDB movie as a guess (not just the cached pool) — resolve it,
      // building its attributes live from TMDB/OMDb when it's not already pooled.
      const OMDB_API_KEY = Deno.env.get("OMDB_API_KEY");
      const gm = await resolveGuessMovie(supabaseAdmin, guessId, TMDB_READ_ACCESS_TOKEN, OMDB_API_KEY);
      if (!gm) return jsonResponse({ ok: false, message: "Couldn't find that movie. Try another." }, 200);

      attempts += 1;
      const correct = Number(guessId) === Number(answer.tmdb_id);
      const feedback = game === "spottle" ? spottleGuessFeedback(gm, answer) : { correct };
      guesses.push({
        tmdb_id: guessId, title: gm.title, release_year: gm.release_year,
        poster_path: gm.poster_path, correct, feedback,
      });
      if (correct) solved = true;
      const done = solved || attempts >= max;
      // Out of guesses (not solved): reveal the answer as a full-green guess card so
      // the board ends the same way a correct guess / give-up does — not just a text
      // banner. (game_giveup pushes the identical revealed card.)
      if (game === "spottle" && done && !solved) {
        guesses.push({
          tmdb_id: answer.tmdb_id, title: answer.title, release_year: answer.release_year,
          poster_path: answer.poster_path, correct: true, revealed: true,
          feedback: spottleGuessFeedback(answer, answer),
        });
      }
      const usedHint = (game === "spottle" || game === "poster" || game === "cast") && !!body?.hint_used;
      const score = gameGuessScore(game, solved, attempts, usedHint);

      const { error: upErr } = await supabaseAdmin.from("Game Results").upsert({
        user_id: me.id, puzzle_date: date, game, solved, attempts, score, guesses,
        completed_at: done ? new Date().toISOString() : null,
      }, { onConflict: "user_id,puzzle_date,game" });
      if (upErr) return jsonResponse({ ok: false, message: `Save failed: ${upErr.message}` }, 200);

      // Bank the points to the user total exactly once — this is the guess that first
      // reaches `done` (earlier guesses early-return above), so it can't double count.
      if (done && score) await addUserGamePoints(supabaseAdmin, me.id, score);

      return jsonResponse({
        ok: true, correct, attempts, max_guesses: max, solved, done, score, feedback, guesses,
        blur: game === "poster" ? gamePosterBlur(attempts, max, done) : undefined,
        cast_revealed: game === "cast" ? gameCastReveal(answer, attempts, done) : undefined,
        answer: done ? gameAnswerLite(answer) : undefined,
        hint_after: GAME_HINT_AFTER[game],
        hints: gameHintsForResponse(answer, game, attempts),
      }, 200);
    }

    // ---- Games: give up on a spottle/poster puzzle (authenticated) ------------
    // Ends today's game as unsolved and reveals the answer. Records a "gave_up"
    // marker in the guesses jsonb (so no schema change) and forces attempts=max so
    // the existing `done = attempts >= max` logic resumes the finished state.
    if (action === "game_giveup") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);

      const game = String(body?.game || "").trim().toLowerCase();
      if (!GAME_LIST.includes(game)) {
        return jsonResponse({ ok: false, message: "Unknown game." }, 200);
      }
      const date = gamePuzzleDatePT();
      const { data: dailyRow } = await supabaseAdmin
        .from("Game Daily").select("payload").eq("puzzle_date", date).eq("game", game).maybeSingle();
      const payload = dailyRow?.payload;
      if (!payload) return jsonResponse({ ok: false, message: "No puzzle for today." }, 200);

      const { data: resRow } = await supabaseAdmin
        .from("Game Results").select("*")
        .eq("user_id", me.id).eq("puzzle_date", date).eq("game", game).maybeSingle();

      // Rank is one-shot: a give-up writes an unsolved result row that reveals the
      // correct order, exactly like a submit would (so it shows up as Done).
      if (game === "rank") {
        if (resRow) return jsonResponse({ ok: false, done: true, message: "Already played today." }, 200);
        const movies = Array.isArray(payload?.movies) ? payload.movies : [];
        if (!movies.length) return jsonResponse({ ok: false, message: "No puzzle for today." }, 200);
        const trueOrder = movies.slice().sort((a, b) => Number(b.imdb_rating) - Number(a.imdb_rating));
        const trueResult = trueOrder.map((m) => ({
          tmdb_id: m.tmdb_id, title: m.title, release_year: m.release_year,
          poster_path: m.poster_path, imdb_rating: m.imdb_rating,
        }));
        const { error: upErr } = await supabaseAdmin.from("Game Results").upsert({
          user_id: me.id, puzzle_date: date, game, solved: false, attempts: 1, score: 0,
          guesses: [{ gave_up: true }], completed_at: new Date().toISOString(),
        }, { onConflict: "user_id,puzzle_date,game" });
        if (upErr) return jsonResponse({ ok: false, message: `Save failed: ${upErr.message}` }, 200);
        return jsonResponse({
          ok: true, done: true, solved: false, gave_up: true, score: 0,
          submitted_order: null, true_order: trueResult,
        }, 200);
      }

      // spottle + poster: force attempts to max so the existing `done` logic resumes
      // the finished state; record a gave_up marker in the guesses jsonb.
      const answer = payload?.answer;
      if (!answer) return jsonResponse({ ok: false, message: "No puzzle for today." }, 200);
      const max = GAME_MAX_GUESSES[game] || 6;
      if (resRow?.solved || (resRow?.attempts || 0) >= max) {
        return jsonResponse({ ok: false, done: true, message: "Already played today." }, 200);
      }
      const guesses = Array.isArray(resRow?.guesses) ? resRow.guesses.slice() : [];
      // For spottle, reveal the answer AS a fully-correct guess card (every tile
      // green, poster + people shown) so the give-up screen displays the movie
      // exactly as if it had been guessed right — not just its name in the banner.
      if (game === "spottle") {
        guesses.push({
          tmdb_id: answer.tmdb_id, title: answer.title, release_year: answer.release_year,
          poster_path: answer.poster_path, correct: true, revealed: true,
          feedback: spottleGuessFeedback(answer, answer),
        });
      }
      guesses.push({ gave_up: true });

      const { error: upErr } = await supabaseAdmin.from("Game Results").upsert({
        user_id: me.id, puzzle_date: date, game, solved: false, attempts: max, score: 0, guesses,
        completed_at: new Date().toISOString(),
      }, { onConflict: "user_id,puzzle_date,game" });
      if (upErr) return jsonResponse({ ok: false, message: `Save failed: ${upErr.message}` }, 200);

      return jsonResponse({
        ok: true, done: true, solved: false, gave_up: true, attempts: max, max_guesses: max,
        score: 0, guesses, answer: gameAnswerLite(answer),
        blur: game === "poster" ? 0 : undefined,
        cast_revealed: game === "cast" ? gameCastReveal(answer, max, true) : undefined,
      }, 200);
    }

    // ---- Games: reveal a hint for the RANK game (authenticated) ----------------
    // Reveals ONLY the single highest-rated film (its correct #1 slot). The client
    // places it at the top; using the hint costs GAME_RANK_HINT_PENALTY points on
    // submit (client passes hint_used, exactly like spottle/poster trust it).
    if (action === "game_hint") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);

      const game = String(body?.game || "").trim().toLowerCase();
      if (game !== "rank") return jsonResponse({ ok: false, message: "No hint for this game." }, 200);

      const date = gamePuzzleDatePT();
      const { data: dailyRow } = await supabaseAdmin
        .from("Game Daily").select("payload").eq("puzzle_date", date).eq("game", "rank").maybeSingle();
      const movies = Array.isArray(dailyRow?.payload?.movies) ? dailyRow.payload.movies : [];
      if (!movies.length) return jsonResponse({ ok: false, message: "No puzzle for today." }, 200);

      // Don't reveal after the game is already finished.
      const { data: resRow } = await supabaseAdmin
        .from("Game Results").select("id").eq("user_id", me.id).eq("puzzle_date", date).eq("game", "rank").maybeSingle();
      if (resRow) return jsonResponse({ ok: false, done: true, message: "Already played today." }, 200);

      const top = movies.slice().sort((a, b) => Number(b.imdb_rating) - Number(a.imdb_rating))[0];
      return jsonResponse({ ok: true, game: "rank", position: 1, tmdb_id: Number(top.tmdb_id) }, 200);
    }

    // ---- Games: backfill box office + studio logo for the pool (cron) ----------
    // build_game_pool skips movies already in "Game Pool", so it never refreshes
    // existing rows. This walks pool rows still missing box_office OR
    // studio_logo_path, re-fetches TMDB details and fills those two columns.
    // Returns `remaining` so a workflow can loop until 0. Gated by CRON_SECRET.
    if (action === "backfill_game_pool_meta") {
      const provided = String(req.headers.get("x-cron-secret") ?? "").trim();
      const expected = String(Deno.env.get("CRON_SECRET") ?? "").trim();
      if (!expected || provided !== expected) {
        return jsonResponse({ code: 401, message: "Invalid or missing cron secret." }, 401);
      }
      const limit = Math.max(1, Math.min(200, Number(body?.limit) || 60));

      // Rows still missing either extra (box_office OR studio_logo_path).
      const { data: rows } = await supabaseAdmin
        .from("Game Pool").select("tmdb_id")
        .or("box_office.is.null,studio_logo_path.is.null")
        .limit(limit);
      const todo = (rows || []).map((r) => Number(r.tmdb_id)).filter(Boolean);

      let updated = 0, failed = 0, idx = 0;
      const CONCURRENCY = 5;
      const worker = async () => {
        while (idx < todo.length) {
          const id = todo[idx++];
          try {
            const det = await tmdbGetJson(`movie/${id}`,
              { append_to_response: "credits,release_dates" }, TMDB_READ_ACCESS_TOKEN);
            const row = tmdbToPoolRow(det, null);
            if (!row) { failed++; continue; }
            // Coalesce unknowns to sentinels (0 / "") so a movie TMDB simply has no
            // revenue/logo for stops matching the "still null" filter — otherwise the
            // looping workflow would never reach remaining=0. formatBoxOffice(0) and an
            // empty logo both render as "no data" on the card.
            const { error: upErr } = await supabaseAdmin.from("Game Pool")
              .update({
                box_office: row.box_office ?? 0,
                studio_logo_path: row.studio_logo_path ?? "",
                updated_at: new Date().toISOString(),
              })
              .eq("tmdb_id", id);
            upErr ? failed++ : updated++;
          } catch (_) { failed++; }
        }
      };
      await Promise.all(Array.from({ length: Math.min(CONCURRENCY, todo.length) }, worker));

      const { count } = await supabaseAdmin
        .from("Game Pool").select("*", { count: "exact", head: true })
        .or("box_office.is.null,studio_logo_path.is.null");
      return jsonResponse({
        ok: true, processed: todo.length, updated, failed, remaining: Number(count) || 0,
      }, 200);
    }

    // ---- Games: submit the rank ordering (authenticated) ----------------------
    // Scores a rank submission (Kendall-tau inversions) server-side; one shot/day.
    if (action === "game_submit") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);

      const game = "rank";
      const date = gamePuzzleDatePT();
      const { data: dailyRow } = await supabaseAdmin
        .from("Game Daily").select("payload").eq("puzzle_date", date).eq("game", game).maybeSingle();
      const movies = Array.isArray(dailyRow?.payload?.movies) ? dailyRow.payload.movies : [];
      if (!movies.length) return jsonResponse({ ok: false, message: "No puzzle for today." }, 200);

      const trueOrder = movies.slice().sort((a, b) => Number(b.imdb_rating) - Number(a.imdb_rating));
      const trueResult = trueOrder.map((m) => ({
        tmdb_id: m.tmdb_id, title: m.title, release_year: m.release_year,
        poster_path: m.poster_path, imdb_rating: m.imdb_rating,
      }));

      // If already submitted, just return the stored result.
      const { data: resRow } = await supabaseAdmin
        .from("Game Results").select("*")
        .eq("user_id", me.id).eq("puzzle_date", date).eq("game", game).maybeSingle();
      if (resRow) {
        return jsonResponse({
          ok: true, done: true, already: true, solved: !!resRow.solved, score: resRow.score || 0,
          submitted_order: resRow.guesses?.[0]?.order || null, true_order: trueResult,
        }, 200);
      }

      const order = Array.isArray(body?.order) ? body.order.map(Number) : [];
      const ids = new Set(movies.map((m) => Number(m.tmdb_id)));
      const validPermutation = order.length === movies.length
        && new Set(order).size === movies.length && order.every((id) => ids.has(id));
      if (!validPermutation) return jsonResponse({ ok: false, message: "Invalid ordering." }, 200);

      // Score = 2 points per movie placed in its correct position, minus a flat
      // penalty if the #1 hint was used (offsets the free correct placement).
      let correctPositions = 0;
      trueOrder.forEach((m, i) => { if (Number(order[i]) === Number(m.tmdb_id)) correctPositions++; });
      const solved = correctPositions === order.length;
      const usedHint = !!body?.hint_used;
      const score = Math.max(0, correctPositions * 2 - (usedHint ? GAME_RANK_HINT_PENALTY : 0));

      const { error: upErr } = await supabaseAdmin.from("Game Results").upsert({
        user_id: me.id, puzzle_date: date, game, solved, attempts: 1, score,
        guesses: [{ order, hint_used: usedHint }], completed_at: new Date().toISOString(),
      }, { onConflict: "user_id,puzzle_date,game" });
      if (upErr) return jsonResponse({ ok: false, message: `Save failed: ${upErr.message}` }, 200);

      // Bank the points to the user total (this handler early-returns above if a row
      // already exists, so a resubmit can't double count).
      if (score) await addUserGamePoints(supabaseAdmin, me.id, score);

      return jsonResponse({
        ok: true, done: true, solved, correct_positions: correctPositions,
        score, submitted_order: order, true_order: trueResult,
      }, 200);
    }

    // ---- Nudge a follow to play today's game (authenticated) ------------------
    // Fired from the full-leaderboard modal's "Nudge" button. Sends the target a
    // Web Push + Activity-inbox row reminding them to play. Only lets you nudge
    // someone you actually FOLLOW; deep-links to the Games page (#games).
    if (action === "nudge_game") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);

      const isUuid = (v) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(v || "").trim());
      const toUserId = String(body?.to_user_id ?? "").trim();
      const game = String(body?.game ?? "").trim();
      const GAME_TITLES = { spottle: "Filmle", rank: "Rank It", poster: "Poster Blur" };
      if (!isUuid(toUserId) || toUserId === me.id) {
        return jsonResponse({ ok: false, message: "Valid to_user_id is required." }, 200);
      }
      if (!GAME_TITLES[game]) {
        return jsonResponse({ ok: false, message: "Unknown game." }, 200);
      }

      // Must actually follow the target (mirrors the follow-scoped nudge RPC).
      const { data: followRow } = await supabaseAdmin
        .from("Follows").select("follower_id")
        .eq("follower_id", me.id).eq("followed_id", toUserId).maybeSingle();
      if (!followRow) {
        return jsonResponse({ ok: false, message: "You can only nudge people you follow." }, 200);
      }

      let handle = "";
      try {
        const { data: frow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", me.id).single();
        const uname = String(frow?.username ?? "").trim();
        handle = uname ? `@${uname}` : String(frow?.display_name ?? "").trim();
      } catch (_) {}
      if (!handle) handle = "Someone";

      const gameTitle = GAME_TITLES[game];
      const bodyText = `${handle} nudged you to play ${gameTitle} today 👉`;
      let notified = 0;
      try {
        const badge = await computeUnseenBadge(supabaseAdmin, toUserId);
        notified = await sendPushToUser(supabaseAdmin, toUserId, {
          title: "Time to play! 🎮",
          body: bodyText,
          url: "/#games",
          badge,
          // Coalesce repeated nudges for the same game into one notification.
          tag: `nudge-${me.id}-${game}`,
        });
      } catch (_) {}
      await recordNotifications(supabaseAdmin, [{
        user_id: toUserId,
        actor_id: me.id,
        type: "game_nudge",
        title: "Game nudge",
        body: bodyText,
        url: "/#games",
        meta: { game },
      }]);

      return jsonResponse({ ok: true, to_user_id: toUserId, game, notified }, 200);
    }

    // ---- Daily "you have movies to rate" reminder (cron job, no user session) --
    // Sends ONE push per user who has ≥1 "Review Drafts" (To Rate) row — the body
    // says how many ("You have N movies waiting to be rated"), NOT one push per
    // movie. Deep-links to Account → To Rate (#pending). Throttled per-user via
    // last_reminded_at so a second run in the same window doesn't double-send.
    // Gated by CRON_SECRET; triggered daily by refresh-pending-reminders.yml.
    if (action === "notify_pending_reviews") {
      const provided = String(req.headers.get("x-cron-secret") ?? "").trim();
      const expected = String(Deno.env.get("CRON_SECRET") ?? "").trim();
      if (!expected || provided !== expected) {
        return jsonResponse({ code: 401, message: "Invalid or missing cron secret." }, 401);
      }

      const throttleHours = Math.max(1, Number(body?.throttle_hours) || 20);
      const cutoffMs = Date.now() - throttleHours * 3600 * 1000;

      // Aggregate drafts per user (count + most-recent reminder), paged.
      const perUser = new Map(); // user_id -> { count, lastReminded (ms) }
      let from = 0;
      while (true) {
        const { data, error } = await supabaseAdmin
          .from("Review Drafts")
          .select("user_id, last_reminded_at")
          .range(from, from + 999);
        if (error) {
          return jsonResponse({ ok: false, message: `Review Drafts scan: ${error.message}` }, 200);
        }
        const page = Array.isArray(data) ? data : [];
        for (const r of page) {
          const uid = String(r?.user_id || "").trim();
          if (!uid) continue;
          const cur = perUser.get(uid) || { count: 0, lastReminded: 0 };
          cur.count += 1;
          const t = r?.last_reminded_at ? Date.parse(r.last_reminded_at) : 0;
          if (t && t > cur.lastReminded) cur.lastReminded = t;
          perUser.set(uid, cur);
        }
        if (page.length < 1000) break;
        from += 1000;
      }

      const nowIso = new Date().toISOString();
      let considered = 0, notified = 0, skipped = 0;
      for (const [uid, info] of perUser.entries()) {
        considered++;
        if (info.lastReminded && info.lastReminded > cutoffMs) { skipped++; continue; }
        const n = info.count;
        const msgBody = n === 1
          ? "You have 1 movie waiting to be rated"
          : `You have ${n} movies waiting to be rated`;
        try {
          const pushed = await sendPushToUser(supabaseAdmin, uid, {
            title: "Rate your movies 🎬",
            body: msgBody,
            url: "/#pending",
            badge: n,
            tag: "pending-reviews",
          });
          if (pushed > 0) {
            notified++;
            try {
              await supabaseAdmin
                .from("Review Drafts")
                .update({ last_reminded_at: nowIso })
                .eq("user_id", uid);
            } catch (_) {}
          }
        } catch (_) {}
      }

      return jsonResponse({ ok: true, considered, notified, skipped }, 200);
    }

    // ---- Daily "play today's games" reminder (cron job, no user session) -------
    // Sent LATER IN THE DAY (evening PT — see the workflow cron) to users who have
    // an active streak but haven't played yet TODAY, nudging them to keep the
    // streak alive. Eligibility (both must hold):
    //   1. played (finished ANY game) YESTERDAY  ⇒ has a streak of ≥1 day, and
    //   2. has NOT finished ANY game TODAY        ⇒ "yet to play".
    // Throttled per-user via a `game_reminder` Notifications row (also the in-app
    // reminder), so a re-run / DST double-fire won't double-send. Gated by
    // CRON_SECRET; triggered by remind-daily-games.yml.
    if (action === "notify_game_reminders") {
      const provided = String(req.headers.get("x-cron-secret") ?? "").trim();
      const expected = String(Deno.env.get("CRON_SECRET") ?? "").trim();
      if (!expected || provided !== expected) {
        return jsonResponse({ code: 401, message: "Invalid or missing cron secret." }, 401);
      }

      const throttleHours = Math.max(1, Number(body?.throttle_hours) || 20);
      const cutoffIso = new Date(Date.now() - throttleHours * 3600 * 1000).toISOString();
      const limit = Math.max(0, Number(body?.limit) || 0);   // 0 = no cap

      const today = gamePuzzleDatePT();
      const yesterday = gamePuzzleDatePT(new Date(Date.now() - 86400000));

      // Distinct user_ids who FINISHED any game on a given puzzle date (paged).
      const finishedUserIdsForDate = async (dateStr) => {
        const set = new Set();
        let from = 0;
        while (true) {
          const { data, error } = await supabaseAdmin
            .from("Game Results")
            .select("user_id")
            .eq("puzzle_date", dateStr)
            .not("completed_at", "is", null)
            .range(from, from + 999);
          if (error) break;
          const page = Array.isArray(data) ? data : [];
          for (const r of page) { const uid = String(r?.user_id || "").trim(); if (uid) set.add(uid); }
          if (page.length < 1000) break;
          from += 1000;
        }
        return set;
      };

      const playedYesterday = await finishedUserIdsForDate(yesterday);
      const playedToday = await finishedUserIdsForDate(today);

      // Recently-reminded users (throttle) — read the game_reminder inbox rows.
      const recentlyReminded = new Set();
      try {
        const { data: recent } = await supabaseAdmin
          .from("Notifications").select("user_id")
          .eq("type", "game_reminder").gt("created_at", cutoffIso);
        for (const r of (Array.isArray(recent) ? recent : [])) {
          const uid = String(r?.user_id || "").trim(); if (uid) recentlyReminded.add(uid);
        }
      } catch (_) {}

      // Eligible = played yesterday, NOT today, not recently reminded.
      const eligible = [];
      for (const uid of playedYesterday) {
        if (playedToday.has(uid)) continue;
        if (recentlyReminded.has(uid)) continue;
        eligible.push(uid);
      }
      const targets = limit > 0 ? eligible.slice(0, limit) : eligible;

      const msgBody = "Keep your streak alive — you haven't played today's games yet!";
      let considered = 0, notified = 0;
      for (const uid of targets) {
        considered++;
        try {
          const badge = await computeUnseenBadge(supabaseAdmin, uid);
          const pushed = await sendPushToUser(supabaseAdmin, uid, {
            title: "Play today's games 🎮",
            body: msgBody,
            url: "/#games",
            badge,
            tag: "game-reminder",
          });
          if (pushed > 0) notified++;
        } catch (_) {}
        // Record the reminder (doubles as the throttle store + in-app Activity row),
        // regardless of whether a push was delivered (covers push-disabled users).
        await recordNotifications(supabaseAdmin, [{
          user_id: uid,
          actor_id: null,
          type: "game_reminder",
          title: "Daily games",
          body: msgBody,
          url: "/#games",
        }]);
      }

      return jsonResponse({
        ok: true, date: today, eligible: eligible.length, considered, notified,
      }, 200);
    }

    // ---- Backfill TMDB keywords for the existing catalog ----------------------
    // Cron-gated (x-cron-secret == CRON_SECRET, no user session). New movies get
    // keywords on save; this fills in movies that pre-date that. Processes the
    // oldest movies WITHOUT any Movie Keywords rows, `limit` at a time, and reports
    // `remaining` so you can re-run until it hits 0. Keywords are static, so no
    // recurring schedule is needed — just run this a few times after deploying.
    if (action === "backfill_movie_keywords") {
      const provided = String(req.headers.get("x-cron-secret") ?? "").trim();
      const expected = String(Deno.env.get("CRON_SECRET") ?? "").trim();
      if (!expected || provided !== expected) {
        return jsonResponse({ code: 401, message: "Invalid or missing cron secret." }, 401);
      }

      const TMDB_TOKEN = Deno.env.get("TMDB_READ_ACCESS_TOKEN");
      if (!TMDB_TOKEN) {
        return jsonResponse({ ok: false, message: "Missing TMDB_READ_ACCESS_TOKEN." }, 200);
      }
      const tmdbHeaders = { Authorization: `Bearer ${TMDB_TOKEN}` };
      const limit = Math.max(1, Math.min(500, Number(body?.limit) || 200));

      // Which movies already have keywords? (paged)
      const haveKw = new Set();
      let kfrom = 0;
      while (true) {
        const { data, error } = await supabaseAdmin
          .from("Movie Keywords")
          .select("movie_id")
          .range(kfrom, kfrom + 999);
        if (error) return jsonResponse({ ok: false, message: `Movie Keywords scan: ${error.message}` }, 200);
        const page = Array.isArray(data) ? data : [];
        page.forEach((r) => { if (r?.movie_id) haveKw.add(String(r.movie_id)); });
        if (page.length < 1000) break;
        kfrom += 1000;
      }

      // Oldest movies with a tmdb_id, minus the ones already done.
      const targets = [];
      let mfrom = 0;
      while (targets.length < limit) {
        const { data, error } = await supabaseAdmin
          .from("Movies")
          .select("id, tmdb_id")
          .not("tmdb_id", "is", null)
          .order("created_at", { ascending: true })
          .range(mfrom, mfrom + 999);
        if (error) return jsonResponse({ ok: false, message: `Movies scan: ${error.message}` }, 200);
        const page = Array.isArray(data) ? data : [];
        for (const m of page) {
          if (targets.length >= limit) break;
          if (!haveKw.has(String(m.id))) targets.push(m);
        }
        if (page.length < 1000) break;
        mfrom += 1000;
      }

      let updated = 0;
      let failed = 0;
      const CONCURRENCY = 4;
      for (let i = 0; i < targets.length; i += CONCURRENCY) {
        const slice = targets.slice(i, i + CONCURRENCY);
        const settled = await Promise.allSettled(
          slice.map((m) => syncMovieKeywords(supabaseAdmin, tmdbHeaders, m.id, m.tmdb_id, null)),
        );
        settled.forEach((s) => {
          if (s.status === "fulfilled" && s.value?.ok) updated += 1;
          else failed += 1;
        });
      }

      // If we filled the batch there are probably more untouched movies — re-run.
      const moreLikely = targets.length >= limit;
      return jsonResponse({
        ok: true,
        processed: targets.length,
        updated,
        failed,
        remaining: moreLikely ? "more (re-run)" : 0,
      }, 200);
    }

    // ---- Refresh watch options (streaming platforms) for movies in users' lists ----
    // Cron-gated (x-cron-secret == CRON_SECRET, no user session). Watch providers go
    // stale (a movie leaves Netflix), so re-pull TMDb providers for the movies that
    // actually matter — the ones sitting in someone's list — a `limit` batch per run,
    // STALEST FIRST (Movies.platforms_synced_at asc, nulls first). The daily GitHub
    // cron rotates through the whole set of list movies over time without blowing the
    // TMDb rate limit. Modeled on refresh_imdb_ratings + backfill_movie_keywords.
    if (action === "refresh_list_watch_platforms") {
      const provided = String(req.headers.get("x-cron-secret") ?? "").trim();
      const expected = String(Deno.env.get("CRON_SECRET") ?? "").trim();
      if (!expected || provided !== expected) {
        return jsonResponse({ code: 401, message: "Invalid or missing cron secret." }, 401);
      }

      const TMDB_TOKEN = Deno.env.get("TMDB_READ_ACCESS_TOKEN");
      if (!TMDB_TOKEN) {
        return jsonResponse({ ok: false, message: "Missing TMDB_READ_ACCESS_TOKEN." }, 200);
      }
      const limit = Math.max(1, Math.min(500, Number(body?.limit) || 200));
      const region = String(body?.region || "US").trim().toUpperCase() || "US";

      // Distinct movie_ids that appear in ANY list (paged).
      const listMovieIds = new Set();
      let lfrom = 0;
      while (true) {
        const { data, error } = await supabaseAdmin
          .from("Movie Lists")
          .select("movie_id")
          .range(lfrom, lfrom + 999);
        if (error) return jsonResponse({ ok: false, message: `Movie Lists scan: ${error.message}` }, 200);
        const page = Array.isArray(data) ? data : [];
        page.forEach((r) => { if (r?.movie_id) listMovieIds.add(String(r.movie_id)); });
        if (page.length < 1000) break;
        lfrom += 1000;
      }

      if (listMovieIds.size === 0) {
        return jsonResponse({ ok: true, processed: 0, updated: 0, failed: 0 }, 200);
      }

      // Walk Movies stalest-first (platforms_synced_at asc, nulls first), keeping only
      // those in a list, until we have a batch.
      const targets = [];
      let mfrom = 0;
      while (targets.length < limit) {
        const { data, error } = await supabaseAdmin
          .from("Movies")
          .select("id, tmdb_id, platforms_synced_at")
          .not("tmdb_id", "is", null)
          .order("platforms_synced_at", { ascending: true, nullsFirst: true })
          .range(mfrom, mfrom + 999);
        if (error) return jsonResponse({ ok: false, message: `Movies scan: ${error.message}` }, 200);
        const page = Array.isArray(data) ? data : [];
        for (const m of page) {
          if (targets.length >= limit) break;
          if (listMovieIds.has(String(m.id))) targets.push(m);
        }
        if (page.length < 1000) break;
        mfrom += 1000;
      }

      let updated = 0;
      let failed = 0;
      const CONCURRENCY = 5;
      for (let i = 0; i < targets.length; i += CONCURRENCY) {
        const slice = targets.slice(i, i + CONCURRENCY);
        const settled = await Promise.allSettled(
          slice.map((m) => syncMovieWatchPlatforms({
            supabaseAdmin,
            movie_id: m.id,
            tmdb_id: m.tmdb_id,
            tmdbReadAccessToken: TMDB_TOKEN,
            region,
            timeoutMs: 1400,
          })),
        );
        settled.forEach((s) => {
          if (s.status === "fulfilled" && !s.value?.error) updated += 1;
          else failed += 1;
        });
      }

      return jsonResponse({ ok: true, processed: targets.length, updated, failed }, 200);
    }

    // ---- Movie recommendations: add a movie to each recipient's "Recs" list ----
    // (Cross-user writes require the service role, so this must run server-side.)
    if (action === "send_recommendation") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const sender = userData?.user || null;
      if (userErr || !sender?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }

      const isUuid = (v) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(v || "").trim());

      const movieId = String(body?.movie_id ?? "").trim();
      if (!isUuid(movieId)) {
        return jsonResponse({ code: 400, message: "Valid movie_id is required." }, 400);
      }
      const note = String(body?.note ?? "").trim().slice(0, 280);
      const recipientIds = Array.from(new Set(
        (Array.isArray(body?.recipient_ids) ? body.recipient_ids : [])
          .map((x) => String(x || "").trim())
          .filter((x) => isUuid(x) && x !== sender.id),
      ));
      if (recipientIds.length === 0) {
        return jsonResponse({ code: 400, message: "No valid recipients." }, 400);
      }

      // Movie details + sender username for the notification text.
      let movieTitle = "", movieYear = "";
      try {
        const { data: mrow } = await supabaseAdmin
          .from("Movies").select("title, release_year").eq("id", movieId).single();
        movieTitle = String(mrow?.title ?? "").trim();
        movieYear = (mrow?.release_year ?? "") === "" ? "" : String(mrow.release_year);
      } catch (_) {}
      let senderHandle = "";
      try {
        const { data: srow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", sender.id).single();
        const uname = String(srow?.username ?? "").trim();
        senderHandle = uname ? `@${uname}` : String(srow?.display_name ?? "").trim();
      } catch (_) {}
      if (!senderHandle) senderHandle = "Someone";

      const results = [];
      for (const rid of recipientIds) {
        const r = { recipient: rid, added: false, notified: false, already: false, seen: false, error: null };
        try {
          // Block: the recipient has already seen (rated/logged) this movie.
          const { data: seenRows } = await supabaseAdmin
            .from("Movie Ratings")
            .select("movie_id")
            .eq("user_id", rid)
            .eq("movie_id", movieId)
            .limit(1);
          if (Array.isArray(seenRows) && seenRows.length) {
            r.seen = true;
            results.push(r);
            continue;
          }

          // Who has already recommended THIS movie to THIS recipient?
          const { data: recRows } = await supabaseAdmin
            .from("Recommendations")
            .select("from_user_id")
            .eq("to_user_id", rid)
            .eq("movie_id", movieId);
          const priorRows = Array.isArray(recRows) ? recRows : [];

          // Block: this exact sender already recommended this movie to this person.
          if (priorRows.some((x) => String(x.from_user_id) === String(sender.id))) {
            r.already = true;
            results.push(r);
            continue;
          }

          // "Recommended Again" when someone else already recommended it to them.
          const isRepeat = priorRows.length > 0;

          // a) Ensure the recipient has a "Recs" list.
          let recsListId = null;
          const { data: existing } = await supabaseAdmin
            .from("Lists").select("id").eq("user_id", rid).eq("list_name", "Recs").limit(1);
          if (Array.isArray(existing) && existing.length) {
            recsListId = existing[0].id;
          } else {
            const { data: created, error: cErr } = await supabaseAdmin
              .from("Lists").insert({ user_id: rid, list_name: "Recs" }).select("id").single();
            if (cErr) throw cErr;
            recsListId = created.id;
          }

          // b) Add the movie to the recipient's Recs list (idempotent).
          const { error: insErr } = await supabaseAdmin
            .from("Movie Lists")
            .upsert({ user_id: rid, list_id: recsListId, movie_id: movieId }, { onConflict: "list_id,movie_id" });
          if (insErr) throw insErr;
          r.added = true;

          // c) Record the recommendation so future repeats from this sender are blocked.
          try {
            await supabaseAdmin
              .from("Recommendations")
              .upsert({ from_user_id: sender.id, to_user_id: rid, movie_id: movieId }, { onConflict: "from_user_id,to_user_id,movie_id" });
          } catch (_) {}

          // c2) In-app Activity inbox row (independent of push delivery).
          await recordNotifications(supabaseAdmin, [{
            user_id: rid,
            actor_id: sender.id,
            type: "recommendation",
            title: isRepeat ? "Recommended again" : "New recommendation",
            body: `${senderHandle} recommended you "${movieTitle || "a movie"}${movieYear ? ` (${movieYear})` : ""}"`,
            url: "/#recs",
            meta: { movie_id: movieId },
          }]);

          // d) Notify via web push (if the recipient has push enabled on any
          //    device). Best-effort — never fail the add on a notify error.
          try {
            const badgeCount = await computeUnseenBadge(supabaseAdmin, rid);
            const pushed = await sendPushToUser(supabaseAdmin, rid, {
              title: isRepeat ? "Recommended Again 🎬" : "New Movie Rec! 🎬",
              body: `${senderHandle} recommended "${movieTitle || "a movie"}${movieYear ? ` (${movieYear})` : ""}"`,
              url: "/#recs",
              badge: badgeCount,
            });
            if (pushed > 0) {
              r.notified = true;
              r.via = "push";
            }
          } catch (e) {
            r.error = `notify error: ${String(e?.message ?? e)}`;
          }
        } catch (e) {
          r.error = String(e?.message ?? e);
        }
        results.push(r);
      }

      return jsonResponse({
        ok: true,
        movie_id: movieId,
        added: results.filter((x) => x.added).length,
        notified: results.filter((x) => x.notified).length,
        already: results.filter((x) => x.already).length,
        seen: results.filter((x) => x.seen).length,
        results,
      }, 200);
    }

    // ---- Notify followers that the caller posted a NEW review ----------------
    // Fired by the diary form ONLY for brand-new entries (never updates), so a
    // push is sent the first time a movie hits a follower's feed. Web push only
    // (no SMS fallback — feeds are higher-volume than recs). Best-effort: each
    // follower's home-screen app badge is set to their accurate unseen count.
    if (action === "notify_new_review") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const author = userData?.user || null;
      if (userErr || !author?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }

      const isUuid = (v) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(v || "").trim());
      const movieId = String(body?.movie_id ?? "").trim();
      if (!isUuid(movieId)) {
        return jsonResponse({ code: 400, message: "Valid movie_id is required." }, 400);
      }

      // Movie title (+ year) for the message.
      let movieTitle = "", movieYear = "";
      try {
        const { data: mrow } = await supabaseAdmin
          .from("Movies").select("title, release_year").eq("id", movieId).single();
        movieTitle = String(mrow?.title ?? "").trim();
        movieYear = (mrow?.release_year ?? "") === "" ? "" : String(mrow.release_year);
      } catch (_) {}

      // Author handle ("@username", falling back to display name).
      let authorHandle = "";
      try {
        const { data: arow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", author.id).single();
        const uname = String(arow?.username ?? "").trim();
        authorHandle = uname ? `@${uname}` : String(arow?.display_name ?? "").trim();
      } catch (_) {}
      if (!authorHandle) authorHandle = "Someone you follow";

      // Followers = rows in Follows whose followed_id is the author.
      let followerIds = [];
      try {
        const { data: fr } = await supabaseAdmin
          .from("Follows").select("follower_id").eq("followed_id", author.id);
        followerIds = Array.from(new Set(
          (Array.isArray(fr) ? fr : []).map((x) => String(x.follower_id || "").trim())
            .filter((x) => isUuid(x) && x !== author.id),
        ));
      } catch (_) {}

      const titlePart = `"${movieTitle || "a movie"}${movieYear ? ` (${movieYear})` : ""}"`;
      let notified = 0;
      const reviewNotifRows = [];
      for (const fid of followerIds) {
        try {
          const badge = await computeUnseenBadge(supabaseAdmin, fid);
          const pushed = await sendPushToUser(supabaseAdmin, fid, {
            title: "New Review 🎬",
            body: `Check out ${authorHandle}'s review of ${titlePart}`,
            // Deep-link straight to the author's diary entry for this movie
            // (handleNotificationRoute → openProfileMovieReview), not just the feed.
            url: `/#review=${author.id}:${movieId}`,
            badge,
            tag: `review-${author.id}-${movieId}`,
          });
          if (pushed > 0) notified++;
        } catch (_) {}
        reviewNotifRows.push({
          user_id: fid,
          actor_id: author.id,
          type: "new_review",
          title: "New review",
          body: `${authorHandle} reviewed ${titlePart}`,
          url: `/#review=${author.id}:${movieId}`,
          meta: { movie_id: movieId },
        });
      }
      await recordNotifications(supabaseAdmin, reviewNotifRows);

      return jsonResponse({ ok: true, movie_id: movieId, followers: followerIds.length, notified }, 200);
    }

    // ---- Notify a user that someone started following them -------------------
    // Fired by the Feed follow button. The caller is the follower; we push the
    // person they just followed ("@you started following you"), deep-linking to
    // the follower's profile so they can check them back out.
    if (action === "notify_new_follower") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const follower = userData?.user || null;
      if (userErr || !follower?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }

      const isUuid = (v) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(v || "").trim());
      const followedId = String(body?.followed_id ?? "").trim();
      if (!isUuid(followedId) || followedId === follower.id) {
        return jsonResponse({ code: 400, message: "Valid followed_id is required." }, 400);
      }

      let followerHandle = "";
      try {
        const { data: frow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", follower.id).single();
        const uname = String(frow?.username ?? "").trim();
        followerHandle = uname ? `@${uname}` : String(frow?.display_name ?? "").trim();
      } catch (_) {}
      if (!followerHandle) followerHandle = "Someone";

      let notified = 0;
      try {
        const badge = await computeUnseenBadge(supabaseAdmin, followedId);
        notified = await sendPushToUser(supabaseAdmin, followedId, {
          title: "New Follower 👋",
          body: `${followerHandle} started following you`,
          url: `/#user=${follower.id}`,
          badge,
          tag: `follow-${follower.id}`,
        });
      } catch (_) {}
      await recordNotifications(supabaseAdmin, [{
        user_id: followedId,
        actor_id: follower.id,
        type: "new_follower",
        title: "New follower",
        body: `${followerHandle} started following you`,
        url: `/#user=${follower.id}`,
      }]);

      return jsonResponse({ ok: true, followed_id: followedId, notified }, 200);
    }

    // ---- Notify recommenders that their recommendation got reviewed ----------
    // Fired by the diary form when the caller rates a movie. Anyone who had
    // recommended THIS movie to the caller (a Recommendations row from_*→caller)
    // gets a push to go read the caller's review (deep-link to the caller's
    // review of that movie). Best-effort, fire-and-forget.
    if (action === "notify_rec_reviewed") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const rater = userData?.user || null;
      if (userErr || !rater?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }

      const isUuid = (v) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(v || "").trim());
      const movieId = String(body?.movie_id ?? "").trim();
      if (!isUuid(movieId)) {
        return jsonResponse({ code: 400, message: "Valid movie_id is required." }, 400);
      }

      // Distinct people who recommended this movie to the caller.
      let recommenderIds = [];
      try {
        const { data: recRows } = await supabaseAdmin
          .from("Recommendations")
          .select("from_user_id")
          .eq("to_user_id", rater.id)
          .eq("movie_id", movieId);
        recommenderIds = Array.from(new Set(
          (Array.isArray(recRows) ? recRows : [])
            .map((x) => String(x.from_user_id || "").trim())
            .filter((x) => isUuid(x) && x !== rater.id),
        ));
      } catch (_) {}
      if (recommenderIds.length === 0) {
        return jsonResponse({ ok: true, movie_id: movieId, recommenders: 0, notified: 0 }, 200);
      }

      let movieTitle = "", movieYear = "";
      try {
        const { data: mrow } = await supabaseAdmin
          .from("Movies").select("title, release_year").eq("id", movieId).single();
        movieTitle = String(mrow?.title ?? "").trim();
        movieYear = (mrow?.release_year ?? "") === "" ? "" : String(mrow.release_year);
      } catch (_) {}
      let raterHandle = "";
      try {
        const { data: rrow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", rater.id).single();
        const uname = String(rrow?.username ?? "").trim();
        raterHandle = uname ? `@${uname}` : String(rrow?.display_name ?? "").trim();
      } catch (_) {}
      if (!raterHandle) raterHandle = "Someone";

      const titlePart = `"${movieTitle || "a movie"}${movieYear ? ` (${movieYear})` : ""}"`;
      let notified = 0;
      const recReviewNotifRows = [];
      for (const recId of recommenderIds) {
        try {
          const badge = await computeUnseenBadge(supabaseAdmin, recId);
          const pushed = await sendPushToUser(supabaseAdmin, recId, {
            title: "Your rec got watched 🎬",
            body: `${raterHandle} reviewed ${titlePart} you recommended`,
            url: `/#review=${rater.id}:${movieId}`,
            badge,
            tag: `rec-review-${rater.id}-${movieId}`,
          });
          if (pushed > 0) notified++;
        } catch (_) {}
        recReviewNotifRows.push({
          user_id: recId,
          actor_id: rater.id,
          type: "rec_reviewed",
          title: "Your rec got watched",
          body: `${raterHandle} reviewed ${titlePart} you recommended`,
          url: `/#review=${rater.id}:${movieId}`,
          meta: { movie_id: movieId },
        });
      }
      await recordNotifications(supabaseAdmin, recReviewNotifRows);

      return jsonResponse({ ok: true, movie_id: movieId, recommenders: recommenderIds.length, notified }, 200);
    }

    // ---- Notify the OTHER members of a shared list of a new movie -------------
    // Fired when a member adds a movie to a shared list. Recipients = the list's
    // members (owner + List Members) minus the person who added it. The caller is
    // verified to be a member before anything is sent. Best-effort web push.
    if (action === "notify_list_add") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const adder = userData?.user || null;
      if (userErr || !adder?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }

      const isUuid = (v) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(v || "").trim());
      const listId = String(body?.list_id ?? "").trim();
      const movieId = String(body?.movie_id ?? "").trim();
      if (!isUuid(listId)) {
        return jsonResponse({ code: 400, message: "Valid list_id is required." }, 400);
      }

      // Resolve the list (owner + name) and its members.
      let ownerId = "", listName = "";
      try {
        const { data: lrow } = await supabaseAdmin
          .from("Lists").select("user_id, list_name").eq("id", listId).single();
        ownerId = String(lrow?.user_id ?? "").trim();
        listName = String(lrow?.list_name ?? "").trim();
      } catch (_) {}
      if (!ownerId) {
        return jsonResponse({ code: 404, message: "List not found." }, 404);
      }

      let memberIds = [];
      try {
        const { data: mrows } = await supabaseAdmin
          .from("List Members").select("user_id").eq("list_id", listId);
        memberIds = (Array.isArray(mrows) ? mrows : [])
          .map((x) => String(x.user_id || "").trim()).filter(isUuid);
      } catch (_) {}

      // The full member set = owner + member rows. Verify the caller belongs to it.
      const allMembers = Array.from(new Set([ownerId, ...memberIds].filter(isUuid)));
      if (!allMembers.includes(adder.id)) {
        return jsonResponse({ code: 403, message: "Not a member of this list." }, 403);
      }
      // Recipients = everyone in the list except the person who added the movie.
      const recipientIds = allMembers.filter((x) => x !== adder.id);
      if (recipientIds.length === 0) {
        return jsonResponse({ ok: true, list_id: listId, recipients: 0, notified: 0 }, 200);
      }

      // Movie title (+ year) + adder handle for the message.
      let movieTitle = "", movieYear = "";
      if (isUuid(movieId)) {
        try {
          const { data: mrow } = await supabaseAdmin
            .from("Movies").select("title, release_year").eq("id", movieId).single();
          movieTitle = String(mrow?.title ?? "").trim();
          movieYear = (mrow?.release_year ?? "") === "" ? "" : String(mrow.release_year);
        } catch (_) {}
      }
      let adderHandle = "";
      try {
        const { data: arow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", adder.id).single();
        const uname = String(arow?.username ?? "").trim();
        adderHandle = uname ? `@${uname}` : String(arow?.display_name ?? "").trim();
      } catch (_) {}
      if (!adderHandle) adderHandle = "Someone";

      const titlePart = `"${movieTitle || "a movie"}${movieYear ? ` (${movieYear})` : ""}"`;
      const listPart = listName || "a shared list";
      let notified = 0;
      const listAddNotifRows = [];
      for (const rid of recipientIds) {
        try {
          const badge = await computeUnseenBadge(supabaseAdmin, rid);
          const pushed = await sendPushToUser(supabaseAdmin, rid, {
            title: `Added to ${listPart} 🎬`,
            body: `${adderHandle} added ${titlePart} to ${listPart}`,
            url: `/#list=${listId}`,
            badge,
            tag: `list-add-${listId}-${movieId}`,
          });
          if (pushed > 0) notified++;
        } catch (_) {}
        listAddNotifRows.push({
          user_id: rid,
          actor_id: adder.id,
          type: "list_add",
          title: `Added to ${listPart}`,
          body: `${adderHandle} added ${titlePart} to ${listPart}`,
          url: `/#list=${listId}`,
          meta: { list_id: listId, movie_id: movieId },
        });
      }
      await recordNotifications(supabaseAdmin, listAddNotifRows);

      return jsonResponse({ ok: true, list_id: listId, recipients: recipientIds.length, notified }, 200);
    }

    // ---- Notify a review's author that someone reacted to it -----------------
    // Fired (fire-and-forget) by the Feed when the caller ADDS an emoji reaction
    // to another user's review. Recipient = the review's author. Self-reactions
    // never notify. Body = `@reactor reacted <emoji> to your review of "Title"`,
    // deep-links to the author's own diary entry for the movie. Best-effort.
    if (action === "notify_review_reaction") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const reactor = userData?.user || null;
      if (userErr || !reactor?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }

      const isUuid = (v) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(v || "").trim());
      const ratingId = String(body?.rating_id ?? "").trim();
      const emoji = String(body?.emoji ?? "").trim().slice(0, 16);
      if (!isUuid(ratingId)) {
        return jsonResponse({ code: 400, message: "Valid rating_id is required." }, 400);
      }

      // Resolve the review → its author + movie.
      let authorId = "", movieId = "";
      try {
        const { data: rrow } = await supabaseAdmin
          .from("Movie Ratings").select("user_id, movie_id").eq("id", ratingId).single();
        authorId = String(rrow?.user_id ?? "").trim();
        movieId = String(rrow?.movie_id ?? "").trim();
      } catch (_) {}
      if (!isUuid(authorId)) {
        return jsonResponse({ code: 404, message: "Review not found." }, 404);
      }
      // Don't notify on a self-reaction.
      if (authorId === reactor.id) {
        return jsonResponse({ ok: true, rating_id: ratingId, notified: 0, self: true }, 200);
      }

      let movieTitle = "", movieYear = "";
      if (isUuid(movieId)) {
        try {
          const { data: mrow } = await supabaseAdmin
            .from("Movies").select("title, release_year").eq("id", movieId).single();
          movieTitle = String(mrow?.title ?? "").trim();
          movieYear = (mrow?.release_year ?? "") === "" ? "" : String(mrow.release_year);
        } catch (_) {}
      }
      let reactorHandle = "";
      try {
        const { data: arow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", reactor.id).single();
        const uname = String(arow?.username ?? "").trim();
        reactorHandle = uname ? `@${uname}` : String(arow?.display_name ?? "").trim();
      } catch (_) {}
      if (!reactorHandle) reactorHandle = "Someone";

      const titlePart = `"${movieTitle || "a movie"}${movieYear ? ` (${movieYear})` : ""}"`;
      const emojiPart = emoji ? `${emoji} ` : "";
      let notified = 0;
      try {
        const badge = await computeUnseenBadge(supabaseAdmin, authorId);
        notified = await sendPushToUser(supabaseAdmin, authorId, {
          title: `New reaction ${emoji || "🎬"}`.trim(),
          body: `${reactorHandle} reacted ${emojiPart}to your review of ${titlePart}`,
          // Deep-link to the author's OWN diary entry for the movie.
          url: `/#review=${authorId}:${movieId}`,
          badge,
          // Coalesce repeated reactions on the same review into one notification.
          tag: `reaction-${ratingId}`,
        });
      } catch (_) {}
      await recordNotifications(supabaseAdmin, [{
        user_id: authorId,
        actor_id: reactor.id,
        type: "review_reaction",
        title: "New reaction",
        body: `${reactorHandle} reacted ${emojiPart}to your review of ${titlePart}`,
        url: `/#review=${authorId}:${movieId}`,
        meta: { emoji, rating_id: ratingId },
      }]);

      return jsonResponse({ ok: true, rating_id: ratingId, notified }, 200);
    }

    // Admin/self test: send a real Web Push to the caller's own subscribed devices.
    if (action === "test_push") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }
      const sent = await sendPushToUser(supabaseAdmin, me.id, {
        title: "CinemaTracker 🍿",
        body: "✅ Push notifications are working!",
        url: "/",
      });
      return jsonResponse({
        ok: true,
        sent,
        reason: sent > 0
          ? undefined
          : "No push sent — enable push on this device first (Account → Push notifications), or VAPID secrets aren't set.",
      }, 200);
    }

    // Admin-only: generate a brand-new achievement (name, description, rule JSON,
    // family, suggested tier/points) PLUS several simple flat-SVG icon options
    // from a broad natural-language prompt. The client lets the admin pick/edit/
    // regenerate an icon and then writes the Achievements row. For franchise /
    // filmography prompts the model lists the films and we resolve them to real
    // TMDB ids so the movie_set rule works.
    if (action === "generate_achievement") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }
      const ADMIN_EMAIL = (Deno.env.get("ADMIN_EMAIL") || "landon.talus@gmail.com").trim().toLowerCase();
      if (String(me.email || "").trim().toLowerCase() !== ADMIN_EMAIL) {
        return jsonResponse({ code: 403, message: "Admin only." }, 403);
      }

      const ANTHROPIC_API_KEY = Deno.env.get("ANTHROPIC_API_KEY");
      if (!ANTHROPIC_API_KEY) {
        return jsonResponse({ code: 500, message: "Missing ANTHROPIC_API_KEY." }, 500);
      }
      const ANTHROPIC_MODEL_BUILDER = Deno.env.get("ANTHROPIC_MODEL_BUILDER") || "claude-sonnet-4-6";

      const prompt = String(body?.prompt ?? "").trim();
      if (!prompt) {
        return jsonResponse({ code: 400, message: "Missing prompt." }, 400);
      }
      const iconCountRaw = Number(body?.icon_count);
      const iconCount = Number.isFinite(iconCountRaw) ? Math.min(6, Math.max(3, Math.floor(iconCountRaw))) : 4;
      // When the admin is iterating on art for an already-decided achievement,
      // they can pass icons_only:true (+ icon_concept) to get fresh art without
      // re-deriving the name/rule/etc.
      const iconsOnly = body?.icons_only === true;
      const iconHint = String(body?.icon_concept ?? "").trim();

      // "More icon options" — no LLM needed: pull fresh icons from the library
      // using the concept (or any extra keywords the client passes), shuffled.
      if (iconsOnly) {
        const kw = Array.isArray(body?.keywords) && body.keywords.length
          ? body.keywords
          : [iconHint || prompt, prompt].filter(Boolean);
        const moreIcons = await iconsFromKeywords(kw, iconCount, true, true); // strict: respect typed terms
        return jsonResponse({ ok: true, icons: moreIcons, keywords: kw }, 200);
      }

      const TIERS = ["Bronze", "Silver", "Gold", "Platinum", "Diamond", "Emerald", "Ruby"];
      const RULE_HELP = [
        "rating_count   - watch/rate N movies total. rule: {type,threshold,source:'ratings'}",
        "rewatch_count  - rewatch one movie N times. rule: {type,threshold,source:'watch_logs'}",
        "director_count - rate N movies by a single director. rule: {type,threshold,source:'ratings'}",
        "genre_count    - rate movies across N distinct genres. rule: {type,threshold,source:'ratings'}",
        "decade_count   - rate movies from N distinct decades. rule: {type,threshold,source:'ratings'}",
        "daily_count    - watch N movies in one day. rule: {type,threshold,source:'watch_logs'}",
        "rolling_week_count - watch N movies within any 7 days. rule:{type,threshold,source:'watch_logs'}",
        "daily_streak   - watch movies N days in a row. rule: {type,threshold,source:'watch_logs'}",
        "weekly_streak  - watch movies N weeks in a row. rule: {type,threshold,source:'watch_logs'}",
        "recommend_count - recommend N movies to other users. rule: {type,threshold}",
        "follow_count   - follow N other users. rule: {type,threshold}",
        "follower_count - reach N followers. rule: {type,threshold}",
        "list_count     - create N custom lists. rule: {type,threshold}",
        "theater_count  - watch N movies in theaters. rule: {type,threshold}",
        "actor_count    - rate N movies starring the same actor. rule: {type,threshold}",
        "quote_count    - save N favourite movie quotes. rule: {type,threshold}",
        "series_count   - watch N TV series. rule: {type,threshold}",
        "runtime_hours  - watch N total HOURS of film (threshold is hours). rule: {type,threshold}",
        "high_rating_count - rate N movies at or above a score. rule: {type,threshold,min_overall:90} (min_overall 0-100, default 90)",
        "movie_set      - watch a SPECIFIC set of films (a franchise/saga/filmography). rule: {type:'movie_set', movies:[{title,year}], require_count?}",
      ].join("\n");

      const system = [
        "You design achievements for a movie-tracking app called CinemaTracker.",
        "Given a broad admin prompt, produce ONE achievement and a list of icon search keywords.",
        "",
        "RULE TYPES (pick the single best fit and fill its fields):",
        RULE_HELP,
        "",
        "For movie_set, also fill 'set_source' so the set can auto-update when new films release:",
        "  - a single DIRECTOR or ACTOR's filmography -> kind:'person', query:<their name>, role:'Director' or 'Actor'.",
        "  - a FRANCHISE/saga TMDB groups as a collection (e.g. Harry Potter, James Bond) -> kind:'collection', query:<franchise name>.",
        "  - a hand-picked/curated SUBSET TMDB does NOT track as one group (e.g. 'the 9 MAIN Star Wars films', excluding spinoffs) -> kind:'manual', and THEN list the exact films in rule.movies (title + year). Do NOT invent films.",
        "Prefer person/collection when possible (those self-update); use manual only for curated subsets.",
        "Pick a creative, evocative NAME (not just the prompt restated), and a clear one-sentence DESCRIPTION.",
        "Pick a 'family' = a short snake_case key shared by sibling tiers of the same progression",
        "(e.g. 'movies_rated', 'director_devotion', 'star_wars_saga'). Tiers in a family share one icon.",
        "Suggest a 'tier' from: " + TIERS.join(", ") + " (harder = higher tier) and integer 'points' (10-200, harder = more).",
        "",
        "LADDER: if this is any COUNT/THRESHOLD achievement (rating_count, rewatch_count, genre_count,",
        "decade_count, daily_count, rolling_week_count, daily_streak, weekly_streak, recommend_count,",
        "follow_count, follower_count, list_count, theater_count, actor_count, quote_count, series_count,",
        "runtime_hours, high_rating_count), ALSO propose a 'ladder'",
        "of 3-6 ADDITIONAL higher tiers of the SAME progression (same family + rule type, escalating threshold,",
        "rising tier toward Ruby, rising points) so the admin can create the whole set at once. Each ladder entry",
        "needs name + 1-line description + threshold + tier + points. Do NOT repeat the requested tier. For",
        "movie_set or genuinely one-off achievements, return an empty ladder.",
        "",
        "ICON KEYWORDS: give 8-12 'icon_keywords' to search an icon library with. NEVER use a proper",
        "noun (person, brand, franchise, title) — those don't exist as icons. Translate the THEME into",
        "concrete everyday OBJECTS associated with it, simplest/most-common first. The system also tries",
        "spelling/plural variants automatically, so plain head nouns work best. Examples:",
        "  'all Christopher Nolan movies' -> 'film','reel','clapperboard','director chair','camera','spinner','clock','maze'",
        "  Star Wars -> 'saber','sword','rocket','planet','robot','helmet','star','spaceship'",
        "  many-movies -> 'film','clapperboard','camera','popcorn','ticket','reel'",
        "  streaks/marathons -> 'fire','calendar','medal','trophy','crown','flame'.",
        "Mix SPECIFIC objects (e.g. 'saber') with several SAFE generic fallbacks ('film','trophy','star')",
        "so at least some icons are always found. Each keyword = a real object noun (1-2 words ok), no verbs.",
        "ALWAYS write multi-word objects as SEPARATE words — 'light saber' NOT 'lightsaber', 'director",
        "chair' NOT 'directorchair', 'death star' NOT 'deathstar'. Never glue words together.",
        "Also set 'icon_concept' to a 2-4 word subject summary.",
      ].filter(Boolean).join("\n");

      const schema = {
        type: "object",
        properties: {
          name: { type: "string" },
          description: { type: "string" },
          family: { type: "string", description: "snake_case key shared by sibling tiers" },
          tier: { type: "string", enum: TIERS },
          points: { type: "integer" },
          icon_concept: { type: "string", description: "2-4 word icon subject summary" },
          icon_keywords: {
            type: "array",
            items: { type: "string", description: "a single concrete object/symbol to search for" },
          },
          ladder: {
            type: "array",
            description: "for count/threshold achievements: ADDITIONAL higher sibling tiers to optionally create together (same family). Empty for movie_set / one-offs.",
            items: {
              type: "object",
              properties: {
                name: { type: "string" },
                description: { type: "string" },
                threshold: { type: "integer" },
                tier: { type: "string", enum: TIERS },
                points: { type: "integer" },
              },
              required: ["name", "threshold", "tier", "points"],
            },
          },
          set_source: {
            type: "object",
            description: "for movie_set: how the film set is defined so it can auto-update",
            properties: {
              kind: { type: "string", enum: ["person", "collection", "manual"] },
              query: { type: "string", description: "the person or franchise/collection name to search on TMDB" },
              role: { type: "string", enum: ["Director", "Actor"] },
            },
          },
          rule: {
            type: "object",
            properties: {
              type: { type: "string" },
              threshold: { type: "integer" },
              source: { type: "string" },
              require_count: { type: "integer" },
              movies: {
                type: "array",
                items: {
                  type: "object",
                  properties: { title: { type: "string" }, year: { type: "integer" } },
                  required: ["title"],
                },
              },
            },
            required: ["type"],
          },
        },
        required: ["name", "description", "family", "tier", "points", "rule", "icon_keywords"],
      };

      let draft;
      try {
        draft = await callAnthropicJson({
          apiKey: ANTHROPIC_API_KEY,
          model: ANTHROPIC_MODEL_BUILDER,
          schemaName: "achievement_draft",
          schema,
          system,
          user: "Admin prompt: " + prompt,
          maxTokens: 2048,
        });
      } catch (e) {
        return jsonResponse({ code: 502, message: "Generation failed: " + String(e?.message || e) }, 502);
      }

      // Pull real icons from the library using the LLM's keywords.
      const keywords = Array.isArray(draft?.icon_keywords) ? draft.icon_keywords : [];
      const icons = await iconsFromKeywords(
        keywords.length ? keywords : [String(draft?.icon_concept || prompt)],
        iconCount,
        false,
        false, // broad: auto AI keywords cast a wide net
      );

      const rule = draft?.rule && typeof draft.rule === "object" ? { ...draft.rule } : {};
      let resolvedMovies = [];
      let setSourceOut = null;

      if (String(rule.type || "") === "movie_set") {
        const ss = draft?.set_source && typeof draft.set_source === "object" ? draft.set_source : {};
        const kind = String(ss?.kind || "").toLowerCase();

        if (kind === "person" || kind === "collection") {
          // Resolve a TMDB person/collection -> store its id + current film list.
          const { source, films } = await resolveMovieSet(ss, TMDB_READ_ACCESS_TOKEN);
          applyMovieSetSourceToRule(rule, source, films);
          resolvedMovies = films;
          setSourceOut = source;
        } else if (Array.isArray(rule.movies)) {
          // Manual / curated subset: resolve the LLM's explicit titles to ids.
          const tmdbIds = [];
          for (const mv of rule.movies.slice(0, 60)) {
            const title = String(mv?.title || "").trim();
            if (!title) continue;
            const sJson = await tmdbGetJson("search/movie", { query: title, year: mv?.year }, TMDB_READ_ACCESS_TOKEN);
            const hit = Array.isArray(sJson?.results) ? sJson.results[0] : null;
            if (hit?.id) {
              tmdbIds.push(Number(hit.id));
              resolvedMovies.push({ title: hit.title || title, year: String(hit.release_date || "").slice(0, 4) || (mv?.year ? String(mv.year) : ""), tmdb_id: Number(hit.id), poster_path: hit.poster_path || null });
            } else {
              resolvedMovies.push({ title, year: mv?.year ? String(mv.year) : "", tmdb_id: null, poster_path: null });
            }
          }
          rule.source_kind = "manual";
          rule.tmdb_ids = tmdbIds;
          if (!rule.require_count) rule.require_count = tmdbIds.length;
          delete rule.movies;
          setSourceOut = { kind: "manual" };
        }
      }

      return jsonResponse({
        ok: true,
        draft: {
          name: String(draft?.name || "").trim(),
          description: String(draft?.description || "").trim(),
          family: String(draft?.family || "").trim(),
          tier: String(draft?.tier || "").trim(),
          points: Number(draft?.points) || 0,
          icon_concept: String(draft?.icon_concept || "").trim(),
          rule,
        },
        icons,
        keywords,
        set_source: setSourceOut,
        resolved_movies: resolvedMovies,
        ladder: (Array.isArray(draft?.ladder) ? draft.ladder : [])
          .filter((e) => e && e.name && Number.isFinite(Number(e.threshold)))
          .map((e) => ({
            name: String(e.name).trim(),
            description: String(e.description || "").trim(),
            threshold: Number(e.threshold),
            tier: String(e.tier || "").trim(),
            points: Number(e.points) || 0,
          })),
      }, 200);
    }

    // Admin-only: (re)resolve a movie_set source against TMDB so the builder can
    // CONFIRM the right person/collection + film list before saving.
    if (action === "resolve_movie_source") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, { global: { headers: { Authorization: authHeader } } });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      const ADMIN_EMAIL = (Deno.env.get("ADMIN_EMAIL") || "landon.talus@gmail.com").trim().toLowerCase();
      if (String(me.email || "").trim().toLowerCase() !== ADMIN_EMAIL) return jsonResponse({ code: 403, message: "Admin only." }, 403);

      const ss = body?.set_source && typeof body.set_source === "object"
        ? body.set_source
        : { kind: body?.kind, query: body?.query, role: body?.role };
      const { source, films } = await resolveMovieSet(ss, TMDB_READ_ACCESS_TOKEN);
      return jsonResponse({
        ok: true,
        source,
        resolved_movies: films,
        tmdb_ids: films.map((f) => f.tmdb_id),
        found: Boolean(source?.person_tmdb_id || source?.collection_tmdb_id),
      }, 200);
    }

    // Admin-only: resolve a list of TMDB movie ids -> display info (title/year/poster),
    // so the builder can show a stored manual movie_set as editable rows when editing.
    if (action === "tmdb_lookup") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, { global: { headers: { Authorization: authHeader } } });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      const ADMIN_EMAIL = (Deno.env.get("ADMIN_EMAIL") || "landon.talus@gmail.com").trim().toLowerCase();
      if (String(me.email || "").trim().toLowerCase() !== ADMIN_EMAIL) return jsonResponse({ code: 403, message: "Admin only." }, 403);

      const ids = (Array.isArray(body?.tmdb_ids) ? body.tmdb_ids : [])
        .map((x) => Number(x)).filter((n) => Number.isFinite(n) && n > 0).slice(0, 80);
      const films = (await mapWithConcurrency(ids, 6, async (id) => {
        const j = await tmdbGetJson(`movie/${id}`, {}, TMDB_READ_ACCESS_TOKEN);
        if (!j?.id) return null;
        return { tmdb_id: Number(j.id), title: String(j.title || j.name || "").trim(), year: String(j.release_date || "").slice(0, 4), poster_path: j.poster_path || null };
      })).filter(Boolean);
      // Preserve the caller's id order.
      films.sort((a, b) => ids.indexOf(a.tmdb_id) - ids.indexOf(b.tmdb_id));
      return jsonResponse({ ok: true, films }, 200);
    }

    // Admin-only: insert (or update, if id is provided) an Achievements row.
    // Uses the service role so it works regardless of table RLS, and is gated to
    // the admin email. When updating, the id is preserved so earned User
    // Achievements rows stay valid. The DB triggers re-award + recalc tiers.
    if (action === "save_achievement") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }
      const ADMIN_EMAIL = (Deno.env.get("ADMIN_EMAIL") || "landon.talus@gmail.com").trim().toLowerCase();
      if (String(me.email || "").trim().toLowerCase() !== ADMIN_EMAIL) {
        return jsonResponse({ code: 403, message: "Admin only." }, 403);
      }

      const a = body?.achievement && typeof body.achievement === "object" ? body.achievement : {};
      const name = String(a?.name || "").trim();
      if (!name) return jsonResponse({ code: 400, message: "Missing achievement name." }, 400);
      const rule = a?.rule && typeof a.rule === "object" ? a.rule : null;

      const row = {
        name,
        description: String(a?.description || "").trim(),
        tier: String(a?.tier || "").trim() || null,
        points: Number(a?.points) || 0,
        family: String(a?.family || "").trim() || null,
        type: rule ? String(rule.type || "").trim() : (String(a?.type || "").trim() || null),
        rule,
        icon_url: String(a?.icon_url || "").trim() || null,
        is_active: a?.is_active === false ? false : true,
      };

      let result;
      const editId = String(a?.id || "").trim();
      if (editId) {
        result = await supabaseAdmin.from("Achievements").update(row).eq("id", editId).select("id").maybeSingle();
      } else {
        // When the admin adds a tier to an existing family and reuses its icon,
        // the row is still a distinct achievement (different name/threshold).
        result = await supabaseAdmin.from("Achievements").insert(row).select("id").maybeSingle();
      }
      if (result?.error) {
        return jsonResponse({ code: 500, message: "Save failed: " + String(result.error.message || result.error) }, 500);
      }

      // If editing a family's art, optionally push the new icon to every sibling.
      if (body?.apply_icon_to_family === true && row.family && row.icon_url) {
        await supabaseAdmin.from("Achievements").update({ icon_url: row.icon_url }).eq("family", row.family);
      }

      // On a NEW achievement, silently grant it to everyone who already qualifies
      // so it's not treated as "newly earned" (and animated) on their next save.
      if (!editId) {
        try { await supabaseAdmin.rpc("award_all_users"); } catch (_) {}
      }

      return jsonResponse({ ok: true, id: result?.data?.id || editId || null }, 200);
    }

    // Poster failsafe (Option B): on each invocation, opportunistically backfill missing Movies.poster_path.
    // NOTE: We skip this during `search` since search fires rapidly while typing.
    if (action !== "search") {
      const hintedRaw = body?.tmdb_id ?? body?.id;
      const hintedTmdbId = Number(hintedRaw);

      // Try the hinted movie first (if any), then repair as many missing posters as possible.
      try {
        if (Number.isFinite(hintedTmdbId) && hintedTmdbId > 0) {
          await tryRepairPosterPathByTmdbId({
            supabaseAdmin,
            tmdbId: hintedTmdbId,
            tmdbReadAccessToken: TMDB_READ_ACCESS_TOKEN,
            timeoutMs: 900,
          });
        }

        await tryRepairAllMissingPosterPathsUncapped({
          supabaseAdmin,
          tmdbReadAccessToken: TMDB_READ_ACCESS_TOKEN,
          pageSize: 150,
          perFetchTimeoutMs: 900,
          concurrency: 6,
        });
      } catch (_) {
        // Best-effort only: never fail the main request.
      }
    }

    // Public action: TMDb search (used by the Home search dropdown).
    // This intentionally does NOT require a logged-in Supabase user; saving still requires auth.
    if (action === "search") {
      const query = String(body?.query ?? "").trim();
      const pageRaw = body?.page === null || body?.page === undefined ? 1 : Number(body.page);
      const page = Number.isFinite(pageRaw) && pageRaw > 0 ? Math.floor(pageRaw) : 1;

      const yearRaw = body?.year ?? body?.release_year ?? body?.primary_release_year;
      const yearNum = yearRaw === null || yearRaw === undefined || String(yearRaw).trim() === ""
        ? null
        : Number(yearRaw);
      const year = Number.isFinite(yearNum) && yearNum > 1800 ? Math.floor(yearNum) : null;

      const mpaFilterRaw = String(body?.mpa ?? "").trim();
      const mpaFilter = mpaFilterRaw ? mpaFilterRaw.toUpperCase() : "";

      const limitRaw = body?.limit === null || body?.limit === undefined ? 8 : Number(body.limit);
      const limit = Number.isFinite(limitRaw) ? Math.max(1, Math.min(12, Math.floor(limitRaw))) : 8;

      // Do not search until the user types at least 2 characters (2-char titles like
      // "Up"/"Us" must be searchable; this is the universal backstop every client
      // movie-search box calls, so the floor lives here as well as client-side).
      if (!query || query.length < 2) {
        return jsonResponse({ results: [], page, total_pages: 0 }, 200);
      }

      const url = new URL("https://api.themoviedb.org/3/search/movie");
      url.searchParams.set("query", query);
      url.searchParams.set("include_adult", "false");
      url.searchParams.set("language", "en-US");
      url.searchParams.set("page", String(page));
      if (year) url.searchParams.set("primary_release_year", String(year));

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb search failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();
      const results = Array.isArray(tmdbJson?.results) ? tmdbJson.results : [];

      const cleaned = results
        .map((r, idx) => ({ r, idx }))
        .filter(({ r }) => Number.isFinite(Number(r?.id)) && String(r?.title ?? "").trim());

      const scored = cleaned
        .map(({ r, idx }) => {
          const score = titleMatchScore({ query, title: r?.title });
          const pop = Number(r?.popularity ?? 0) || 0;
          return { r, idx, score, pop };
        })
        .sort((a, b) => (b.score - a.score) || (b.pop - a.pop) || (a.idx - b.idx));

      // If the user asked for MPA filtering, keep a slightly larger candidate pool so filtering doesn't empty the list.
      const candidateCount = mpaFilter ? 18 : Math.max(limit, 8);
      const candidates = scored.slice(0, candidateCount).map((x) => x.r);

      let filtered = candidates;
      if (mpaFilter) {
        const fetchCert = async (tmdbId) => {
          try {
            const rdUrl = new URL(`https://api.themoviedb.org/3/movie/${tmdbId}/release_dates`);
            const res = await fetch(rdUrl.toString(), { headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` } });
            if (!res.ok) return "";
            const json = await res.json().catch(() => null);
            return extractUsCertification(json) || "";
          } catch (_) {
            return "";
          }
        };

        const withCert = await mapWithConcurrency(filtered, 6, async (r) => {
          const cert = await fetchCert(Number(r?.id));
          return { r, cert: String(cert || "").trim().toUpperCase() };
        });

        filtered = withCert
          .filter(({ cert }) => {
            if (mpaFilter === "NR") return !cert || cert === "NR" || cert === "NOT RATED";
            return cert === mpaFilter;
          })
          .map(({ r }) => r);
      }

      const mapped = filtered
        .slice(0, limit)
        .map((r) => {
          const y = r?.release_date ? Number(String(r.release_date).slice(0, 4)) : null;
          const ids = Array.isArray(r?.genre_ids) ? r.genre_ids : [];
          const genres = uniqStrings(ids.map((id) => TMDB_MOVIE_GENRES[Number(id)]).filter(Boolean));
          const genre = genres.length ? genres.join(", ") : "Movie";
          return {
            id: Number(r.id),
            tmdb_id: Number(r.id),
            title: String(r.title).trim(),
            year: Number.isFinite(y) ? y : null,
            genres,
            genre,
            poster_path: r?.poster_path ? String(r.poster_path) : null,
          };
        });

      return jsonResponse(
        {
          results: mapped,
          page: Number(tmdbJson?.page ?? page) || page,
          total_pages: Number(tmdbJson?.total_pages ?? 0) || 0,
        },
        200,
      );
    }

    // Public action: TMDb person search (used for actor/director avatars).
    if (action === "person") {
      const query = String(body?.query ?? body?.name ?? "").trim();
      const departmentRaw = String(body?.department ?? "").trim().toLowerCase();
      const department = departmentRaw ? departmentRaw : null;
      const limitRaw = body?.limit === null || body?.limit === undefined ? 3 : Number(body.limit);
      const limit = Number.isFinite(limitRaw) ? Math.max(1, Math.min(10, Math.floor(limitRaw))) : 3;

      if (!query || query.length < 2) {
        return jsonResponse({ results: [] }, 200);
      }

      const url = new URL("https://api.themoviedb.org/3/search/person");
      url.searchParams.set("query", query);
      url.searchParams.set("include_adult", "false");
      url.searchParams.set("language", "en-US");
      url.searchParams.set("page", "1");

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb person search failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();
      let results = Array.isArray(tmdbJson?.results) ? tmdbJson.results : [];

      if (department) {
        results = results.filter((r) => String(r?.known_for_department ?? "").trim().toLowerCase() === department);
      }

      const mapped = results
        .slice(0, limit)
        .map((r) => ({
          id: Number(r?.id ?? 0) || null,
          name: String(r?.name ?? "").trim(),
          profile_path: r?.profile_path ? String(r.profile_path).trim() : null,
          known_for_department: String(r?.known_for_department ?? "").trim(),
        }));

      return jsonResponse({ results: mapped }, 200);
    }

    // Public action: fetch full movie details for prefill.
    if (action === "details") {
      const tmdb_id_raw = body?.tmdb_id ?? body?.id;
      const tmdb_id = Number(tmdb_id_raw);
      if (!Number.isFinite(tmdb_id) || tmdb_id <= 0) {
        return jsonResponse({ code: 400, message: "tmdb_id must be a positive number." }, 400);
      }

      const url = new URL(`https://api.themoviedb.org/3/movie/${tmdb_id}`);
      url.searchParams.set("language", "en-US");
      url.searchParams.set("append_to_response", "credits,release_dates,external_ids,watch/providers");

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb details fetch failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();

      const title = String(tmdbJson?.title ?? "").trim();
      let year = tmdbJson?.release_date ? Number(String(tmdbJson.release_date).slice(0, 4)) : null;
      let runtime = Number.isFinite(Number(tmdbJson?.runtime)) && Number(tmdbJson.runtime) > 0 ? Number(tmdbJson.runtime) : null;
      let isSeries = Boolean(tmdbJson?.belongs_to_collection);
      let director = extractDirectorNameFromCredits(tmdbJson?.credits);
      const cast = uniqStrings(
        (Array.isArray(tmdbJson?.credits?.cast) ? tmdbJson.credits.cast : [])
          .slice(0, 4)
          .map((c) => String(c?.name ?? "").trim()),
      );
      // Richer cast list (name + character + headshot) for the Movie Spotlight
      // modal's Cast tab. Top-billed first, capped to keep the payload lean.
      const cast_detailed = (Array.isArray(tmdbJson?.credits?.cast) ? tmdbJson.credits.cast : [])
        .slice(0, 12)
        .map((c) => ({
          name: String(c?.name ?? "").trim(),
          character: String(c?.character ?? "").trim(),
          profile_path: c?.profile_path ? String(c.profile_path) : null,
        }))
        .filter((c) => c.name);

      let genres = uniqStrings(
        (Array.isArray(tmdbJson?.genres) ? tmdbJson.genres : []).map((g) => String(g?.name ?? "").trim()),
      );
      let genre = genres.length ? genres.join(", ") : "";

      let mpa = extractUsCertification(tmdbJson?.release_dates);

      // Watch options (streaming platforms) for the Movie Spotlight "Movie Options"
      // tab. Live from TMDb's watch/providers so it populates no matter where the
      // spotlight was opened from; falls back to the stored catalog platforms below.
      let watch_providers = extractProviderNamesFromWatchProvidersJson(
        tmdbJson?.["watch/providers"],
        "US",
      );

      const imdb_id_raw = String(tmdbJson?.external_ids?.imdb_id ?? "").trim();
      const imdb_id = imdb_id_raw ? imdb_id_raw : null;

      const OMDB_API_KEY = Deno.env.get("OMDB_API_KEY");
      let imdb_rating_pct = null;
      let imdb_votes = null;
      let imdb_rating_error = null;
      try {
        const r = await fetchOmdbImdbRatingPercent({
          imdb_id,
          title,
          year,
          omdbApiKey: OMDB_API_KEY,
        });
        imdb_rating_pct = r?.pct ?? null;
        imdb_votes = Number(r?.votes) > 0 ? Math.round(Number(r.votes)) : null;
        imdb_rating_error = r?.ok ? null : (r?.reason ?? null);
      } catch (e) {
        imdb_rating_pct = null;
        imdb_rating_error = `OMDb fetch crashed: ${String(e?.message ?? e)}`;
      }

      // If this movie is ALREADY in our catalog, merge in the stored DB record so a
      // later user sees whatever the FIRST user contributed — including any details
      // they had to enter MANUALLY because TMDb/OMDb lacked them (MPA for foreign
      // films, IMDb rating, runtime, year, genre, etc.). The rule is "fill the gaps":
      // we always prefer fresh TMDb/OMDb data when it has a value, and only fall back
      // to the stored value where the live source came up blank. This means only the
      // first person to log a movie ever has to type a missing detail.
      try {
        const { data: movieRow } = await supabaseAdmin
          .from("Movies")
          .select("id, release_year, runtime_minutes, mpa_rating, is_series")
          .eq("tmdb_id", tmdb_id)
          .maybeSingle();

        if (movieRow?.id) {
          // IMDb rating + vote count — stored in "Movie External Ratings" (shared).
          if (imdb_rating_pct === null || imdb_rating_pct === undefined || imdb_votes === null) {
            const { data: extRow } = await supabaseAdmin
              .from("Movie External Ratings")
              .select("rating, votes")
              .eq("movie_id", movieRow.id)
              .eq("source", "imdb")
              .maybeSingle();
            const stored = Number(extRow?.rating);
            if ((imdb_rating_pct === null || imdb_rating_pct === undefined) && Number.isFinite(stored) && stored > 0) {
              imdb_rating_pct = stored;
              imdb_rating_error = null;
            }
            const storedVotes = Number(extRow?.votes);
            if (imdb_votes === null && Number.isFinite(storedVotes) && storedVotes > 0) {
              imdb_votes = Math.round(storedVotes);
            }
          }

          // Plain Movies columns.
          if ((year === null || !Number.isFinite(year)) && Number.isFinite(Number(movieRow.release_year))) {
            year = Number(movieRow.release_year);
          }
          if ((runtime === null || !Number.isFinite(runtime) || runtime <= 0) && Number(movieRow.runtime_minutes) > 0) {
            runtime = Number(movieRow.runtime_minutes);
          }
          if (!String(mpa || "").trim() && String(movieRow.mpa_rating || "").trim()) {
            mpa = String(movieRow.mpa_rating).trim();
          }
          if (!isSeries && movieRow.is_series === true) {
            isSeries = true;
          }

          // Director — stored in "Movie Crew" (job='Director') → "People".
          if (!String(director || "").trim()) {
            try {
              const { data: crewRows } = await supabaseAdmin
                .from("Movie Crew")
                .select("job, People(name)")
                .eq("movie_id", movieRow.id)
                .eq("job", "Director")
                .limit(1);
              const peopleRel = crewRows?.[0]?.People;
              const dbDirector = String(
                (Array.isArray(peopleRel) ? peopleRel[0]?.name : peopleRel?.name) ?? "",
              ).trim();
              if (dbDirector) director = dbDirector;
            } catch (_) { /* best-effort */ }
          }

          // Genre — stored in "Movie Genres" → "Genres".
          if (genres.length === 0) {
            try {
              const { data: genreRows } = await supabaseAdmin
                .from("Movie Genres")
                .select("Genres(name)")
                .eq("movie_id", movieRow.id);
              const dbGenres = uniqStrings(
                (Array.isArray(genreRows) ? genreRows : []).map((r) => {
                  const rel = r?.Genres;
                  return String((Array.isArray(rel) ? rel[0]?.name : rel?.name) ?? "").trim();
                }),
              );
              if (dbGenres.length) {
                genres = dbGenres;
                genre = dbGenres.join(", ");
              }
            } catch (_) { /* best-effort */ }
          }

          // Watch options — fall back to stored "Movie Platforms" → "Platforms" when
          // TMDb's live watch/providers came up empty (e.g. rate-limited append).
          if (!watch_providers.length) {
            try {
              const { data: mpRows } = await supabaseAdmin
                .from("Movie Platforms")
                .select("Platforms(name)")
                .eq("movie_id", movieRow.id);
              const dbPlatforms = uniqStrings(
                (Array.isArray(mpRows) ? mpRows : []).map((r) => {
                  const rel = r?.Platforms;
                  return normalizePlatformName(
                    String((Array.isArray(rel) ? rel[0]?.name : rel?.name) ?? "").trim(),
                  );
                }),
              ).filter(Boolean);
              if (dbPlatforms.length) watch_providers = dbPlatforms;
            } catch (_) { /* best-effort */ }
          }
        }
      } catch (_) { /* best-effort DB merge — never block prefill */ }

      return jsonResponse(
        {
          tmdb_id,
          title,
          year: Number.isFinite(year) ? year : null,
          runtime,
          mpa,
          isSeries,
          director: director || "",
          director_profile_path: extractDirectorProfilePath(tmdbJson?.credits),
          cast,
          cast_detailed,
          overview: String(tmdbJson?.overview ?? "").trim(),
          tagline: String(tmdbJson?.tagline ?? "").trim(),
          release_date: tmdbJson?.release_date ? String(tmdbJson.release_date) : null,
          vote_average: Number.isFinite(Number(tmdbJson?.vote_average)) ? Number(tmdbJson.vote_average) : null,
          genres,
          genre,
          poster_path: tmdbJson?.poster_path ? String(tmdbJson.poster_path) : null,
          backdrop_path: tmdbJson?.backdrop_path ? String(tmdbJson.backdrop_path) : null,
          watch_providers,
          imdb_id,
          imdb_rating_pct,
          imdb_votes,
          ...(imdb_rating_error ? { imdb_rating_error } : {}),
        },
        200,
      );
    }

    // Public action: fetch top movie backdrops for Theme Creator.
    if (action === "backdrops") {
      const tmdb_id_raw = body?.tmdb_id ?? body?.id;
      const tmdb_id = Number(tmdb_id_raw);
      if (!Number.isFinite(tmdb_id) || tmdb_id <= 0) {
        return jsonResponse({ code: 400, message: "tmdb_id must be a positive number." }, 400);
      }

      const url = new URL(`https://api.themoviedb.org/3/movie/${tmdb_id}/images`);
      url.searchParams.set("include_image_language", "en,null");

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb backdrops fetch failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();
      const backdrops = Array.isArray(tmdbJson?.backdrops) ? tmdbJson.backdrops : [];

      const parsed = backdrops
        .filter((b) => String(b?.file_path || "").trim())
        .map((b) => ({
          file_path: String(b.file_path).trim(),
          vote_average: Number(b?.vote_average ?? 0) || 0,
          vote_count: Number(b?.vote_count ?? 0) || 0,
          width: Number(b?.width ?? 0) || 0,
          height: Number(b?.height ?? 0) || 0,
          aspect_ratio: Number(b?.aspect_ratio ?? 0) || 0,
        }));

      const sizeScore = (b) => (Number(b.width) || 0) * (Number(b.height) || 0);
      const pickByMinWidth = (minWidth) => parsed
        .filter((b) => Number(b.width) >= minWidth)
        .sort((a, b) => sizeScore(b) - sizeScore(a));

      const tier1 = pickByMinWidth(3840);
      const tier2 = pickByMinWidth(2560);
      const tier3 = pickByMinWidth(1920);

      const mapped = (tier1.length ? tier1 : (tier2.length ? tier2 : tier3))
        .slice(0, 20);

      return jsonResponse({ tmdb_id, backdrops: mapped }, 200);
    }

    // Public action: TMDb trending movies (used by the Home "Trending Now" marquee).
    if (action === "trending") {
      const time_window_raw = String(body?.time_window ?? "day").trim().toLowerCase();
      const time_window = time_window_raw === "week" ? "week" : "day";
      const limit_raw = body?.limit === null || body?.limit === undefined ? 10 : Number(body.limit);
      const limit = Number.isFinite(limit_raw) && limit_raw > 0 ? Math.min(20, Math.floor(limit_raw)) : 10;

      const url = new URL(`https://api.themoviedb.org/3/trending/movie/${time_window}`);
      url.searchParams.set("language", "en-US");

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb trending fetch failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();
      const results = Array.isArray(tmdbJson?.results) ? tmdbJson.results : [];

      const mapped = results
        .filter((r) => Number.isFinite(Number(r?.id)) && String(r?.title ?? "").trim())
        // Prefer only items with posters since this drives a poster marquee.
        .filter((r) => Boolean(String(r?.poster_path ?? "").trim()))
        .slice(0, limit)
        .map((r) => {
          const year = r?.release_date ? Number(String(r.release_date).slice(0, 4)) : null;
          const ids = Array.isArray(r?.genre_ids) ? r.genre_ids : [];
          const genres = uniqStrings(ids.map((id) => TMDB_MOVIE_GENRES[Number(id)]).filter(Boolean));
          const genre = genres.length ? genres[0] : "";
          return {
            id: Number(r.id),
            tmdb_id: Number(r.id),
            title: String(r.title).trim(),
            year: Number.isFinite(year) ? year : null,
            genres,
            genre,
            poster_path: String(r.poster_path).trim(),
          };
        });

      return jsonResponse({ results: mapped, time_window, limit }, 200);
    }

    // Verify caller is authenticated (since Verify JWT is OFF at the platform layer)
    const authHeader = req.headers.get("Authorization") ?? "";
    if (!authHeader.toLowerCase().startsWith("bearer ")) {
      return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
    }

    const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      global: { headers: { Authorization: authHeader } },
    });

    const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
    if (userErr || !userData?.user?.id) {
      return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
    }

    if (action === "ai_picks") {
      const ANTHROPIC_API_KEY = Deno.env.get("ANTHROPIC_API_KEY");
      const ANTHROPIC_MODEL_QUERY = Deno.env.get("ANTHROPIC_MODEL_QUERY") || "claude-haiku-4-5-20251001";
      const ANTHROPIC_MODEL_RERANK = Deno.env.get("ANTHROPIC_MODEL_RERANK") || "claude-sonnet-4-6";

      const debugEnabled = Boolean(body?.debug);

      const prompt = String(body?.prompt ?? "").trim();
      if (!prompt) {
        return jsonResponse({ code: 400, message: "Missing prompt." }, 400);
      }

      const filters = body?.filters && typeof body.filters === "object" ? body.filters : {};
      let tasteProfile = {};
      let tasteModel = { hasData: false };
      let topTasteGenres = [];
      const similarMoviesRaw = Array.isArray(body?.similar_movie)
        ? body.similar_movie
        : (body?.similar_movie && typeof body.similar_movie === "object" ? [body.similar_movie] : []);
      const similarMovies = similarMoviesRaw.filter((m) => m && typeof m === "object").slice(0, 5);

      try {
        const { data: tasteRows, error: tasteErr } = await supabaseAdmin
          .from("Taste Profiles")
          .select("mean_overall, runtime_bins_json, decade_bins_json, imdb_delta, subrating_weights_json, people_affinity_json, genre_affinity_json, keyword_affinity_json, swipe_genre_affinity_json")
          .eq("user_id", userData.user.id)
          .limit(1);
        if (!tasteErr && Array.isArray(tasteRows) && tasteRows.length > 0) {
          const row = tasteRows[0] || {};

          // The reusable per-movie predictor model (genre/decade affinity + crowd anchor).
          tasteModel = buildTasteModel(row);

          // Top positive-affinity genres — used to make "surprise me" prompts (no
          // explicit genre) lean toward what this user actually likes.
          const genreAff = row?.genre_affinity_json && typeof row.genre_affinity_json === "object"
            ? row.genre_affinity_json
            : {};
          topTasteGenres = Object.entries(genreAff)
            .map(([name, info]) => ({ name, aff: Number(info?.aff ?? 0), count: Number(info?.count ?? 0) }))
            .filter((x) => x.aff > 0 && x.count >= 2)
            .sort((a, b) => (b.aff - a.aff) || (b.count - a.count))
            .slice(0, 3)
            .map((x) => x.name);

          // Strongest theme/keyword preferences as a compact {name, aff} list — the
          // rerank LLM matches these against each candidate's overview text (the only
          // place we can apply theme taste in AI Picks, since discover candidates
          // don't carry keywords). aff>0 = a theme you like, aff<0 = one you don't.
          const keywordAff = row?.keyword_affinity_json && typeof row.keyword_affinity_json === "object"
            ? row.keyword_affinity_json
            : {};
          var keywordAffForLlm = Object.entries(keywordAff)
            .map(([name, info]) => ({ name, aff: Number(info?.aff ?? 0) }))
            .filter((x) => Number.isFinite(x.aff) && Math.abs(x.aff) >= 2)
            .sort((a, b) => Math.abs(b.aff) - Math.abs(a.aff))
            .slice(0, 20);

          const runtimeBins = row?.runtime_bins_json && typeof row.runtime_bins_json === "object"
            ? row.runtime_bins_json
            : {};
          const decadeBins = row?.decade_bins_json && typeof row.decade_bins_json === "object"
            ? row.decade_bins_json
            : {};

          const topRuntime = Object.entries(runtimeBins)
            .map(([bin, info]) => ({
              bin: Number(bin),
              avg: Number(info?.avg ?? 0),
              count: Number(info?.count ?? 0),
            }))
            .filter((x) => Number.isFinite(x.bin) && Number.isFinite(x.avg) && x.count > 0)
            .sort((a, b) => (b.avg - a.avg) || (b.count - a.count))
            .slice(0, 1);

          const topDecade = Object.entries(decadeBins)
            .map(([decade, info]) => ({
              decade: Number(decade),
              avg: Number(info?.avg ?? 0),
              count: Number(info?.count ?? 0),
            }))
            .filter((x) => Number.isFinite(x.decade) && Number.isFinite(x.avg) && x.count > 0)
            .sort((a, b) => (b.avg - a.avg) || (b.count - a.count))
            .slice(0, 1);

          tasteProfile = {
            taste_profile_query: {
              preferred_runtime_bin: topRuntime.length ? topRuntime[0] : null,
              preferred_decade: topDecade.length ? topDecade[0] : null,
            },
            taste_profile_rerank: {
              imdb_delta: Number(row?.imdb_delta ?? 0),
              subrating_weights: row?.subrating_weights_json && typeof row.subrating_weights_json === "object"
                ? row.subrating_weights_json
                : {},
              people_affinity: row?.people_affinity_json && typeof row.people_affinity_json === "object"
                ? row.people_affinity_json
                : {},
              genre_affinity: genreAff,
              keyword_affinity: keywordAffForLlm,
            },
          };
        }
      } catch (_) {
        tasteProfile = {};
      }

      const parserSchema = {
        type: "object",
        additionalProperties: false,
        required: ["criteria", "taste_hints"],
        properties: {
          criteria: {
            type: "object",
            additionalProperties: false,
            required: [
              "genres_include",
              "release_year_from",
              "release_year_to",
              "runtime_min",
              "runtime_max",
              "tmdb_rating_min",
              "watch_region",
              "watch_providers",
            ],
            properties: {
              genres_include: { type: "array", items: { type: "string" } },
              release_year_from: { type: "integer" },
              release_year_to: { type: "integer" },
              runtime_min: { type: "integer" },
              runtime_max: { type: "integer" },
              tmdb_rating_min: { type: "integer", minimum: 0, maximum: 100 },
              watch_region: { type: "string" },
              watch_providers: { type: "array", items: { type: "string" } },
            },
          },
          taste_hints: { type: "array", items: { type: "string" } },
        },
      };

      const parserSystem =
        "You are a TMDb discovery query compiler. Convert the user's intent into the best possible discovery strategy while strictly honoring constraints.\n\n" +
        "PRIMARY INTENT (CORE SIGNAL)\n" +
        "Use the prompt field in the provided JSON as the creative source of truth. " +
        "Treat it as the signal for tone, vibe, themes, era, and comparisons.\n\n" +
        "OPTIONAL CONTEXT\n" +
        "If similar_movie data is provided, use it only to clarify tone or themes, not to invent constraints.\n\n" +
        "FILTER HANDLING (HARD CONSTRAINTS)\n" +
        "Strictly respect all user filters from the filters field. These are non-negotiable. " +
        "tmdb_rating_min is 0-100 (percent). Use genres by name (e.g., Comedy, Drama). " +
        "Defaults: treat 0 or empty values as unset. If a filter is set, carry it through unchanged.\n\n" +
        "STRATEGY RULES\n" +
        "- Optimize for recall over precision; goal is a strong candidate pool.\n" +
        "- When intent is ambiguous, choose broader strategies.\n" +
        "- Favor diversity within allowed constraints (genre-adjacent, era-adjacent, tone-adjacent).\n" +
        "- Do not use or request keyword-based filters. The system does not use TMDb keywords.\n" +
        "- If user_runtime_context is false and taste_profile_query.preferred_runtime_bin is provided, you may use it to set a soft runtime range.\n" +
        "- If user_year_context is false and taste_profile_query.preferred_decade is provided, you may use it to set release year bounds.\n" +
        "- If watch providers are not specified, include all known providers.\n" +
        "- If a constraint is not explicitly mentioned, set that field to 0. If no watch_region is specified, set it to empty string.\n" +
        "- Always include at least one genre (use the user's choices if provided; otherwise infer from the prompt).\n\n" +
        "PROHIBITIONS\n" +
        "- Do not rank or recommend specific films.\n" +
        "- Do not judge quality, awards, or cultural impact.\n" +
        "- Do not invent metadata or constraints.\n\n" +
        "RELIABILITY MINDSET\n" +
        "You are a query compiler, not a recommender. When unsure, include rather than exclude.";

      const promptHasRuntime = /\b(\d{2,3})\s*(min|mins|minutes|hr|hrs|hour|hours)\b|\b(short|long)\b/i.test(prompt);
      const promptHasYear = /\b(19\d{2}|20\d{2})\b/.test(prompt);
      const filterHasYear = Number(filters?.release_year_from ?? 0) > 0 || Number(filters?.release_year_to ?? 0) > 0;

      const parserUser = JSON.stringify({
        prompt,
        filters,
        similar_movie: similarMovies,
        user_runtime_context: promptHasRuntime,
        user_year_context: promptHasYear || filterHasYear,
        taste_profile_query: tasteProfile?.taste_profile_query || {},
      });

      let parsed = null;
      try {
        parsed = await callAnthropicJson({
          apiKey: ANTHROPIC_API_KEY,
          model: ANTHROPIC_MODEL_QUERY,
          schemaName: "tmdb_query_json",
          schema: parserSchema,
          system: parserSystem,
          user: parserUser,
        });
      } catch (err) {
        return jsonResponse(
          {
            code: 502,
            message: `Anthropic parse failed: ${String(err?.message || err)}`,
            debug: debugEnabled
              ? {
                  parser_request: safeJsonParse(parserUser),
                }
              : null,
          },
          502,
        );
      }

      const criteria = parsed?.criteria && typeof parsed.criteria === "object" ? parsed.criteria : {};
      const tasteHints = Array.isArray(parsed?.taste_hints) ? parsed.taste_hints : [];
      const tmdbHeaders = { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` };

      const includeNamesFromInputs = uniqStrings([
        ...(Array.isArray(criteria.genres_include) ? criteria.genres_include : []),
        ...(Array.isArray(filters.genres_include) ? filters.genres_include : []),
      ]);

      let similarMovieGenres = [];
      let similarMovieYears = [];
      let similarMovieVotes = [];
      let similarMovieIds = [];

      if (similarMovies.length > 0) {
        const ids = similarMovies
          .map((m) => Number(m?.tmdb_id))
          .filter((id) => Number.isFinite(id) && id > 0)
          .slice(0, 5);
        similarMovieIds = ids;

        const details = await mapWithConcurrency(ids, 3, async (id) => {
          try {
            const simUrl = new URL(`https://api.themoviedb.org/3/movie/${Number(id)}`);
            const simRes = await fetch(simUrl.toString(), { headers: tmdbHeaders });
            if (!simRes.ok) return null;
            return await simRes.json().catch(() => null);
          } catch (_) {
            return null;
          }
        });

        const genreNames = [];
        const years = [];
        const votes = [];
        for (const simJson of details) {
          if (!simJson) continue;
          const g = Array.isArray(simJson?.genres)
            ? simJson.genres.map((x) => String(x?.name || '').trim()).filter(Boolean)
            : [];
          genreNames.push(...g);
          const y = extractTmdbYearFromReleaseDate(simJson?.release_date);
          if (Number.isFinite(y)) years.push(y);
          const v = Number(simJson?.vote_average ?? null);
          if (Number.isFinite(v)) votes.push(v);
        }

        similarMovieGenres = uniqStrings(genreNames);
        similarMovieYears = years;
        similarMovieVotes = votes;
      }

      const inferredGenres = includeNamesFromInputs.length
        ? []
        : (similarMovieGenres.length ? similarMovieGenres : inferGenresFromPrompt(prompt));
      const includeNames = uniqStrings([
        ...includeNamesFromInputs,
        ...inferredGenres,
      ]);

      if (includeNames.length === 0) {
        // No explicit/inferred genre: bias toward the user's own top-affinity genres
        // (taste-aware "surprise me") before falling back to Drama.
        if (topTasteGenres.length) includeNames.push(...topTasteGenres);
        else includeNames.push("Drama");
      }

      const providerNamesFromInputs = uniqStrings([
        ...(Array.isArray(criteria.watch_providers) ? criteria.watch_providers : []),
        ...(Array.isArray(filters.watch_providers) ? filters.watch_providers : []),
      ]);
      const providerNames = providerNamesFromInputs.length
        ? providerNamesFromInputs
        : DEFAULT_WATCH_PROVIDER_NAMES.slice();

      const watchRegionRaw =
        (typeof criteria.watch_region === "string" ? criteria.watch_region : null)
        || (typeof filters.watch_region === "string" ? filters.watch_region : null)
        || "US";
      const watchRegion = String(watchRegionRaw || "US").trim().toUpperCase() || "US";

      const yearFrom = Number(criteria.release_year_from ?? null);
      const yearTo = Number(criteria.release_year_to ?? null);
      const filterYearFrom = Number(filters.release_year_from ?? null);
      const filterYearTo = Number(filters.release_year_to ?? null);

      const mergedYearFrom = [yearFrom, filterYearFrom].filter((v) => Number.isFinite(v) && v > 1800);
      const mergedYearTo = [yearTo, filterYearTo].filter((v) => Number.isFinite(v) && v > 1800);
      let finalYearFrom = mergedYearFrom.length ? Math.max(...mergedYearFrom) : null;
      let finalYearTo = mergedYearTo.length ? Math.min(...mergedYearTo) : null;

      if (!finalYearFrom && !finalYearTo && similarMovieYears.length > 0) {
        const ranges = similarMovieYears
          .filter((y) => Number.isFinite(y))
          .map((y) => inferYearRangeFromSimilarMovie(y));
        const froms = ranges.map((r) => r.from).filter((v) => Number.isFinite(v));
        const tos = ranges.map((r) => r.to).filter((v) => Number.isFinite(v));
        finalYearFrom = froms.length ? Math.min(...froms) : null;
        finalYearTo = tos.length ? Math.max(...tos) : null;
      }

      if (finalYearFrom && finalYearTo && finalYearFrom > finalYearTo) {
        const tmp = finalYearFrom;
        finalYearFrom = finalYearTo;
        finalYearTo = tmp;
      }

      const ratingFromCriteria = Number(criteria.tmdb_rating_min ?? null);
      const ratingFromFilter = Number(filters.tmdb_rating_min ?? null);
      const ratingCandidates = [ratingFromCriteria, ratingFromFilter].filter((v) => Number.isFinite(v));
      let ratingMinPct = ratingCandidates.length ? Math.max(...ratingCandidates) : null;
      if (!Number.isFinite(ratingMinPct) || ratingMinPct <= 0) ratingMinPct = null;

      // NOTE: Do not auto-derive a minimum rating from similar movies; it over-filters results.

      const hasRuntimeHint = promptMentionsRuntime(prompt);
      const runtimeMin = hasRuntimeHint && Number.isFinite(Number(criteria.runtime_min))
        ? Number(criteria.runtime_min)
        : null;
      const runtimeMax = hasRuntimeHint && Number.isFinite(Number(criteria.runtime_max))
        ? Number(criteria.runtime_max)
        : null;

      const includeIds = mapGenreNamesToIds(includeNames);
      const providerIds = mapProviderNamesToIds(providerNames);
      const candidates = [];

      let watchedTmdbIds = null;
      if (filters?.exclude_watched) {
        try {
          watchedTmdbIds = await fetchWatchedTmdbIds(supabaseAdmin, userData.user.id);
        } catch (_) {
          watchedTmdbIds = null;
        }
      }

      const excludeTmdbIds = new Set(similarMovieIds.map((id) => Number(id)).filter((id) => Number.isFinite(id) && id > 0));

      for (let page = 1; page <= 10 && candidates.length < 200; page += 1) {
        const url = new URL("https://api.themoviedb.org/3/discover/movie");
        url.searchParams.set("include_adult", "false");
        url.searchParams.set("page", String(page));
        url.searchParams.set("sort_by", "popularity.desc");
        if (includeIds.length) url.searchParams.set("with_genres", includeIds.join("|"));
        if (finalYearFrom) url.searchParams.set("primary_release_date.gte", `${finalYearFrom}-01-01`);
        if (finalYearTo) url.searchParams.set("primary_release_date.lte", `${finalYearTo}-12-31`);
        if (Number.isFinite(runtimeMin)) url.searchParams.set("with_runtime.gte", String(Math.max(0, Math.floor(runtimeMin))));
        if (Number.isFinite(runtimeMax)) url.searchParams.set("with_runtime.lte", String(Math.max(0, Math.floor(runtimeMax))));
        if (Number.isFinite(ratingMinPct)) {
          const voteAvg = Math.max(0, Math.min(10, ratingMinPct / 10));
          url.searchParams.set("vote_average.gte", String(voteAvg.toFixed(1)));
        }
        if (providerIds.length > 0) {
          url.searchParams.set("watch_region", watchRegion);
          url.searchParams.set("with_watch_providers", providerIds.join("|"));
        }

        const res = await fetch(url.toString(), { headers: tmdbHeaders });
        if (!res.ok) {
          const details = await res.text().catch(() => "");
          return jsonResponse(
            { code: 502, message: "TMDb discover failed.", details: `HTTP ${res.status}${details ? `: ${details}` : ""}` },
            502,
          );
        }

        const json = await res.json().catch(() => null);
        const results = Array.isArray(json?.results) ? json.results : [];

        for (const r of results) {
          if (candidates.length >= 200) break;
          const id = Number(r?.id);
          const title = String(r?.title ?? "").trim();
          if (!Number.isFinite(id) || !title) continue;
          if (excludeTmdbIds.has(id)) continue;
          if (watchedTmdbIds && watchedTmdbIds.has(id)) continue;
          const year = r?.release_date ? Number(String(r.release_date).slice(0, 4)) : null;
          const ids = Array.isArray(r?.genre_ids) ? r.genre_ids : [];
          const genres = uniqStrings(ids.map((gid) => TMDB_MOVIE_GENRES[Number(gid)]).filter(Boolean));
          candidates.push({
            tmdb_id: id,
            title,
            year: Number.isFinite(year) ? year : null,
            genres,
            vote_average: Number(r?.vote_average ?? 0) || 0,
            overview: String(r?.overview ?? "").trim(),
          });
        }
      }

      // Predicted taste score per candidate (0-100) from the user's actual rating
      // history. All candidates already satisfy the prompt's hard filters, so this
      // is what makes the ranking personal instead of popularity-driven.
      if (tasteModel.hasData) {
        for (const c of candidates) {
          const pred = predictTasteScore(tasteModel, {
            genres: c.genres,
            year: c.year,
            vote_average: c.vote_average,
          });
          if (pred) {
            c.taste_score = pred.score;
            if (pred.reasons.length) c.taste_reasons = pred.reasons;
          }
        }
        // Surface the most taste-aligned candidates first (LLMs weight earlier
        // items, and it keeps the strongest fits in view).
        candidates.sort((a, b) => (Number(b.taste_score ?? -1) - Number(a.taste_score ?? -1)));
      }

      const debugPayload = debugEnabled
        ? {
            parser_request: safeJsonParse(parserUser),
            parser_response: parsed,
            parsed_criteria: criteria,
            taste_hints: tasteHints,
            candidates,
            candidates_count: candidates.length,
          }
        : null;

      if (candidates.length === 0) {
        return jsonResponse({ top10: [], debug: debugPayload }, 200);
      }

      const desiredCount = Math.min(10, candidates.length);
      const rerankSchema = {
        type: "object",
        additionalProperties: false,
        required: ["top10"],
        properties: {
          top10: {
            type: "array",
            minItems: desiredCount,
            maxItems: desiredCount,
            items: {
              type: "object",
              additionalProperties: false,
              required: ["tmdb_id", "title", "year", "reason"],
              properties: {
                tmdb_id: { type: "integer" },
                title: { type: "string" },
                year: { type: "integer" },
                reason: { type: "string" },
              },
            },
          },
        },
      };

      const rerankSystem =
        "You are a movie ranking specialist. Rank and explain the candidate results using only the inputs provided to you. Do not introduce any new constraints.\n\n" +
        "PRIMARY INTENT (CORE SIGNAL)\n" +
        "Base your understanding of the user's creative intent primarily on the prompt field in the provided JSON. " +
        "Treat it as the signal for tone, vibe, themes, era, and comparisons.\n\n" +
        "AVAILABLE CONTEXT\n" +
        "Use only the prompt, taste_hints, taste_profile_rerank, and candidates from the provided JSON. " +
        "Assume candidates already satisfy all user filters. " +
        "Do not expect or reference keyword fields; none are provided. " +
        "Each candidate may include a `taste_score` (0-100, the system's prediction of how THIS user would rate the movie, derived from their own rating history) " +
        "and `taste_reasons` (short factual fragments explaining that prediction, e.g. genres/eras they favor). " +
        "taste_profile_rerank may also include imdb_delta, subrating_weights, people_affinity, genre_affinity, and " +
        "keyword_affinity (a list of {name, aff} theme preferences from the user's history; aff>0 = a theme they tend to rate ABOVE their average, aff<0 = below). " +
        "Match keyword_affinity against each candidate's `overview` text — a candidate whose overview reflects the user's liked themes should rank up, and one dominated by disliked themes should rank down.\n\n" +
        "RANKING PRINCIPLES\n" +
        "- Balance TWO signals roughly equally: (a) alignment with the prompt's vibe/themes, and (b) the user's predicted taste (taste_score / taste_reasons / taste_profile_rerank).\n" +
        "- taste_score and taste_reasons are STRONG EVIDENCE about this specific user — treat them as a primary ranking factor, NOT just a tie-breaker. A higher taste_score should meaningfully raise a candidate that also fits the prompt.\n" +
        "- Never let taste override the prompt's explicit hard requirements; among candidates that fit the prompt, prefer those with higher predicted taste.\n" +
        "- The PROMPT outranks taste. Taste is mood-dependent, so when the prompt asks for something AGAINST the user's usual taste (e.g. they typically love action but ask for a quiet romance tonight), follow the prompt — do NOT pull in the usual-taste picks.\n" +
        "- Maintain variety while respecting the prompt; avoid redundant picks.\n" +
        "- Do not rank purely by popularity or ratings.\n" +
        "- Only choose from the provided candidates and always keep each candidate's tmdb_id/title/year exactly as given.\n\n" +
        "EXPLANATIONS (REASONS)\n" +
        "Each ranked item should include a concise, user-facing reason (2-4 sentences) covering: " +
        "(1) why it matches the prompt/filters, and (2) why it aligns with the user's taste — weave in the candidate's taste_reasons naturally when present (speak to the user as 'you'). " +
        "Avoid claims about awards, cultural impact, or production trivia unless explicitly indicated by the prompt or provided metadata.\n\n" +
        "PROHIBITIONS\n" +
        "- Do not invent metadata.\n" +
        "- Do not introduce new constraints.\n" +
        "- Do not judge quality beyond alignment with intent.\n" +
        "- Do not mention internal system logic or tool limitations.\n\n" +
        "RELIABILITY MINDSET\n" +
        "You are a ranker, not a query builder. Use evidence from provided inputs only. " +
        "When unsure, keep the justification general and grounded in the prompt.";
      const rerankUser = JSON.stringify({ prompt, taste_hints: tasteHints, taste_profile_rerank: tasteProfile?.taste_profile_rerank || {}, candidates });

      try {
        const reranked = await callAnthropicJsonWithSearch({
          apiKey: ANTHROPIC_API_KEY,
          model: ANTHROPIC_MODEL_RERANK,
          schemaName: "ai_top10_json",
          schema: rerankSchema,
          system: rerankSystem,
          user: rerankUser,
        });
        const top10Raw = Array.isArray(reranked?.top10) ? reranked.top10 : [];
        const candidatesById = new Map(candidates.map((c) => [Number(c.tmdb_id), c]));
        const candidatesByKey = new Map(candidates.map((c) => [
          `${String(c.title || "").toLowerCase()}|${Number(c.year) || ""}`,
          c,
        ]));

        const OMDB_API_KEY = Deno.env.get("OMDB_API_KEY");

        const top10 = await mapWithConcurrency(top10Raw, 10, async (item) => {
          const rawId = Number(item?.tmdb_id);
          const key = `${String(item?.title || "").toLowerCase()}|${Number(item?.year) || ""}`;
          const candidate = (Number.isFinite(rawId) && rawId > 0 ? candidatesById.get(rawId) : null)
            || candidatesByKey.get(key)
            || null;
          if (!candidate) return item;

          const tmdbId = Number(candidate.tmdb_id);
          if (!Number.isFinite(tmdbId) || tmdbId <= 0) return item;

          try {
            const url = new URL(`https://api.themoviedb.org/3/movie/${tmdbId}`);
            url.searchParams.set("append_to_response", "release_dates,external_ids");
            const res = await fetch(url.toString(), { headers: tmdbHeaders });
            if (!res.ok) return item;
            const json = await res.json().catch(() => null);
            const year = json?.release_date ? Number(String(json.release_date).slice(0, 4)) : null;
            const mpa = extractUsCertification(json?.release_dates);
            const poster = normalizePosterPath(json?.poster_path) || null;
            const voteAvg = Number(json?.vote_average ?? 0) || 0;
            // Pull the IMDb rating (0-100) for this pick. IMDb ratings live in OMDb, one
            // lookup per movie — fine here since this only runs for the ~10 final picks.
            let imdb_rating_pct = null;
            let imdb_votes = null;
            try {
              const imdbId = String(json?.external_ids?.imdb_id ?? "").trim() || null;
              const r = await fetchOmdbImdbRatingPercent({
                imdb_id: imdbId,
                title: candidate.title || item?.title || "",
                year: Number.isFinite(year) ? year : candidate.year ?? item?.year ?? null,
                omdbApiKey: OMDB_API_KEY,
              });
              imdb_rating_pct = r?.pct ?? null;
              imdb_votes = Number(r?.votes) > 0 ? Math.round(Number(r.votes)) : null;
            } catch (_) { imdb_rating_pct = null; imdb_votes = null; }
            return {
              ...item,
              tmdb_id: tmdbId,
              title: candidate.title || item?.title || "",
              year: Number.isFinite(year) ? year : candidate.year ?? item?.year ?? null,
              poster_path: poster,
              tmdb_rating: voteAvg,
              imdb_rating_pct,
              imdb_votes,
              mpa_rating: mpa || "",
              taste_score: typeof candidate.taste_score === "number" ? candidate.taste_score : null,
            };
          } catch (_) {
            return {
              ...item,
              tmdb_id: tmdbId,
              title: candidate.title || item?.title || "",
              year: candidate.year ?? item?.year ?? null,
              taste_score: typeof candidate.taste_score === "number" ? candidate.taste_score : null,
            };
          }
        });

        if (debugPayload) {
          debugPayload.rerank_request = safeJsonParse(rerankUser);
          debugPayload.rerank_response = reranked;
          debugPayload.top10 = top10;
        }

        return jsonResponse({ top10, debug: debugPayload }, 200);
      } catch (err) {
        if (debugPayload) {
          debugPayload.rerank_request = safeJsonParse(rerankUser);
        }
        return jsonResponse(
          { code: 502, message: `Anthropic rerank failed: ${String(err?.message || err)}`, debug: debugPayload },
          502,
        );
      }
    }

    // ---- Discover swipe deck: a ranked batch of unseen movies to swipe on --------
    // Pool = (1) the user's top-affinity genres, (2) trending this week, (3) all-time
    // highly-voted classics. Excludes movies already rated/logged, right-swiped ever,
    // or left-swiped in the last 30 days. Ranked by predictTasteScore with a little
    // random jitter for exploration/variety. No LLM. (Friends'-favorites source +
    // social proof are phase 2.)
    if (action === "swipe_deck") {
      const tmdbHeaders = { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` };
      const limit = Math.max(5, Math.min(40, Number(body?.limit) || 25));
      const uid = userData.user.id;
      // Batch cursor: the client increments this each time it fetches another deck this
      // session, so we walk DEEPER TMDB pages instead of re-returning the same top pages.
      // (0 → pages 1-3, 1 → pages 4-6, …). Without this the pool repeats and runs dry.
      const batch = Math.max(0, Math.min(50, Math.floor(Number(body?.batch) || 0)));
      // Today (UTC, YYYY-MM-DD) — used to drop unreleased movies from the deck.
      const todayStr = new Date().toISOString().slice(0, 10);

      // 1. Taste model + top genres to seed discover.
      let tasteModel = { hasData: false };
      let topGenres = [];
      try {
        const { data: rows } = await supabaseAdmin
          .from("Taste Profiles")
          .select("mean_overall, decade_bins_json, imdb_delta, genre_affinity_json, keyword_affinity_json, swipe_genre_affinity_json")
          .eq("user_id", uid)
          .limit(1);
        if (Array.isArray(rows) && rows.length) {
          tasteModel = buildTasteModel(rows[0]);
          const ga = rows[0]?.genre_affinity_json && typeof rows[0].genre_affinity_json === "object" ? rows[0].genre_affinity_json : {};
          topGenres = Object.entries(ga)
            .map(([name, info]) => ({ name, aff: Number(info?.aff ?? 0), count: Number(info?.count ?? 0) }))
            .filter((x) => x.aff > 0 && x.count >= 2)
            .sort((a, b) => b.aff - a.aff)
            .slice(0, 3)
            .map((x) => x.name);
        }
      } catch (_) { /* new user: no profile yet */ }

      // Cold start: a user with no taste profile (or one too sparse to surface genre
      // affinities) gets no taste-seeded source — the deck collapses to trending +
      // popular. Fall back to the genres they've actually rated HIGHEST so Discover is
      // personalized from day one. Count the genres of their top-rated movies and take
      // the 3 most common.
      if (!topGenres.length) {
        try {
          const { data: rated } = await supabaseAdmin
            .from("Movie Ratings")
            .select("movie_id, overall_rating")
            .eq("user_id", uid)
            .gte("overall_rating", 70)
            .order("overall_rating", { ascending: false })
            .limit(60);
          const movieIds = uniqStrings((Array.isArray(rated) ? rated : []).map((r) => r?.movie_id).filter(Boolean));
          if (movieIds.length) {
            const { data: genreRows } = await supabaseAdmin
              .from("Movie Genres")
              .select("Genres(name)")
              .in("movie_id", movieIds);
            const counts = new Map();
            (Array.isArray(genreRows) ? genreRows : []).forEach((r) => {
              const rel = r?.Genres;
              const name = String((Array.isArray(rel) ? rel[0]?.name : rel?.name) ?? "").trim();
              if (name) counts.set(name, (counts.get(name) || 0) + 1);
            });
            topGenres = Array.from(counts.entries())
              .sort((a, b) => b[1] - a[1])
              .slice(0, 3)
              .map((x) => x[0]);
          }
        } catch (_) { /* no ratings yet → trending + popular only */ }
      }

      // 2. Exclusions: watched + already-swiped (right ever, left within 30 days).
      let watched = new Set();
      try { watched = await fetchWatchedTmdbIds(supabaseAdmin, uid); } catch (_) { watched = new Set(); }
      const swipedExclude = new Set();
      try {
        const cutoff = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();
        const { data: sw } = await supabaseAdmin
          .from("swipes")
          .select("tmdb_id, direction, created_at")
          .eq("user_id", uid);
        (Array.isArray(sw) ? sw : []).forEach((s) => {
          const id = Number(s?.tmdb_id);
          if (!Number.isFinite(id)) return;
          if (s.direction === "right") swipedExclude.add(id);
          else if (s.direction === "left" && String(s.created_at || "") >= cutoff) swipedExclude.add(id);
        });
      } catch (_) { /* swipes table may not exist yet */ }

      // Also exclude movies already on the user's Bucket List OR Recs list (don't
      // suggest a movie they've already saved or been recommended). Movie Lists keys
      // on Movies.id, so resolve to tmdb_id.
      try {
        const { data: alists } = await supabaseAdmin
          .from("Lists")
          .select("id")
          .eq("user_id", uid)
          .in("list_name", ["Bucket List", "Recs"]);
        const listIds = (Array.isArray(alists) ? alists : []).map((l) => l.id).filter(Boolean);
        if (listIds.length) {
          const { data: items } = await supabaseAdmin
            .from("Movie Lists")
            .select("Movies(tmdb_id)")
            .in("list_id", listIds);
          (Array.isArray(items) ? items : []).forEach((row) => {
            const id = Number(row?.Movies?.tmdb_id);
            if (Number.isFinite(id) && id > 0) swipedExclude.add(id);
          });
        }
      } catch (_) { /* best-effort: bucket list / recs exclusion */ }

      // 3. Build the candidate pool.
      const pool = new Map();
      const addCand = (r, source) => {
        const id = Number(r?.id);
        const title = String(r?.title ?? "").trim();
        if (!Number.isFinite(id) || id <= 0 || !title) return;
        if (watched.has(id) || swipedExclude.has(id)) return;
        // Drop Indian-subcontinent commercial films that flood the popularity/trending
        // sources (see DISCOVER_EXCLUDED_LANGS). The friends source bypasses addCand,
        // so a followed user's pick in one of these languages still gets through.
        const lang = String(r?.original_language ?? "").trim().toLowerCase();
        if (lang && DISCOVER_EXCLUDED_LANGS.has(lang)) return;
        // Drop unreleased movies — new/upcoming films often ride the trending list
        // before they've come out. Require a real release_date that's today or earlier.
        const rd = String(r?.release_date ?? "").trim();
        if (!rd || rd > todayStr) return;
        if (pool.has(id)) { pool.get(id).sources.push(source); return; }
        const year = r?.release_date ? Number(String(r.release_date).slice(0, 4)) : null;
        const ids = Array.isArray(r?.genre_ids) ? r.genre_ids : [];
        const genres = uniqStrings(ids.map((g) => TMDB_MOVIE_GENRES[Number(g)]).filter(Boolean));
        pool.set(id, {
          tmdb_id: id,
          title,
          year: Number.isFinite(year) ? year : null,
          poster_path: normalizePosterPath(r?.poster_path) || null,
          genres,
          vote_average: Number(r?.vote_average ?? 0) || 0,
          overview: String(r?.overview ?? "").trim(),
          original_language: lang || null,
          sources: [source],
        });
      };

      const tmdbDiscover = async (params) => {
        const url = new URL("https://api.themoviedb.org/3/discover/movie");
        url.searchParams.set("include_adult", "false");
        url.searchParams.set("language", "en-US");
        // Never surface unreleased movies in the deck.
        url.searchParams.set("primary_release_date.lte", todayStr);
        for (const [k, v] of Object.entries(params)) url.searchParams.set(k, String(v));
        const res = await fetch(url.toString(), { headers: tmdbHeaders });
        if (!res.ok) return [];
        const j = await res.json().catch(() => null);
        return Array.isArray(j?.results) ? j.results : [];
      };

      // Each batch walks three fresh pages deeper so successive decks don't repeat AND
      // each batch has a big enough raw pool to still yield ~25 cards after exclusions
      // (watched / swiped / bucketed). Stride matches the page count so batches never overlap.
      const deckPages = [batch * 3 + 1, batch * 3 + 2, batch * 3 + 3];

      // Source 1 — your taste (top-affinity genres, popular within them).
      const genreIds = mapGenreNamesToIds(topGenres);
      if (genreIds.length) {
        for (const p of deckPages) {
          const r = await tmdbDiscover({ sort_by: "popularity.desc", with_genres: genreIds.join("|"), "vote_count.gte": 100, page: p });
          r.forEach((x) => addCand(x, "taste"));
        }
      }
      // Source 2 — trending this week (only paginate the first couple batches; TMDB's
      // trending list is short and deeper pages just repeat).
      try {
        const trendPage = batch < 2 ? batch + 1 : null;
        if (trendPage) {
          const res = await fetch(`https://api.themoviedb.org/3/trending/movie/week?page=${trendPage}`, { headers: tmdbHeaders });
          if (res.ok) {
            const j = await res.json().catch(() => null);
            (Array.isArray(j?.results) ? j.results : []).forEach((x) => addCand(x, "trending"));
          }
        }
      } catch (_) { /* best-effort */ }
      // Source 3 — all-time popular (highly-voted classics, not just current hits).
      for (const p of deckPages) {
        const r = await tmdbDiscover({ sort_by: "vote_count.desc", "vote_count.gte": 5000, page: p });
        r.forEach((x) => addCand(x, "popular"));
      }

      // Source 4 — movies your follows rated highly + the social-proof data, via the
      // SECURITY DEFINER RPC (runs as the caller, so only people they follow are
      // visible and only safe public columns + the score come back).
      const socialByTmdb = new Map(); // tmdb_id -> [{ name, icon, overall }] for raters >= 90
      try {
        const { data: frows } = await supabaseUserClient.rpc("get_follow_rated_movies", { p_min_overall: 70 });
        const bestFriend = new Map(); // tmdb_id -> { row, best }
        (Array.isArray(frows) ? frows : []).forEach((row) => {
          const id = Number(row?.tmdb_id);
          if (!Number.isFinite(id)) return;
          const overall = Number(row?.overall_rating);
          if (Number.isFinite(overall) && overall >= 85) {
            if (!socialByTmdb.has(id)) socialByTmdb.set(id, []);
            socialByTmdb.get(id).push({ name: String(row?.rater_username || ""), icon: String(row?.rater_icon || ""), overall });
          }
          if (!bestFriend.has(id) || overall > bestFriend.get(id).best) bestFriend.set(id, { row, best: overall });
        });
        // Add the highly-rated ones (>=85) as candidates, built from the RPC's fields.
        bestFriend.forEach(({ row, best }, id) => {
          const title = String(row?.title ?? "").trim();
          if (best < 85 || !title || watched.has(id) || swipedExclude.has(id)) return;
          if (pool.has(id)) { pool.get(id).sources.push("friends"); return; }
          pool.set(id, {
            tmdb_id: id,
            title,
            year: Number.isFinite(Number(row?.release_year)) ? Number(row.release_year) : null,
            poster_path: normalizePosterPath(row?.poster_path) || null,
            genres: Array.isArray(row?.genres) ? uniqStrings(row.genres) : [],
            vote_average: 0,
            overview: "",
            sources: ["friends"],
          });
        });
      } catch (_) { /* RPC may not exist yet */ }

      // 3b. Well-reviewed boost: for candidates ALREADY in our catalog, look up their
      // stored IMDb vote count and give a moderate ranking bump to films above the
      // admin-set threshold (Settings.discover_min_imdb_votes, default 25k). Most
      // candidates are fresh TMDb movies not in the catalog, so they get no bump.
      let reviewThreshold = 25000;
      try {
        const { data: srow } = await supabaseAdmin
          .from("Settings").select("discover_min_imdb_votes").limit(1).maybeSingle();
        const t = Number(srow?.discover_min_imdb_votes);
        if (Number.isFinite(t) && t > 0) reviewThreshold = Math.round(t);
      } catch (_) { /* keep default */ }

      const votesByTmdb = new Map(); // tmdb_id -> stored IMDb vote count (catalog only)
      try {
        const poolTmdbIds = Array.from(pool.keys());
        if (poolTmdbIds.length) {
          const { data: movieRows } = await supabaseAdmin
            .from("Movies").select("id, tmdb_id").in("tmdb_id", poolTmdbIds);
          const tmdbByMovieId = new Map();
          (Array.isArray(movieRows) ? movieRows : []).forEach((m) => {
            if (m?.id && Number.isFinite(Number(m?.tmdb_id))) tmdbByMovieId.set(m.id, Number(m.tmdb_id));
          });
          const movieIds = Array.from(tmdbByMovieId.keys());
          if (movieIds.length) {
            const { data: extRows } = await supabaseAdmin
              .from("Movie External Ratings").select("movie_id, votes")
              .eq("source", "imdb").in("movie_id", movieIds);
            (Array.isArray(extRows) ? extRows : []).forEach((e) => {
              const tid = tmdbByMovieId.get(e?.movie_id);
              const v = Number(e?.votes);
              if (tid && Number.isFinite(v) && v > 0) votesByTmdb.set(tid, Math.round(v));
            });
          }
        }
      } catch (_) { /* best-effort: no catalog-votes boost */ }

      // 4. Score + rank (taste score + small social + review-count boosts + jitter).
      const cards = Array.from(pool.values()).map((c) => {
        const pred = tasteModel.hasData
          ? predictTasteScore(tasteModel, { genres: c.genres, year: c.year, vote_average: c.vote_average })
          : null;
        const taste_score = pred ? pred.score : null;
        const friends = (socialByTmdb.get(c.tmdb_id) || []).slice().sort((a, b) => b.overall - a.overall).slice(0, 3);
        const friendsCount = (socialByTmdb.get(c.tmdb_id) || []).length;
        const socialBoost = friendsCount ? 3 : 0; // socially-validated picks surface a bit (kept gentle so friends' picks don't dominate)
        const imdbVotes = votesByTmdb.get(c.tmdb_id) ?? null;
        const reviewBoost = (imdbVotes !== null && imdbVotes >= reviewThreshold) ? 6 : 0;
        const rankBase = (Number.isFinite(taste_score) ? taste_score : 45) + socialBoost + reviewBoost;
        return {
          tmdb_id: c.tmdb_id,
          title: c.title,
          year: c.year,
          poster_path: c.poster_path,
          genres: c.genres,
          tmdb_rating: c.vote_average,
          overview: c.overview,
          taste_score,
          taste_reasons: pred && pred.reasons.length ? pred.reasons : [],
          friends,
          friends_count: friendsCount,
          ...(imdbVotes !== null ? { imdb_votes: imdbVotes } : {}),
          _rank: rankBase + (Math.random() * 16 - 8),
        };
      });
      cards.sort((a, b) => b._rank - a._rank);
      const deck = cards.slice(0, limit).map(({ _rank, ...rest }) => rest);

      return jsonResponse({ ok: true, cards: deck }, 200);
    }

    const title = String(body?.title ?? "").trim();
    const release_year =
      body?.release_year === null || body?.release_year === undefined
        ? null
        : Number(body.release_year);
    const movie_uuid = uuidLike(body?.movie_id) ? String(body.movie_id).trim() : null;
    const sync_people = Boolean(body?.sync_people);

    // Optional client-provided MPA rating. Used ONLY to fill a blank Movies.mpa_rating
    // (e.g. foreign films where TMDb has no US certification). Validated against the
    // allowed set so junk can't be written; never overwrites an existing TMDb value.
    const mpaOverride = (() => {
      const raw = String(body?.mpa ?? "").trim().toUpperCase();
      const allowed = new Set(["G", "PG", "PG-13", "R", "NC-17", "NR"]);
      return allowed.has(raw) ? raw : "";
    })();

    // Optional client-provided IMDb rating (0–100 percent). Used ONLY to fill a
    // missing external rating (e.g. films OMDb has no rating for). Like the MPA
    // override it never overwrites a real value — only used when OMDb returns
    // nothing AND no rating is already stored. Persisted into "Movie External
    // Ratings" so it survives editing/updating the entry.
    const imdbOverride = (() => {
      const n = Number(body?.imdb);
      return Number.isFinite(n) && n > 0 && n <= 100 ? Math.round(n) : null;
    })();

    // More optional client-provided details, used the SAME way as the MPA override:
    // only to fill a blank/missing value on the SHARED movie record, never to
    // overwrite real TMDb data. This is what lets the FIRST person who logs a movie
    // contribute any detail TMDb is missing so later users don't have to re-enter it.
    const yearOverride = (() => {
      const n = Number(body?.year);
      return Number.isFinite(n) && n >= 1870 && n <= 2100 ? Math.round(n) : null;
    })();
    const runtimeOverride = (() => {
      const n = Number(body?.runtime);
      return Number.isFinite(n) && n > 0 && n <= 1200 ? Math.round(n) : null;
    })();
    const seriesOverride = (() => {
      const raw = String(body?.is_series ?? body?.series ?? "").trim().toUpperCase();
      if (raw === "TRUE") return true;
      if (raw === "FALSE") return false;
      return null; // not provided / unknown
    })();
    const genreOverride = (() => {
      const raw = String(body?.genre ?? "").trim();
      if (!raw) return [];
      return Array.from(new Set(
        raw.split(",").map((s) => s.trim()).filter(Boolean),
      ));
    })();

    if (!movie_uuid && !title) {
      return jsonResponse(
        { code: 400, message: 'Missing "title" (or provide "movie_id").' },
        400,
      );
    }
    if (release_year !== null && !Number.isFinite(release_year)) {
      return jsonResponse({ code: 400, message: "release_year must be a number or null." }, 400);
    }

    // Write to Movies / read tmdb_id using service role (bypasses RLS safely on the server)

    const OMDB_API_KEY = Deno.env.get("OMDB_API_KEY");

    // Your schema uses a quoted, capitalized table name: "People".
    // Using lowercase "people" will fail with a PostgREST schema cache error.
    const PEOPLE_TABLE = "People";

    const insertPeopleFromCredits = async (tmdb_id_value, movie_row_id_value) => {
      const creditsUrl = new URL(
        `https://api.themoviedb.org/3/movie/${tmdb_id_value}/credits`,
      );
      creditsUrl.searchParams.set("language", "en-US");

      const creditsRes = await fetch(creditsUrl.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!creditsRes.ok) {
        const details = await creditsRes.text().catch(() => "");
        return {
          ok: false,
          message: "TMDb credits fetch failed.",
          details: `HTTP ${creditsRes.status}${details ? `: ${details}` : ""}`,
        };
      }

      const creditsJson = await creditsRes.json();

      const norm = (s) => String(s ?? "").trim().toLowerCase();
      const hasIdAndName = (p) => Number.isFinite(Number(p?.id)) && String(p?.name ?? "").trim();

      const cast = Array.isArray(creditsJson?.cast) ? creditsJson.cast : [];
      const topCast = cast
        .filter(hasIdAndName)
        .sort((a, b) => Number(a?.order ?? 9999) - Number(b?.order ?? 9999))
        .slice(0, 20)
        .map((p) => ({
          tmdb_person_id: Number(p.id),
          name: String(p.name).trim(),
          character: String(p?.character ?? "").trim() || null,
        }));

      const crew = Array.isArray(creditsJson?.crew) ? creditsJson.crew : [];

      const pickCrewByJobs = ({
        primary,
        fallback,
        max = 5,
      }) => {
        const normalized = crew
          .filter(hasIdAndName)
          .map((p) => ({
            id: Number(p.id),
            name: String(p.name).trim(),
            job: norm(p?.job),
            department: norm(p?.department),
          }));

        let hits = normalized.filter(primary);
        if (hits.length === 0 && fallback) hits = normalized.filter(fallback);

        // Preserve first-seen ordering (TMDb's crew array is usually already ordered meaningfully)
        const unique = [];
        const seen = new Set();
        for (const h of hits) {
          if (seen.has(h.id)) continue;
          seen.add(h.id);
          unique.push({ tmdb_person_id: h.id, name: h.name });
          if (unique.length >= max) break;
        }
        return unique;
      };

      // Directors
      const directors = pickCrewByJobs({
        primary: (p) => p.job === "director",
        fallback: (p) =>
          p.job.includes("director") &&
          !p.job.includes("assistant") &&
          !p.job.includes("second") &&
          !p.job.includes("third"),
        max: 5,
      });

      // Writers (job titles vary: Writer, Screenplay, Story, Teleplay, etc.)
      const writers = pickCrewByJobs({
        primary: (p) =>
          p.department === "writing" &&
          (p.job.includes("writer") ||
            p.job.includes("screenplay") ||
            p.job.includes("story") ||
            p.job.includes("teleplay")),
        fallback: (p) =>
          p.job.includes("writer") ||
          p.job.includes("screenplay") ||
          p.job.includes("story") ||
          p.job.includes("teleplay"),
        max: 10,
      });

      // Music composers (job titles vary: Original Music Composer, Composer, Music, Score, etc.)
      const composers = pickCrewByJobs({
        primary: (p) => p.job.includes("composer"),
        fallback: (p) =>
          (p.job.includes("music") && (p.job.includes("score") || p.job.includes("composer"))) ||
          p.job.includes("original music"),
        max: 5,
      });

      const tableName = PEOPLE_TABLE;

      // Combine cast + key crew roles, then de-dupe by tmdb_person_id.
      const combined = [...topCast, ...directors, ...writers, ...composers];
      const byId = new Map();
      for (const p of combined) {
        if (!Number.isFinite(Number(p?.tmdb_person_id))) continue;
        const id = Number(p.tmdb_person_id);
        if (!byId.has(id)) byId.set(id, { tmdb_person_id: id, name: String(p?.name ?? "").trim() });
      }
      const people = Array.from(byId.values()).filter((p) => p.tmdb_person_id && p.name);

      if (people.length === 0) {
        return {
          ok: true,
          requested: 0,
          inserted: 0,
          skipped: 0,
          table: tableName,
          roles: { cast: topCast.length, directors: directors.length, writers: writers.length, composers: composers.length },
        };
      }

      const ids = people.map((p) => p.tmdb_person_id);

      // Preselect existing ids (also returns UUID ids for join tables).
      const { data: existing, error: existingErr } = await supabaseAdmin
        .from(tableName)
        .select("id, tmdb_person_id")
        .in("tmdb_person_id", ids);

      if (existingErr) {
        return {
          ok: false,
          message: "Failed to check existing People rows.",
          details: existingErr.message,
          table: tableName,
        };
      }

      const existingSet = new Set(
        (existing ?? [])
          .map((r) => Number(r?.tmdb_person_id))
          .filter((n) => Number.isFinite(n)),
      );

      const newRows = people.filter((p) => !existingSet.has(p.tmdb_person_id));

      if (newRows.length > 0) {
        const { error: insErr } = await supabaseAdmin.from(tableName).insert(newRows);
        if (insErr) {
          return {
            ok: false,
            message: "Failed to insert People rows.",
            details: insErr.message,
            table: tableName,
          };
        }
      }

      // Fetch UUID ids for all involved tmdb_person_id values (for join tables).
      const { data: allPeopleRows, error: allPeopleErr } = await supabaseAdmin
        .from(tableName)
        .select("id, tmdb_person_id")
        .in("tmdb_person_id", ids);

      if (allPeopleErr) {
        return {
          ok: false,
          message: "Failed to load People ids after insert.",
          details: allPeopleErr.message,
          table: tableName,
        };
      }

      const tmdbToUuid = new Map();
      for (const r of allPeopleRows ?? []) {
        const tid = Number(r?.tmdb_person_id);
        if (!Number.isFinite(tid)) continue;
        if (r?.id) tmdbToUuid.set(tid, r.id);
      }

      const castSync = {
        requested: topCast.length,
        inserted: 0,
        error: null,
      };
      const crewSync = {
        requested: directors.length + writers.length + composers.length,
        inserted: 0,
        error: null,
        preview: [],
        duplicates_by_person: [],
      };

      const tryInsertMovieCast = async (rows) => {
        const { error } = await supabaseAdmin.from("Movie Cast").insert(rows);
        return error || null;
      };

      const tryInsertMovieCrew = async (rows) => {
        const { error } = await supabaseAdmin.from("Movie Crew").insert(rows);
        return error || null;
      };

      // Populate join tables if movie_row_id is available.
      if (movie_row_id_value) {
        // Movie Cast
        try {
          const castRows = topCast
            .map((p) => ({
              movie_id: movie_row_id_value,
              person_id: tmdbToUuid.get(Number(p.tmdb_person_id)) || null,
              character: p.character,
            }))
            .filter((r) => r.person_id);

          // Refresh rows for this movie_id (idempotent)
          const { error: delErr } = await supabaseAdmin
            .from("Movie Cast")
            .delete()
            .eq("movie_id", movie_row_id_value);

          if (delErr) {
            castSync.error = `Failed to clear Movie Cast: ${delErr.message}`;
          } else if (castRows.length > 0) {
            const insErr = await tryInsertMovieCast(castRows);
            if (insErr) castSync.error = `Failed to insert Movie Cast: ${insErr.message}`;
            else castSync.inserted = castRows.length;
          }
        } catch (e) {
          castSync.error = `Movie Cast sync crashed: ${String(e?.message ?? e)}`;
        }

        // Movie Crew
        try {
          const normalizeJob = (raw) => {
            const j = norm(raw);
            if (!j) return null;
            if (j === "director" || j.includes("director")) return "Director";
            if (j.includes("writer") || j.includes("screenplay") || j.includes("story") || j.includes("teleplay")) return "Writer";
            if (j.includes("composer") || j.includes("original music")) return "Composer";
            if (j.includes("music") && j.includes("score")) return "Composer";
            return null;
          };

          const crewSource = [
            ...directors.map((p) => ({ ...p, rawJob: "director" })),
            ...writers.map((p) => ({ ...p, rawJob: "writer" })),
            ...composers.map((p) => ({ ...p, rawJob: "composer" })),
          ];

          const crewRowsRaw = crewSource
            .map((p) => {
              const person_id = tmdbToUuid.get(Number(p.tmdb_person_id)) || null;
              const job = normalizeJob(p.rawJob) || null;
              return {
                movie_id: movie_row_id_value,
                person_id,
                job,
                name: String(p?.name ?? "").trim() || null,
                tmdb_person_id: Number(p?.tmdb_person_id) || null,
              };
            })
            .filter((r) => r.person_id && r.job);

          // Dedupe by person_id+job
          const seenCrew = new Set();
          const crewRows = [];
          for (const r of crewRowsRaw) {
            const key = `${r.person_id}|${r.job}`;
            if (seenCrew.has(key)) continue;
            seenCrew.add(key);
            crewRows.push({ movie_id: r.movie_id, person_id: r.person_id, job: r.job });
          }

          crewSync.preview = crewRowsRaw
            .slice(0, 50)
            .map((r) => ({
              movie_id: r.movie_id,
              person_id: r.person_id,
              name: r.name,
              job: r.job,
              tmdb_person_id: r.tmdb_person_id,
            }));

          const counts = new Map();
          for (const r of crewRowsRaw) {
            const pid = String(r.person_id || "");
            if (!pid) continue;
            counts.set(pid, (counts.get(pid) || 0) + 1);
          }
          crewSync.duplicates_by_person = Array.from(counts.entries())
            .filter(([, c]) => c > 1)
            .slice(0, 50)
            .map(([person_id, count]) => ({ person_id, count }));

          const { error: delErr } = await supabaseAdmin
            .from("Movie Crew")
            .delete()
            .eq("movie_id", movie_row_id_value);

          if (delErr) {
            crewSync.error = `Failed to clear Movie Crew: ${delErr.message}`;
          } else if (crewRows.length > 0) {
            const insErr = await tryInsertMovieCrew(crewRows);
            if (insErr) crewSync.error = `Failed to insert Movie Crew: ${insErr.message}`;
            else crewSync.inserted = crewRows.length;
          }
        } catch (e) {
          crewSync.error = `Movie Crew sync crashed: ${String(e?.message ?? e)}`;
        }
      }

      return {
        ok: true,
        requested: people.length,
        inserted: newRows.length,
        skipped: people.length - newRows.length,
        table: tableName,
        roles: { cast: topCast.length, directors: directors.length, writers: writers.length, composers: composers.length },
        cast_sync: castSync,
        crew_sync: crewSync,
      };
    };

    let movieData = null;
    let tmdb_id = null;
    let tmdbGenres = [];
    let tmdbGenreIds = new Set();
    let tmdbGenreNames = new Set();

    if (movie_uuid) {
      const { data: m, error: mErr } = await supabaseAdmin
        .from("Movies")
        .select("id, tmdb_id, title, release_year, runtime_minutes, mpa_rating, is_series, imdb_id, poster_path")
        .eq("id", movie_uuid)
        .single();

      if (mErr) {
        return jsonResponse(
          { code: 404, message: "Movie not found.", details: mErr.message },
          404,
        );
      }

      movieData = m;
      tmdb_id = Number(m?.tmdb_id);
      if (!Number.isFinite(tmdb_id) || tmdb_id <= 0) {
        return jsonResponse(
          {
            code: 400,
            message: "Movie is missing tmdb_id, cannot sync cast.",
          },
          400,
        );
      }

      // Failsafe: if this existing movie is missing poster_path, try to repair it now.
      if (!String(movieData?.poster_path ?? "").trim()) {
        try {
          await tryRepairPosterPathByTmdbId({
            supabaseAdmin,
            tmdbId: tmdb_id,
            tmdbReadAccessToken: TMDB_READ_ACCESS_TOKEN,
            timeoutMs: 1200,
          });
        } catch (_) {
          // Best-effort only.
        }
      }

      // Failsafe: if this existing movie is missing any detail TMDb couldn't supply
      // (MPA for foreign films, year, runtime, series flag) and the client supplied a
      // value, persist it. Only fills a BLANK column — never overwrites real data — so
      // the first user to fill a gap shares it with everyone, and nobody's value gets
      // clobbered. (Genre/IMDb live in their own tables and are handled separately.)
      const detailFix = {};
      if (mpaOverride && !String(movieData?.mpa_rating ?? "").trim()) detailFix.mpa_rating = mpaOverride;
      if (yearOverride !== null && !(Number(movieData?.release_year) > 0)) detailFix.release_year = yearOverride;
      if (runtimeOverride !== null && !(Number(movieData?.runtime_minutes) > 0)) detailFix.runtime_minutes = runtimeOverride;
      // is_series has no "blank" — only set it if the stored value is null/undefined.
      if (seriesOverride !== null && (movieData?.is_series === null || movieData?.is_series === undefined)) {
        detailFix.is_series = seriesOverride;
      }
      if (Object.keys(detailFix).length > 0) {
        try {
          const { data: fixedMovie, error: fixErr } = await supabaseAdmin
            .from("Movies")
            .update(detailFix)
            .eq("id", movie_uuid)
            .select("id, tmdb_id, title, release_year, runtime_minutes, mpa_rating, is_series, imdb_id, poster_path")
            .single();
          if (!fixErr && fixedMovie) movieData = fixedMovie;
        } catch (_) {
          // Best-effort only.
        }
      }

      // Genre failsafe: if this existing movie has NO genres yet and the client
      // supplied some, populate "Movie Genres" from the override (matched against the
      // existing Genres table by name). Only fills when empty — never replaces.
      if (genreOverride.length > 0) {
        try {
          const { count: existingGenreCount } = await supabaseAdmin
            .from("Movie Genres")
            .select("movie_id", { count: "exact", head: true })
            .eq("movie_id", movie_uuid);
          if (!existingGenreCount) {
            for (const gName of genreOverride) tmdbGenreNames.add(gName);
          }
        } catch (_) {
          // Best-effort only.
        }
      }
    }

    // If no movie_id was provided, do TMDb search by title (+ optional year)
    // and upsert into Movies.
    if (!movieData) {
    const searchUrl = new URL("https://api.themoviedb.org/3/search/movie");
    searchUrl.searchParams.set("query", title);
    searchUrl.searchParams.set("include_adult", "false");
    searchUrl.searchParams.set("language", "en-US");
    searchUrl.searchParams.set("page", "1");
    if (release_year) searchUrl.searchParams.set("year", String(release_year));

    const searchRes = await fetch(searchUrl.toString(), {
      headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
    });

    if (!searchRes.ok) {
      const details = await searchRes.text();
      return jsonResponse({ code: 400, message: "TMDb search failed.", details }, 400);
    }

    const searchJson = await searchRes.json();
    const best = pickBestSearchResult(searchJson?.results ?? [], release_year);
    if (!best?.id) {
      return jsonResponse({ code: 404, message: "No TMDb match found." }, 404);
    }

    tmdb_id = Number(best.id);

    // TMDb details to get runtime/title/release date
    const detailsUrl = new URL(`https://api.themoviedb.org/3/movie/${tmdb_id}`);
    detailsUrl.searchParams.set("language", "en-US");
    detailsUrl.searchParams.set("append_to_response", "keywords");

    // TMDb release_dates to get US certification (MPA rating)
    const releaseDatesUrl = new URL(
      `https://api.themoviedb.org/3/movie/${tmdb_id}/release_dates`,
    );

    // TMDb external_ids to get IMDb ID
    const externalIdsUrl = new URL(
      `https://api.themoviedb.org/3/movie/${tmdb_id}/external_ids`,
    );

    const tmdbHeaders = { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` };

    const [detailsRes, releaseDatesRes, externalIdsRes] = await Promise.all([
      fetch(detailsUrl.toString(), { headers: tmdbHeaders }),
      fetch(releaseDatesUrl.toString(), { headers: tmdbHeaders }),
      fetch(externalIdsUrl.toString(), { headers: tmdbHeaders }),
    ]);

    if (!detailsRes.ok) {
      const details = await detailsRes.text();
      return jsonResponse({ code: 400, message: "TMDb details fetch failed.", details }, 400);
    }

    const detailsJson = await detailsRes.json();
    let runtime_minutes = Number(detailsJson?.runtime ?? 0);
    if (!Number.isFinite(runtime_minutes) || runtime_minutes <= 0) {
      // TMDb has no runtime — fall back to the user's manually-entered value rather
      // than refusing to create the movie. (Only blocks if neither source has one.)
      if (runtimeOverride !== null) {
        runtime_minutes = runtimeOverride;
      } else {
        return jsonResponse({ code: 404, message: "TMDb did not return a usable runtime." }, 404);
      }
    }

    const tmdbTitle = String(detailsJson?.title ?? best?.title ?? title).trim();
    let tmdbReleaseYear = detailsJson?.release_date
      ? Number(String(detailsJson.release_date).slice(0, 4))
      : (release_year ?? null);
    if (!(Number(tmdbReleaseYear) > 0) && yearOverride !== null) {
      tmdbReleaseYear = yearOverride;
    }

    const tmdbReleaseDate = detailsJson?.release_date
      ? String(detailsJson.release_date)
      : null;

    let mpa_rating = null;
    if (releaseDatesRes.ok) {
      const releaseDatesJson = await releaseDatesRes.json();
      const us = (releaseDatesJson?.results ?? []).find((r) => r?.iso_3166_1 === "US");
      const dates = us?.release_dates ?? [];

      // Prefer theatrical-ish types if present: 3=Theatrical (limited), 2=Theatrical
      const preferredTypes = new Set([3, 2]);
      const preferred = dates.find((d) => d?.certification && preferredTypes.has(Number(d.type)));
      const anyCert = dates.find((d) => d?.certification);

      mpa_rating = String((preferred?.certification ?? anyCert?.certification ?? "").trim() || "") || null;
    }

    // If TMDb has no US certification, fall back to the client-provided MPA override.
    if (!mpa_rating && mpaOverride) {
      mpa_rating = mpaOverride;
    }

    let imdb_id = null;
    if (externalIdsRes.ok) {
      const externalIdsJson = await externalIdsRes.json();
      const raw = String(externalIdsJson?.imdb_id ?? "").trim();
      imdb_id = raw ? raw : null;
    }

    // TMDb genres (prefer details endpoint which includes names)
    tmdbGenres = Array.isArray(detailsJson?.genres) ? detailsJson.genres : [];
    tmdbGenreIds = new Set(
      tmdbGenres
        .map((g) => Number(g?.id))
        .filter((n) => Number.isFinite(n) && n > 0),
    );
    tmdbGenreNames = new Set(
      tmdbGenres
        .map((g) => String(g?.name ?? "").trim())
        .filter(Boolean),
    );

    // If TMDb returned no genres, fall back to the user's manually-selected genres so
    // they get persisted to "Movie Genres" (matched by name) and shared with everyone.
    if (tmdbGenreNames.size === 0 && genreOverride.length > 0) {
      for (const gName of genreOverride) tmdbGenreNames.add(gName);
    }

    // is_series: TMDb's belongs_to_collection is a weak proxy, so let the user's
    // explicit answer win when they provided one.
    const is_series_value = seriesOverride !== null
      ? seriesOverride
      : Boolean(detailsJson?.belongs_to_collection);

    // Requires a UNIQUE constraint on Movies.tmdb_id for onConflict to work cleanly
    const poster_path_raw = String(detailsJson?.poster_path ?? best?.poster_path ?? "").trim();
    const poster_path = poster_path_raw
      ? (poster_path_raw.startsWith("/") ? poster_path_raw : `/${poster_path_raw}`)
      : null;

    const movieRow = {
      tmdb_id,
      title: tmdbTitle,
      release_year: tmdbReleaseYear,
      runtime_minutes,
      mpa_rating,
      is_series: is_series_value,
      imdb_id,
      poster_path,
      // Optional convenience field if you have it in your schema; safe to remove if not.
      // release_date: tmdbReleaseDate,
    };

    const { data: upsertedMovie, error: upsertErr } = await supabaseAdmin
      .from("Movies")
      .upsert(movieRow, { onConflict: "tmdb_id" })
      .select("id, tmdb_id, title, release_year, runtime_minutes, mpa_rating, imdb_id, poster_path")
      .single();

    if (upsertErr) {
      return jsonResponse(
        {
          code: 400,
          message: upsertErr.message,
          hint: "Add a UNIQUE constraint on public.\"Movies\"(tmdb_id) if missing.",
        },
        400,
      );
    }

    // Assign for downstream.
    movieData = upsertedMovie;
    }

    // Fetch + persist external IMDb rating (best-effort; should not block rating logs).
    const external_ratings = {
      imdb: { ok: false, pct: null, error: null },
    };

    try {
      const imdb_id = String(movieData?.imdb_id ?? "").trim() || null;
      const titleForOmdb = String(movieData?.title ?? title ?? "").trim();
      const yearForOmdb = movieData?.release_year ?? release_year ?? null;

      const r = await fetchOmdbImdbRatingPercent({
        imdb_id,
        title: titleForOmdb,
        year: yearForOmdb,
        omdbApiKey: OMDB_API_KEY,
      });

      external_ratings.imdb.pct = r?.pct ?? null;
      external_ratings.imdb.ok = Boolean(r?.ok) && r?.pct !== null;
      external_ratings.imdb.error = external_ratings.imdb.ok ? null : (r?.reason ?? null);

      // OMDb had no rating, but the user supplied one manually — fall back to it,
      // but ONLY if nothing is already stored (never overwrite a real value).
      if (!external_ratings.imdb.ok && imdbOverride !== null && movieData?.id) {
        const { data: existingExt } = await supabaseAdmin
          .from("Movie External Ratings")
          .select("rating")
          .eq("movie_id", movieData.id)
          .eq("source", "imdb")
          .maybeSingle();
        const existing = Number(existingExt?.rating);
        if (!(Number.isFinite(existing) && existing > 0)) {
          external_ratings.imdb.pct = imdbOverride;
          external_ratings.imdb.ok = true;
          external_ratings.imdb.error = null;
          external_ratings.imdb.source = "manual";
        }
      }

      if (external_ratings.imdb.ok && movieData?.id) {
        const row = {
          movie_id: movieData.id,
          source: "imdb",
          rating: external_ratings.imdb.pct,
          fetched_at: new Date().toISOString(),
        };
        // IMDb vote count comes from the same OMDb call. Only set it when real +
        // positive so a manual-rating save (no votes) doesn't null out a stored value.
        if (Number(r?.votes) > 0) {
          row.votes = Math.round(Number(r.votes));
          external_ratings.imdb.votes = row.votes;
        }

        const { error: upsertErr } = await supabaseAdmin
          .from("Movie External Ratings")
          .upsert(row, { onConflict: "movie_id,source" });

        if (upsertErr) {
          external_ratings.imdb.ok = false;
          external_ratings.imdb.error = `DB upsert failed: ${upsertErr.message}`;
        }
      }
    } catch (e) {
      external_ratings.imdb.ok = false;
      external_ratings.imdb.error = `External rating sync crashed: ${String(e?.message ?? e)}`;
    }

    // Sync Movie Genres join table (one row per TMDb genre)
    // Tables:
    // - "Genres" (id, name)
    // - "Movie Genres" (movie_id FK -> Movies, genre_id FK -> Genres)
    // This uses service role, so it bypasses RLS (server-side only).
    // IMPORTANT: This should not block saving a Movie; failures are returned as a warning.
    const movie_row_id = movieData?.id;
    const genreSync = {
      requested: tmdbGenres.length,
      matched: 0,
      inserted: 0,
      error: null,
    };

    if (movie_row_id && (tmdbGenreIds.size > 0 || tmdbGenreNames.size > 0)) {
      const { data: allGenres, error: genresErr } = await supabaseAdmin
        .from("Genres")
        .select("id, name");

      if (genresErr) {
        genreSync.error = `Failed to load Genres: ${genresErr.message}`;
      } else {
        const byLowerName = new Map();
        for (const g of allGenres ?? []) {
          const name = String(g?.name ?? "").trim();
          if (!name) continue;
          byLowerName.set(name.toLowerCase(), g?.id);
        }

        // Prefer matching by TMDb genre id if your Genres.id uses TMDb ids.
        // If not, fall back to matching by genre name (Genres.name).
        const matchedGenreIds = new Set();
        for (const gid of tmdbGenreIds) {
          const hit = (allGenres ?? []).find((g) => Number(g?.id) === gid);
          if (hit?.id !== undefined && hit?.id !== null) matchedGenreIds.add(hit.id);
        }
        if (matchedGenreIds.size === 0) {
          for (const name of tmdbGenreNames) {
            const id = byLowerName.get(String(name).toLowerCase());
            if (id !== undefined && id !== null) matchedGenreIds.add(id);
          }
        }
        genreSync.matched = matchedGenreIds.size;

        // Refresh rows for this movie_id (idempotent without requiring a UNIQUE constraint)
        const { error: delErr } = await supabaseAdmin
          .from("Movie Genres")
          .delete()
          .eq("movie_id", movie_row_id);

        if (delErr) {
          genreSync.error = `Failed to clear Movie Genres: ${delErr.message}`;
        } else {
          const joinRows = Array.from(matchedGenreIds).map((genre_id) => ({
            movie_id: movie_row_id,
            genre_id,
          }));

          if (joinRows.length > 0) {
            const { error: insErr } = await supabaseAdmin
              .from("Movie Genres")
              .insert(joinRows);

            if (insErr) {
              genreSync.error = `Failed to insert Movie Genres: ${insErr.message}`;
            } else {
              genreSync.inserted = joinRows.length;
            }
          }
        }
      }
    }

    // Sync TMDB keywords -> Keywords + Movie Keywords join (best-effort, theme-level
    // taste signal). Lets syncMovieKeywords fetch keywords itself (passing null) so
    // this works on BOTH save paths — the create-from-title path AND the re-sync of an
    // existing movie (movie_id), where the `detailsJson` from a fresh details fetch
    // doesn't exist in scope.
    const keywordSync = { ok: false, count: 0, error: null };
    if (movie_row_id && Number.isFinite(Number(tmdb_id)) && Number(tmdb_id) > 0) {
      const r = await syncMovieKeywords(
        supabaseAdmin,
        { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
        movie_row_id,
        tmdb_id,
        null,
      );
      keywordSync.ok = Boolean(r?.ok);
      keywordSync.count = Number(r?.count ?? 0) || 0;
      keywordSync.error = r?.error ?? null;
    }

    // Sync watch providers -> Platforms + Movie Platforms (best-effort).
    // IMPORTANT: This must not block the core save flow.
    const platformSync = {
      region: "US",
      requested: 0,
      created_platforms: 0,
      linked: 0,
      error: null,
    };

    if (movieData?.id && Number.isFinite(Number(tmdb_id)) && Number(tmdb_id) > 0) {
      const watchRegionRaw = body?.watch_region ?? body?.region ?? "US";
      const watchRegion = String(watchRegionRaw || "US").trim().toUpperCase() || "US";
      try {
        const r = await syncMovieWatchPlatforms({
          supabaseAdmin,
          movie_id: movieData.id,
          tmdb_id,
          tmdbReadAccessToken: TMDB_READ_ACCESS_TOKEN,
          region: watchRegion,
          timeoutMs: 1400,
        });
        platformSync.region = r?.region ?? watchRegion;
        platformSync.requested = Number(r?.requested ?? 0) || 0;
        platformSync.created_platforms = Number(r?.created_platforms ?? 0) || 0;
        platformSync.linked = Number(r?.linked ?? 0) || 0;
        platformSync.error = r?.error ?? null;
      } catch (e) {
        platformSync.error = `Platform sync crashed: ${String(e?.message ?? e)}`;
      }
    }

    // Optional: sync top-billed cast into People when requested.
    // IMPORTANT: People sync must not break the core "log rating" flow.
    // If it fails, we return `people_sync.ok=false` but still return HTTP 200.
    let people_sync = null;
    if (sync_people) {
      const peopleResult = await insertPeopleFromCredits(tmdb_id, movieData?.id || null);
      if (!peopleResult?.ok) {
        people_sync = {
          ok: false,
          message: peopleResult?.message || "People sync failed.",
          details: peopleResult?.details || null,
          table: peopleResult?.table || PEOPLE_TABLE,
        };
      } else {
        const warnings = [peopleResult?.cast_sync?.error, peopleResult?.crew_sync?.error].filter(Boolean);
        people_sync = {
          ok: warnings.length === 0,
          message: warnings.length ? "People sync completed with warnings." : null,
          details: warnings.length ? warnings.join(" | ") : null,
          requested: peopleResult.requested,
          inserted: peopleResult.inserted,
          skipped: peopleResult.skipped,
          table: peopleResult.table,
          roles: peopleResult.roles || null,
          cast_sync: peopleResult.cast_sync || null,
          crew_sync: peopleResult.crew_sync || null,
        };
      }
    }

    return jsonResponse({
      movie_id: movieData.id,
      tmdb_id: movieData.tmdb_id,
      title: movieData.title,
      release_year: movieData.release_year,
      runtime_minutes: movieData.runtime_minutes,
      mpa_rating: movieData.mpa_rating,
      imdb_id: movieData.imdb_id,
      genre_sync: genreSync,
      keyword_sync: keywordSync,
      platform_sync: platformSync,
      imdb_rating_pct: external_ratings?.imdb?.pct ?? null,
      external_ratings,
      ...(people_sync ? { people_sync } : {}),
      source: "tmdb",
    });
  } catch (e) {
    return jsonResponse({ code: 500, message: String(e?.message ?? e) }, 500);
  }
});