      const parserSystem =
        "You are a TMDb discovery query compiler. Convert the user's intent into the best possible discovery strategy while strictly honoring constraints.\n\n" +
        "PRIMARY INTENT (CORE SIGNAL)\n" +
        "Use the prompt field in the provided JSON as the creative source of truth. " +
        "Treat it as the signal for tone, vibe, themes, era, and comparisons.\n\n" +
        "OPTIONAL CONTEXT\n" +
        "If similar_movie data is provided, use it only to clarify tone or themes, not to invent constraints.\n\n" +
        "FILTER HANDLING (HARD CONSTRAINTS)\n" +
        "Strictly respect all user filters from the filters field. These are non-negotiable. " +
        "tmdb_rating_min is 0-100 (percent). Use genres by name (e.g., Comedy, Drama). " +
        "Defaults: treat 0 or empty values as unset. If a filter is set, carry it through unchanged.\n\n" +
        "STRATEGY RULES\n" +
        "- Optimize for recall over precision; goal is a strong candidate pool.\n" +
        "- When intent is ambiguous, choose broader strategies.\n" +
        "- Favor diversity within allowed constraints (genre-adjacent, era-adjacent, tone-adjacent).\n" +
        "- Do not use or request keyword-based filters. The system does not use TMDb keywords.\n" +
        "- If user_runtime_context is false and taste_profile_query.preferred_runtime_bin is provided, you may use it to set a soft runtime range.\n" +
        "- If user_year_context is false and taste_profile_query.preferred_decade is provided, you may use it to set release year bounds.\n" +
        "- If watch providers are not specified, include all known providers.\n" +
        "- If a constraint is not explicitly mentioned, set that field to 0. If no watch_region is specified, set it to empty string.\n" +
        "- Always include at least one genre (use the user's choices if provided; otherwise infer from the prompt).\n\n" +
        "PROHIBITIONS\n" +
        "- Do not rank or recommend specific films.\n" +
        "- Do not judge quality, awards, or cultural impact.\n" +
        "- Do not invent metadata or constraints.\n\n" +
        "RELIABILITY MINDSET\n" +
        "You are a query compiler, not a recommender. When unsure, include rather than exclude.";

      const promptHasRuntime = /\b(\d{2,3})\s*(min|mins|minutes|hr|hrs|hour|hours)\b|\b(short|long)\b/i.test(prompt);
      const promptHasYear = /\b(19\d{2}|20\d{2})\b/.test(prompt);
      const filterHasYear = Number(filters?.release_year_from ?? 0) > 0 || Number(filters?.release_year_to ?? 0) > 0;

      const parserUser = JSON.stringify({
        prompt,
        filters,
        similar_movie: similarMovies,
        user_runtime_context: promptHasRuntime,
        user_year_context: promptHasYear || filterHasYear,
        taste_profile_query: tasteProfile?.taste_profile_query || {},
      });

      let parsed = null;
      try {
        parsed = await callAnthropicJson({
          apiKey: ANTHROPIC_API_KEY,
          model: ANTHROPIC_MODEL_QUERY,
          schemaName: "tmdb_query_json",
          schema: parserSchema,
          system: parserSystem,
          user: parserUser,
        });
      } catch (err) {
        return jsonResponse(
          {
            code: 502,
            message: `Anthropic parse failed: ${String(err?.message || err)}`,
            debug: debugEnabled
              ? {
                  parser_request: safeJsonParse(parserUser),
                }
              : null,
          },
          502,
        );
      }

      const criteria = parsed?.criteria && typeof parsed.criteria === "object" ? parsed.criteria : {};
      const tasteHints = Array.isArray(parsed?.taste_hints) ? parsed.taste_hints : [];
      const tmdbHeaders = { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` };

      const includeNamesFromInputs = uniqStrings([
        ...(Array.isArray(criteria.genres_include) ? criteria.genres_include : []),
        ...(Array.isArray(filters.genres_include) ? filters.genres_include : []),
      ]);

      let similarMovieGenres = [];
      let similarMovieYears = [];
      let similarMovieVotes = [];
      let similarMovieIds = [];

      if (similarMovies.length > 0) {
        const ids = similarMovies
          .map((m) => Number(m?.tmdb_id))
          .filter((id) => Number.isFinite(id) && id > 0)
          .slice(0, 5);
        similarMovieIds = ids;

        const details = await mapWithConcurrency(ids, 3, async (id) => {
          try {
            const simUrl = new URL(`https://api.themoviedb.org/3/movie/${Number(id)}`);
            const simRes = await fetch(simUrl.toString(), { headers: tmdbHeaders });
            if (!simRes.ok) return null;
            return await simRes.json().catch(() => null);
          } catch (_) {
            return null;
          }
        });

        const genreNames = [];
        const years = [];
        const votes = [];
        for (const simJson of details) {
          if (!simJson) continue;
          const g = Array.isArray(simJson?.genres)
            ? simJson.genres.map((x) => String(x?.name || '').trim()).filter(Boolean)
            : [];
          genreNames.push(...g);
          const y = extractTmdbYearFromReleaseDate(simJson?.release_date);
          if (Number.isFinite(y)) years.push(y);
          const v = Number(simJson?.vote_average ?? null);
          if (Number.isFinite(v)) votes.push(v);
        }

        similarMovieGenres = uniqStrings(genreNames);
        similarMovieYears = years;
        similarMovieVotes = votes;
      }

      const inferredGenres = includeNamesFromInputs.length
        ? []
        : (similarMovieGenres.length ? similarMovieGenres : inferGenresFromPrompt(prompt));
      const includeNames = uniqStrings([
        ...includeNamesFromInputs,
        ...inferredGenres,
      ]);

      if (includeNames.length === 0) includeNames.push("Drama");

      const providerNamesFromInputs = uniqStrings([
        ...(Array.isArray(criteria.watch_providers) ? criteria.watch_providers : []),
        ...(Array.isArray(filters.watch_providers) ? filters.watch_providers : []),
      ]);
      const providerNames = providerNamesFromInputs.length
        ? providerNamesFromInputs
        : DEFAULT_WATCH_PROVIDER_NAMES.slice();

      const watchRegionRaw =
        (typeof criteria.watch_region === "string" ? criteria.watch_region : null)
        || (typeof filters.watch_region === "string" ? filters.watch_region : null)
        || "US";
      const watchRegion = String(watchRegionRaw || "US").trim().toUpperCase() || "US";

      const yearFrom = Number(criteria.release_year_from ?? null);
      const yearTo = Number(criteria.release_year_to ?? null);
      const filterYearFrom = Number(filters.release_year_from ?? null);
      const filterYearTo = Number(filters.release_year_to ?? null);

      const mergedYearFrom = [yearFrom, filterYearFrom].filter((v) => Number.isFinite(v) && v > 1800);
      const mergedYearTo = [yearTo, filterYearTo].filter((v) => Number.isFinite(v) && v > 1800);
      let finalYearFrom = mergedYearFrom.length ? Math.max(...mergedYearFrom) : null;
      let finalYearTo = mergedYearTo.length ? Math.min(...mergedYearTo) : null;

      if (!finalYearFrom && !finalYearTo && similarMovieYears.length > 0) {
        const ranges = similarMovieYears
          .filter((y) => Number.isFinite(y))
          .map((y) => inferYearRangeFromSimilarMovie(y));
        const froms = ranges.map((r) => r.from).filter((v) => Number.isFinite(v));
        const tos = ranges.map((r) => r.to).filter((v) => Number.isFinite(v));
        finalYearFrom = froms.length ? Math.min(...froms) : null;
        finalYearTo = tos.length ? Math.max(...tos) : null;
      }

      if (finalYearFrom && finalYearTo && finalYearFrom > finalYearTo) {
        const tmp = finalYearFrom;
        finalYearFrom = finalYearTo;
        finalYearTo = tmp;
      }

      const ratingFromCriteria = Number(criteria.tmdb_rating_min ?? null);
      const ratingFromFilter = Number(filters.tmdb_rating_min ?? null);
      const ratingCandidates = [ratingFromCriteria, ratingFromFilter].filter((v) => Number.isFinite(v));
      let ratingMinPct = ratingCandidates.length ? Math.max(...ratingCandidates) : null;
      if (!Number.isFinite(ratingMinPct) || ratingMinPct <= 0) ratingMinPct = null;

      // NOTE: Do not auto-derive a minimum rating from similar movies; it over-filters results.

      const hasRuntimeHint = promptMentionsRuntime(prompt);
      const runtimeMin = hasRuntimeHint && Number.isFinite(Number(criteria.runtime_min))
        ? Number(criteria.runtime_min)
        : null;
      const runtimeMax = hasRuntimeHint && Number.isFinite(Number(criteria.runtime_max))
        ? Number(criteria.runtime_max)
        : null;

      const includeIds = mapGenreNamesToIds(includeNames);
      const providerIds = mapProviderNamesToIds(providerNames);
      const candidates = [];

      let watchedTmdbIds = null;
      if (filters?.exclude_watched) {
        try {
          watchedTmdbIds = await fetchWatchedTmdbIds(supabaseAdmin, userData.user.id);
        } catch (_) {
          watchedTmdbIds = null;
        }
      }

      const excludeTmdbIds = new Set(similarMovieIds.map((id) => Number(id)).filter((id) => Number.isFinite(id) && id > 0));

      for (let page = 1; page <= 10 && candidates.length < 200; page += 1) {
        const url = new URL("https://api.themoviedb.org/3/discover/movie");
        url.searchParams.set("include_adult", "false");
        url.searchParams.set("page", String(page));
        url.searchParams.set("sort_by", "popularity.desc");
        if (includeIds.length) url.searchParams.set("with_genres", includeIds.join("|"));
        if (finalYearFrom) url.searchParams.set("primary_release_date.gte", `${finalYearFrom}-01-01`);
        if (finalYearTo) url.searchParams.set("primary_release_date.lte", `${finalYearTo}-12-31`);
        if (Number.isFinite(runtimeMin)) url.searchParams.set("with_runtime.gte", String(Math.max(0, Math.floor(runtimeMin))));
        if (Number.isFinite(runtimeMax)) url.searchParams.set("with_runtime.lte", String(Math.max(0, Math.floor(runtimeMax))));
        if (Number.isFinite(ratingMinPct)) {
          const voteAvg = Math.max(0, Math.min(10, ratingMinPct / 10));
          url.searchParams.set("vote_average.gte", String(voteAvg.toFixed(1)));
        }
        if (providerIds.length > 0) {
          url.searchParams.set("watch_region", watchRegion);
          url.searchParams.set("with_watch_providers", providerIds.join("|"));
        }

        const res = await fetch(url.toString(), { headers: tmdbHeaders });
        if (!res.ok) {
          const details = await res.text().catch(() => "");
          return jsonResponse(
            { code: 502, message: "TMDb discover failed.", details: `HTTP ${res.status}${details ? `: ${details}` : ""}` },
            502,
          );
        }

        const json = await res.json().catch(() => null);
        const results = Array.isArray(json?.results) ? json.results : [];

        for (const r of results) {
          if (candidates.length >= 200) break;
          const id = Number(r?.id);
          const title = String(r?.title ?? "").trim();
          if (!Number.isFinite(id) || !title) continue;
          if (excludeTmdbIds.has(id)) continue;
          if (watchedTmdbIds && watchedTmdbIds.has(id)) continue;
          const year = r?.release_date ? Number(String(r.release_date).slice(0, 4)) : null;
          const ids = Array.isArray(r?.genre_ids) ? r.genre_ids : [];
          const genres = uniqStrings(ids.map((gid) => TMDB_MOVIE_GENRES[Number(gid)]).filter(Boolean));
          candidates.push({
            tmdb_id: id,
            title,
            year: Number.isFinite(year) ? year : null,
            genres,
            vote_average: Number(r?.vote_average ?? 0) || 0,
            overview: String(r?.overview ?? "").trim(),
          });
        }
      }

      const debugPayload = debugEnabled
        ? {
            parser_request: safeJsonParse(parserUser),
            parser_response: parsed,
            parsed_criteria: criteria,
            taste_hints: tasteHints,
            candidates,
            candidates_count: candidates.length,
          }
        : null;

      if (candidates.length === 0) {
        return jsonResponse({ top10: [], debug: debugPayload }, 200);
      }

      const desiredCount = Math.min(10, candidates.length);
      const rerankSchema = {
        type: "object",
        additionalProperties: false,
        required: ["top10"],
        properties: {
          top10: {
            type: "array",
            minItems: desiredCount,
            maxItems: desiredCount,
            items: {
              type: "object",
              additionalProperties: false,
              required: ["tmdb_id", "title", "year", "reason"],
              properties: {
                tmdb_id: { type: "integer" },
                title: { type: "string" },
                year: { type: "integer" },
                reason: { type: "string" },
              },
            },
          },
        },
      };

      const rerankSystem =
        "You are a movie ranking specialist. Rank and explain the candidate results using only the inputs provided to you. Do not introduce any new constraints.\n\n" +
        "PRIMARY INTENT (CORE SIGNAL)\n" +
        "Base your understanding of the user's creative intent primarily on the prompt field in the provided JSON. " +
        "Treat it as the signal for tone, vibe, themes, era, and comparisons.\n\n" +
        "AVAILABLE CONTEXT\n" +
        "Use only the prompt, taste_hints, taste_profile_rerank, and candidates from the provided JSON. " +
        "Assume candidates already satisfy all user filters. " +
        "Do not expect or reference keyword fields; none are provided. " +
        "Taste profile rerank context may be provided (imdb_delta, subrating_weights, people_affinity); use these only as tie-breakers.\n\n" +
        "RANKING PRINCIPLES\n" +
        "- Optimize for alignment with the prompt's vibe and themes.\n" +
        "- Use any provided soft preferences only as tie-breakers, not hard filters.\n" +
        "- Maintain variety while respecting the prompt; avoid redundant picks.\n" +
        "- Do not rank purely by popularity or ratings.\n" +
        "- Only choose from the provided candidates and always keep each candidate's tmdb_id/title/year exactly as given.\n\n" +
        "EXPLANATIONS (REASONS)\n" +
        "Each ranked item should include a concise, user-facing reason (2-4 sentences) covering: " +
        "(1) why it matches the prompt/filters, and (2) why it aligns with the user's taste profile if provided. " +
        "Avoid claims about awards, cultural impact, or production trivia unless explicitly indicated by the prompt or provided metadata.\n\n" +
        "PROHIBITIONS\n" +
        "- Do not invent metadata.\n" +
        "- Do not introduce new constraints.\n" +
        "- Do not judge quality beyond alignment with intent.\n" +
        "- Do not mention internal system logic or tool limitations.\n\n" +
        "RELIABILITY MINDSET\n" +
        "You are a ranker, not a query builder. Use evidence from provided inputs only. " +
        "When unsure, keep the justification general and grounded in the prompt.";
      const rerankUser = JSON.stringify({ prompt, taste_hints: tasteHints, taste_profile_rerank: tasteProfile?.taste_profile_rerank || {}, candidates });

      try {
        const reranked = await callAnthropicJsonWithSearch({
          apiKey: ANTHROPIC_API_KEY,
          model: ANTHROPIC_MODEL_RERANK,
          schemaName: "ai_top10_json",
          schema: rerankSchema,
          system: rerankSystem,
          user: rerankUser,
        });
        const top10Raw = Array.isArray(reranked?.top10) ? reranked.top10 : [];
        const candidatesById = new Map(candidates.map((c) => [Number(c.tmdb_id), c]));
        const candidatesByKey = new Map(candidates.map((c) => [
          `${String(c.title || "").toLowerCase()}|${Number(c.year) || ""}`,
          c,
        ]));

        const top10 = await mapWithConcurrency(top10Raw, 10, async (item) => {
          const rawId = Number(item?.tmdb_id);
          const key = `${String(item?.title || "").toLowerCase()}|${Number(item?.year) || ""}`;
          const candidate = (Number.isFinite(rawId) && rawId > 0 ? candidatesById.get(rawId) : null)
            || candidatesByKey.get(key)
            || null;
          if (!candidate) return item;

          const tmdbId = Number(candidate.tmdb_id);
          if (!Number.isFinite(tmdbId) || tmdbId <= 0) return item;

          try {
            const url = new URL(`https://api.themoviedb.org/3/movie/${tmdbId}`);
            url.searchParams.set("append_to_response", "release_dates");
            const res = await fetch(url.toString(), { headers: tmdbHeaders });
            if (!res.ok) return item;
            const json = await res.json().catch(() => null);
            const year = json?.release_date ? Number(String(json.release_date).slice(0, 4)) : null;
            const mpa = extractUsCertification(json?.release_dates);
            const poster = normalizePosterPath(json?.poster_path) || null;
            const voteAvg = Number(json?.vote_average ?? 0) || 0;
            return {
              ...item,
              tmdb_id: tmdbId,
              title: candidate.title || item?.title || "",
              year: Number.isFinite(year) ? year : candidate.year ?? item?.year ?? null,
              poster_path: poster,
              tmdb_rating: voteAvg,
              mpa_rating: mpa || "",
            };
          } catch (_) {
            return {
              ...item,
              tmdb_id: tmdbId,
              title: candidate.title || item?.title || "",
              year: candidate.year ?? item?.year ?? null,
            };
          }
        });

        if (debugPayload) {
          debugPayload.rerank_request = safeJsonParse(rerankUser);
          debugPayload.rerank_response = reranked;
          debugPayload.top10 = top10;
        }

        return jsonResponse({ top10, debug: debugPayload }, 200);
      } catch (err) {
        if (debugPayload) {
          debugPayload.rerank_request = safeJsonParse(rerankUser);
        }
        return jsonResponse(
          { code: 502, message: `Anthropic rerank failed: ${String(err?.message || err)}`, debug: debugPayload },
          502,
        );
      }
    }

    const title = String(body?.title ?? "").trim();
    const release_year =
      body?.release_year === null || body?.release_year === undefined
        ? null
        : Number(body.release_year);
    const movie_uuid = uuidLike(body?.movie_id) ? String(body.movie_id).trim() : null;
    const sync_people = Boolean(body?.sync_people);

    // Optional client-provided MPA rating. Used ONLY to fill a blank Movies.mpa_rating
    // (e.g. foreign films where TMDb has no US certification). Validated against the
    // allowed set so junk can't be written; never overwrites an existing TMDb value.
    const mpaOverride = (() => {
      const raw = String(body?.mpa ?? "").trim().toUpperCase();
      const allowed = new Set(["G", "PG", "PG-13", "R", "NC-17", "NR"]);
      return allowed.has(raw) ? raw : "";
    })();

    if (!movie_uuid && !title) {
      return jsonResponse(
        { code: 400, message: 'Missing "title" (or provide "movie_id").' },
        400,
      );
    }
    if (release_year !== null && !Number.isFinite(release_year)) {
      return jsonResponse({ code: 400, message: "release_year must be a number or null." }, 400);
    }

    // Write to Movies / read tmdb_id using service role (bypasses RLS safely on the server)

    const OMDB_API_KEY = Deno.env.get("OMDB_API_KEY");

    // Your schema uses a quoted, capitalized table name: "People".
    // Using lowercase "people" will fail with a PostgREST schema cache error.
    const PEOPLE_TABLE = "People";

    const insertPeopleFromCredits = async (tmdb_id_value, movie_row_id_value) => {
      const creditsUrl = new URL(
        `https://api.themoviedb.org/3/movie/${tmdb_id_value}/credits`,
      );
      creditsUrl.searchParams.set("language", "en-US");

      const creditsRes = await fetch(creditsUrl.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!creditsRes.ok) {
        const details = await creditsRes.text().catch(() => "");
        return {
          ok: false,
          message: "TMDb credits fetch failed.",
          details: `HTTP ${creditsRes.status}${details ? `: ${details}` : ""}`,
        };
      }

      const creditsJson = await creditsRes.json();

      const norm = (s) => String(s ?? "").trim().toLowerCase();
      const hasIdAndName = (p) => Number.isFinite(Number(p?.id)) && String(p?.name ?? "").trim();

      const cast = Array.isArray(creditsJson?.cast) ? creditsJson.cast : [];
      const topCast = cast
        .filter(hasIdAndName)
        .sort((a, b) => Number(a?.order ?? 9999) - Number(b?.order ?? 9999))
        .slice(0, 20)
        .map((p) => ({
          tmdb_person_id: Number(p.id),
          name: String(p.name).trim(),
          character: String(p?.character ?? "").trim() || null,
        }));

      const crew = Array.isArray(creditsJson?.crew) ? creditsJson.crew : [];

      const pickCrewByJobs = ({
        primary,
        fallback,
        max = 5,
      }) => {
        const normalized = crew
          .filter(hasIdAndName)
          .map((p) => ({
            id: Number(p.id),
            name: String(p.name).trim(),
            job: norm(p?.job),
            department: norm(p?.department),
          }));

        let hits = normalized.filter(primary);
        if (hits.length === 0 && fallback) hits = normalized.filter(fallback);

        // Preserve first-seen ordering (TMDb's crew array is usually already ordered meaningfully)
        const unique = [];
        const seen = new Set();
        for (const h of hits) {
          if (seen.has(h.id)) continue;
          seen.add(h.id);
          unique.push({ tmdb_person_id: h.id, name: h.name });
          if (unique.length >= max) break;
        }
        return unique;
      };

      // Directors
      const directors = pickCrewByJobs({
        primary: (p) => p.job === "director",
        fallback: (p) =>
          p.job.includes("director") &&
          !p.job.includes("assistant") &&
          !p.job.includes("second") &&
          !p.job.includes("third"),
        max: 5,
      });

      // Writers (job titles vary: Writer, Screenplay, Story, Teleplay, etc.)
      const writers = pickCrewByJobs({
        primary: (p) =>
          p.department === "writing" &&
          (p.job.includes("writer") ||
            p.job.includes("screenplay") ||
            p.job.includes("story") ||
            p.job.includes("teleplay")),
        fallback: (p) =>
          p.job.includes("writer") ||
          p.job.includes("screenplay") ||
          p.job.includes("story") ||
          p.job.includes("teleplay"),
        max: 10,
      });

      // Music composers (job titles vary: Original Music Composer, Composer, Music, Score, etc.)
      const composers = pickCrewByJobs({
        primary: (p) => p.job.includes("composer"),
        fallback: (p) =>
          (p.job.includes("music") && (p.job.includes("score") || p.job.includes("composer"))) ||
          p.job.includes("original music"),
        max: 5,
      });

      const tableName = PEOPLE_TABLE;

      // Combine cast + key crew roles, then de-dupe by tmdb_person_id.
      const combined = [...topCast, ...directors, ...writers, ...composers];
      const byId = new Map();
      for (const p of combined) {
        if (!Number.isFinite(Number(p?.tmdb_person_id))) continue;
        const id = Number(p.tmdb_person_id);
        if (!byId.has(id)) byId.set(id, { tmdb_person_id: id, name: String(p?.name ?? "").trim() });
      }
      const people = Array.from(byId.values()).filter((p) => p.tmdb_person_id && p.name);

      if (people.length === 0) {
        return {
          ok: true,
          requested: 0,
          inserted: 0,
          skipped: 0,
          table: tableName,
          roles: { cast: topCast.length, directors: directors.length, writers: writers.length, composers: composers.length },
        };
      }

      const ids = people.map((p) => p.tmdb_person_id);

      // Preselect existing ids (also returns UUID ids for join tables).
      const { data: existing, error: existingErr } = await supabaseAdmin
        .from(tableName)
        .select("id, tmdb_person_id")
        .in("tmdb_person_id", ids);

      if (existingErr) {
        return {
          ok: false,
          message: "Failed to check existing People rows.",
          details: existingErr.message,
          table: tableName,
        };
      }

      const existingSet = new Set(
        (existing ?? [])
          .map((r) => Number(r?.tmdb_person_id))
          .filter((n) => Number.isFinite(n)),
      );

      const newRows = people.filter((p) => !existingSet.has(p.tmdb_person_id));

      if (newRows.length > 0) {
        const { error: insErr } = await supabaseAdmin.from(tableName).insert(newRows);
        if (insErr) {
          return {
            ok: false,
            message: "Failed to insert People rows.",
            details: insErr.message,
            table: tableName,
          };
        }
      }

      // Fetch UUID ids for all involved tmdb_person_id values (for join tables).
      const { data: allPeopleRows, error: allPeopleErr } = await supabaseAdmin
        .from(tableName)
        .select("id, tmdb_person_id")
        .in("tmdb_person_id", ids);

      if (allPeopleErr) {
        return {
          ok: false,
          message: "Failed to load People ids after insert.",
          details: allPeopleErr.message,
          table: tableName,
        };
      }

      const tmdbToUuid = new Map();
      for (const r of allPeopleRows ?? []) {
        const tid = Number(r?.tmdb_person_id);
        if (!Number.isFinite(tid)) continue;
        if (r?.id) tmdbToUuid.set(tid, r.id);
      }

      const castSync = {
        requested: topCast.length,
        inserted: 0,
        error: null,
      };
      const crewSync = {
        requested: directors.length + writers.length + composers.length,
        inserted: 0,
        error: null,
        preview: [],
        duplicates_by_person: [],
      };

      const tryInsertMovieCast = async (rows) => {
        const { error } = await supabaseAdmin.from("Movie Cast").insert(rows);
        return error || null;
      };

      const tryInsertMovieCrew = async (rows) => {
        const { error } = await supabaseAdmin.from("Movie Crew").insert(rows);
        return error || null;
      };

      // Populate join tables if movie_row_id is available.
      if (movie_row_id_value) {
        // Movie Cast
        try {
          const castRows = topCast
            .map((p) => ({
              movie_id: movie_row_id_value,
              person_id: tmdbToUuid.get(Number(p.tmdb_person_id)) || null,
              character: p.character,
            }))
            .filter((r) => r.person_id);

          // Refresh rows for this movie_id (idempotent)
          const { error: delErr } = await supabaseAdmin
            .from("Movie Cast")
            .delete()
            .eq("movie_id", movie_row_id_value);

          if (delErr) {
            castSync.error = `Failed to clear Movie Cast: ${delErr.message}`;
          } else if (castRows.length > 0) {
            const insErr = await tryInsertMovieCast(castRows);
            if (insErr) castSync.error = `Failed to insert Movie Cast: ${insErr.message}`;
            else castSync.inserted = castRows.length;
          }
        } catch (e) {
          castSync.error = `Movie Cast sync crashed: ${String(e?.message ?? e)}`;
        }

        // Movie Crew
        try {
          const normalizeJob = (raw) => {
            const j = norm(raw);
            if (!j) return null;
            if (j === "director" || j.includes("director")) return "Director";
            if (j.includes("writer") || j.includes("screenplay") || j.includes("story") || j.includes("teleplay")) return "Writer";
            if (j.includes("composer") || j.includes("original music")) return "Composer";
            if (j.includes("music") && j.includes("score")) return "Composer";
            return null;
          };

          const crewSource = [
            ...directors.map((p) => ({ ...p, rawJob: "director" })),
            ...writers.map((p) => ({ ...p, rawJob: "writer" })),
            ...composers.map((p) => ({ ...p, rawJob: "composer" })),
          ];

          const crewRowsRaw = crewSource
            .map((p) => {
              const person_id = tmdbToUuid.get(Number(p.tmdb_person_id)) || null;
              const job = normalizeJob(p.rawJob) || null;
              return {
                movie_id: movie_row_id_value,
                person_id,
                job,
                name: String(p?.name ?? "").trim() || null,
                tmdb_person_id: Number(p?.tmdb_person_id) || null,
              };
            })
            .filter((r) => r.person_id && r.job);

          // Dedupe by person_id+job
          const seenCrew = new Set();
          const crewRows = [];
          for (const r of crewRowsRaw) {
            const key = `${r.person_id}|${r.job}`;
            if (seenCrew.has(key)) continue;
            seenCrew.add(key);
            crewRows.push({ movie_id: r.movie_id, person_id: r.person_id, job: r.job });
          }

          crewSync.preview = crewRowsRaw
            .slice(0, 50)
            .map((r) => ({
              movie_id: r.movie_id,
              person_id: r.person_id,
              name: r.name,
              job: r.job,
              tmdb_person_id: r.tmdb_person_id,
            }));

          const counts = new Map();
          for (const r of crewRowsRaw) {
            const pid = String(r.person_id || "");
            if (!pid) continue;
            counts.set(pid, (counts.get(pid) || 0) + 1);
          }
          crewSync.duplicates_by_person = Array.from(counts.entries())
            .filter(([, c]) => c > 1)
            .slice(0, 50)
            .map(([person_id, count]) => ({ person_id, count }));

          const { error: delErr } = await supabaseAdmin
            .from("Movie Crew")
            .delete()
            .eq("movie_id", movie_row_id_value);

          if (delErr) {
            crewSync.error = `Failed to clear Movie Crew: ${delErr.message}`;
          } else if (crewRows.length > 0) {
            const insErr = await tryInsertMovieCrew(crewRows);
            if (insErr) crewSync.error = `Failed to insert Movie Crew: ${insErr.message}`;
            else crewSync.inserted = crewRows.length;
          }
        } catch (e) {
          crewSync.error = `Movie Crew sync crashed: ${String(e?.message ?? e)}`;
        }
      }

      return {
        ok: true,
        requested: people.length,
        inserted: newRows.length,
        skipped: people.length - newRows.length,
        table: tableName,
        roles: { cast: topCast.length, directors: directors.length, writers: writers.length, composers: composers.length },
        cast_sync: castSync,
        crew_sync: crewSync,
      };
    };

    let movieData = null;
    let tmdb_id = null;
    let tmdbGenres = [];
    let tmdbGenreIds = new Set();
    let tmdbGenreNames = new Set();

    if (movie_uuid) {
      const { data: m, error: mErr } = await supabaseAdmin
        .from("Movies")
        .select("id, tmdb_id, title, release_year, runtime_minutes, mpa_rating, imdb_id, poster_path")
        .eq("id", movie_uuid)
        .single();

      if (mErr) {
        return jsonResponse(
          { code: 404, message: "Movie not found.", details: mErr.message },
          404,
        );
      }

      movieData = m;
      tmdb_id = Number(m?.tmdb_id);
      if (!Number.isFinite(tmdb_id) || tmdb_id <= 0) {
        return jsonResponse(
          {
            code: 400,
            message: "Movie is missing tmdb_id, cannot sync cast.",
          },
          400,
        );
      }

      // Failsafe: if this existing movie is missing poster_path, try to repair it now.
      if (!String(movieData?.poster_path ?? "").trim()) {
        try {
          await tryRepairPosterPathByTmdbId({
            supabaseAdmin,
            tmdbId: tmdb_id,
            tmdbReadAccessToken: TMDB_READ_ACCESS_TOKEN,
            timeoutMs: 1200,
          });
        } catch (_) {
          // Best-effort only.
        }
      }

      // Failsafe: if this existing movie has no MPA rating (e.g. TMDb has no US
      // certification) and the client supplied a valid one, persist the user's value.
      // Only fills a blank — never overwrites an existing rating.
      if (mpaOverride && !String(movieData?.mpa_rating ?? "").trim()) {
        try {
          const { data: fixedMovie, error: fixMpaErr } = await supabaseAdmin
            .from("Movies")
            .update({ mpa_rating: mpaOverride })
            .eq("id", movie_uuid)
            .select("id, tmdb_id, title, release_year, runtime_minutes, mpa_rating, imdb_id, poster_path")
            .single();
          if (!fixMpaErr && fixedMovie) movieData = fixedMovie;
        } catch (_) {
          // Best-effort only.
        }
      }
    }

    // If no movie_id was provided, do TMDb search by title (+ optional year)
    // and upsert into Movies.
    if (!movieData) {
    const searchUrl = new URL("https://api.themoviedb.org/3/search/movie");
    searchUrl.searchParams.set("query", title);
    searchUrl.searchParams.set("include_adult", "false");
    searchUrl.searchParams.set("language", "en-US");
    searchUrl.searchParams.set("page", "1");
    if (release_year) searchUrl.searchParams.set("year", String(release_year));

    const searchRes = await fetch(searchUrl.toString(), {
      headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
    });

    if (!searchRes.ok) {
      const details = await searchRes.text();
      return jsonResponse({ code: 400, message: "TMDb search failed.", details }, 400);
    }

    const searchJson = await searchRes.json();
    const best = pickBestSearchResult(searchJson?.results ?? [], release_year);
    if (!best?.id) {
      return jsonResponse({ code: 404, message: "No TMDb match found." }, 404);
    }

    tmdb_id = Number(best.id);

    // TMDb details to get runtime/title/release date
    const detailsUrl = new URL(`https://api.themoviedb.org/3/movie/${tmdb_id}`);
    detailsUrl.searchParams.set("language", "en-US");

    // TMDb release_dates to get US certification (MPA rating)
    const releaseDatesUrl = new URL(
      `https://api.themoviedb.org/3/movie/${tmdb_id}/release_dates`,
    );

    // TMDb external_ids to get IMDb ID
    const externalIdsUrl = new URL(
      `https://api.themoviedb.org/3/movie/${tmdb_id}/external_ids`,
    );

    const tmdbHeaders = { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` };

    const [detailsRes, releaseDatesRes, externalIdsRes] = await Promise.all([
      fetch(detailsUrl.toString(), { headers: tmdbHeaders }),
      fetch(releaseDatesUrl.toString(), { headers: tmdbHeaders }),
      fetch(externalIdsUrl.toString(), { headers: tmdbHeaders }),
    ]);

    if (!detailsRes.ok) {
      const details = await detailsRes.text();
      return jsonResponse({ code: 400, message: "TMDb details fetch failed.", details }, 400);
    }

    const detailsJson = await detailsRes.json();
    const runtime_minutes = Number(detailsJson?.runtime ?? 0);
    if (!Number.isFinite(runtime_minutes) || runtime_minutes <= 0) {
      return jsonResponse({ code: 404, message: "TMDb did not return a usable runtime." }, 404);
    }

    const tmdbTitle = String(detailsJson?.title ?? best?.title ?? title).trim();
    const tmdbReleaseYear = detailsJson?.release_date
      ? Number(String(detailsJson.release_date).slice(0, 4))
      : (release_year ?? null);

    const tmdbReleaseDate = detailsJson?.release_date
      ? String(detailsJson.release_date)
      : null;

    let mpa_rating = null;
    if (releaseDatesRes.ok) {
      const releaseDatesJson = await releaseDatesRes.json();
      const us = (releaseDatesJson?.results ?? []).find((r) => r?.iso_3166_1 === "US");
      const dates = us?.release_dates ?? [];

      // Prefer theatrical-ish types if present: 3=Theatrical (limited), 2=Theatrical
      const preferredTypes = new Set([3, 2]);
      const preferred = dates.find((d) => d?.certification && preferredTypes.has(Number(d.type)));
      const anyCert = dates.find((d) => d?.certification);

      mpa_rating = String((preferred?.certification ?? anyCert?.certification ?? "").trim() || "") || null;
    }

    // If TMDb has no US certification, fall back to the client-provided MPA override.
    if (!mpa_rating && mpaOverride) {
      mpa_rating = mpaOverride;
    }

    let imdb_id = null;
    if (externalIdsRes.ok) {
      const externalIdsJson = await externalIdsRes.json();
      const raw = String(externalIdsJson?.imdb_id ?? "").trim();
      imdb_id = raw ? raw : null;
    }

    // TMDb genres (prefer details endpoint which includes names)
    tmdbGenres = Array.isArray(detailsJson?.genres) ? detailsJson.genres : [];
    tmdbGenreIds = new Set(
      tmdbGenres
        .map((g) => Number(g?.id))
        .filter((n) => Number.isFinite(n) && n > 0),
    );
    tmdbGenreNames = new Set(
      tmdbGenres
        .map((g) => String(g?.name ?? "").trim())
        .filter(Boolean),
    );

    // Requires a UNIQUE constraint on Movies.tmdb_id for onConflict to work cleanly
    const poster_path_raw = String(detailsJson?.poster_path ?? best?.poster_path ?? "").trim();
    const poster_path = poster_path_raw
      ? (poster_path_raw.startsWith("/") ? poster_path_raw : `/${poster_path_raw}`)
      : null;

    const movieRow = {
      tmdb_id,
      title: tmdbTitle,
      release_year: tmdbReleaseYear,
      runtime_minutes,
      mpa_rating,
      imdb_id,
      poster_path,
      // Optional convenience field if you have it in your schema; safe to remove if not.
      // release_date: tmdbReleaseDate,
    };

    const { data: upsertedMovie, error: upsertErr } = await supabaseAdmin
      .from("Movies")
      .upsert(movieRow, { onConflict: "tmdb_id" })
      .select("id, tmdb_id, title, release_year, runtime_minutes, mpa_rating, imdb_id, poster_path")
      .single();

    if (upsertErr) {
      return jsonResponse(
        {
          code: 400,
          message: upsertErr.message,
          hint: "Add a UNIQUE constraint on public.\"Movies\"(tmdb_id) if missing.",
        },
        400,
      );
    }

    // Assign for downstream.
    movieData = upsertedMovie;
    }

    // Fetch + persist external IMDb rating (best-effort; should not block rating logs).
    const external_ratings = {
      imdb: { ok: false, pct: null, error: null },
    };

    try {
      const imdb_id = String(movieData?.imdb_id ?? "").trim() || null;
      const titleForOmdb = String(movieData?.title ?? title ?? "").trim();
      const yearForOmdb = movieData?.release_year ?? release_year ?? null;

      const r = await fetchOmdbImdbRatingPercent({
        imdb_id,
        title: titleForOmdb,
        year: yearForOmdb,
        omdbApiKey: OMDB_API_KEY,
      });

      external_ratings.imdb.pct = r?.pct ?? null;
      external_ratings.imdb.ok = Boolean(r?.ok) && r?.pct !== null;
      external_ratings.imdb.error = external_ratings.imdb.ok ? null : (r?.reason ?? null);

      if (external_ratings.imdb.ok && movieData?.id) {
        const row = {
          movie_id: movieData.id,
          source: "imdb",
          rating: external_ratings.imdb.pct,
          fetched_at: new Date().toISOString(),
        };

        const { error: upsertErr } = await supabaseAdmin
          .from("Movie External Ratings")
          .upsert(row, { onConflict: "movie_id,source" });

        if (upsertErr) {
          external_ratings.imdb.ok = false;
          external_ratings.imdb.error = `DB upsert failed: ${upsertErr.message}`;
        }
      }
    } catch (e) {
      external_ratings.imdb.ok = false;
      external_ratings.imdb.error = `External rating sync crashed: ${String(e?.message ?? e)}`;
    }

    // Sync Movie Genres join table (one row per TMDb genre)
    // Tables:
    // - "Genres" (id, name)
    // - "Movie Genres" (movie_id FK -> Movies, genre_id FK -> Genres)
    // This uses service role, so it bypasses RLS (server-side only).
    // IMPORTANT: This should not block saving a Movie; failures are returned as a warning.
    const movie_row_id = movieData?.id;
    const genreSync = {
      requested: tmdbGenres.length,
      matched: 0,
      inserted: 0,
      error: null,
    };

    if (movie_row_id && (tmdbGenreIds.size > 0 || tmdbGenreNames.size > 0)) {
      const { data: allGenres, error: genresErr } = await supabaseAdmin
        .from("Genres")
        .select("id, name");

      if (genresErr) {
        genreSync.error = `Failed to load Genres: ${genresErr.message}`;
      } else {
        const byLowerName = new Map();
        for (const g of allGenres ?? []) {
          const name = String(g?.name ?? "").trim();
          if (!name) continue;
          byLowerName.set(name.toLowerCase(), g?.id);
        }

        // Prefer matching by TMDb genre id if your Genres.id uses TMDb ids.
        // If not, fall back to matching by genre name (Genres.name).
        const matchedGenreIds = new Set();
        for (const gid of tmdbGenreIds) {
          const hit = (allGenres ?? []).find((g) => Number(g?.id) === gid);
          if (hit?.id !== undefined && hit?.id !== null) matchedGenreIds.add(hit.id);
        }
        if (matchedGenreIds.size === 0) {
          for (const name of tmdbGenreNames) {
            const id = byLowerName.get(String(name).toLowerCase());
            if (id !== undefined && id !== null) matchedGenreIds.add(id);
          }
        }
        genreSync.matched = matchedGenreIds.size;

        // Refresh rows for this movie_id (idempotent without requiring a UNIQUE constraint)
        const { error: delErr } = await supabaseAdmin
          .from("Movie Genres")
          .delete()
          .eq("movie_id", movie_row_id);

        if (delErr) {
          genreSync.error = `Failed to clear Movie Genres: ${delErr.message}`;
        } else {
          const joinRows = Array.from(matchedGenreIds).map((genre_id) => ({
            movie_id: movie_row_id,
            genre_id,
          }));

          if (joinRows.length > 0) {
            const { error: insErr } = await supabaseAdmin
              .from("Movie Genres")
              .insert(joinRows);

            if (insErr) {
              genreSync.error = `Failed to insert Movie Genres: ${insErr.message}`;
            } else {
              genreSync.inserted = joinRows.length;
            }
          }
        }
      }
    }

    // Sync watch providers -> Platforms + Movie Platforms (best-effort).
    // IMPORTANT: This must not block the core save flow.
    const platformSync = {
      region: "US",
      requested: 0,
      created_platforms: 0,
      linked: 0,
      error: null,
    };

    if (movieData?.id && Number.isFinite(Number(tmdb_id)) && Number(tmdb_id) > 0) {
      const watchRegionRaw = body?.watch_region ?? body?.region ?? "US";
      const watchRegion = String(watchRegionRaw || "US").trim().toUpperCase() || "US";
      try {
        const r = await syncMovieWatchPlatforms({
          supabaseAdmin,
          movie_id: movieData.id,
          tmdb_id,
          tmdbReadAccessToken: TMDB_READ_ACCESS_TOKEN,
          region: watchRegion,
          timeoutMs: 1400,
        });
        platformSync.region = r?.region ?? watchRegion;
        platformSync.requested = Number(r?.requested ?? 0) || 0;
        platformSync.created_platforms = Number(r?.created_platforms ?? 0) || 0;
        platformSync.linked = Number(r?.linked ?? 0) || 0;
        platformSync.error = r?.error ?? null;
      } catch (e) {
        platformSync.error = `Platform sync crashed: ${String(e?.message ?? e)}`;
      }
    }

    // Optional: sync top-billed cast into People when requested.
    // IMPORTANT: People sync must not break the core "log rating" flow.
    // If it fails, we return `people_sync.ok=false` but still return HTTP 200.
    let people_sync = null;
    if (sync_people) {
      const peopleResult = await insertPeopleFromCredits(tmdb_id, movieData?.id || null);
      if (!peopleResult?.ok) {
        people_sync = {
          ok: false,
          message: peopleResult?.message || "People sync failed.",
          details: peopleResult?.details || null,
          table: peopleResult?.table || PEOPLE_TABLE,
        };
      } else {
        const warnings = [peopleResult?.cast_sync?.error, peopleResult?.crew_sync?.error].filter(Boolean);
        people_sync = {
          ok: warnings.length === 0,
          message: warnings.length ? "People sync completed with warnings." : null,
          details: warnings.length ? warnings.join(" | ") : null,
          requested: peopleResult.requested,
          inserted: peopleResult.inserted,
          skipped: peopleResult.skipped,
          table: peopleResult.table,
          roles: peopleResult.roles || null,
          cast_sync: peopleResult.cast_sync || null,
          crew_sync: peopleResult.crew_sync || null,
        };
      }
    }

    return jsonResponse({
      movie_id: movieData.id,
      tmdb_id: movieData.tmdb_id,
      title: movieData.title,
      release_year: movieData.release_year,
      runtime_minutes: movieData.runtime_minutes,
      mpa_rating: movieData.mpa_rating,
      imdb_id: movieData.imdb_id,
      genre_sync: genreSync,
      platform_sync: platformSync,
      imdb_rating_pct: external_ratings?.imdb?.pct ?? null,
      external_ratings,
      ...(people_sync ? { people_sync } : {}),
      source: "tmdb",
    });
  } catch (e) {
    return jsonResponse({ code: 500, message: String(e?.message ?? e) }, 500);
  }
});