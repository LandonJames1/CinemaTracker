const fetchWatchedTmdbIds = async (supabaseAdmin, userId) => {
  const watched = new Set();
  let from = 0;
  const pageSize = 1000;
  while (true) {
    const { data, error } = await supabaseAdmin
      .from("user_library_items_v2")
      .select("tmdb_id")
      .eq("user_id", userId)
      .range(from, from + pageSize - 1);
    if (error) throw error;
    const rows = Array.isArray(data) ? data : [];
    rows.forEach((r) => {
      const id = Number(r?.tmdb_id);
      if (Number.isFinite(id) && id > 0) watched.add(id);
    });
    if (rows.length < pageSize) break;
    from += pageSize;
