function uniqStrings(arr) {
  const out = [];
  const seen = new Set();
  for (const v of Array.isArray(arr) ? arr : []) {
    const s = String(v ?? "").trim();
    if (!s) continue;
    if (seen.has(s)) continue;
    seen.add(s);
    out.push(s);
  }
  return out;
}

// ---- Taste predictor ---------------------------------------------------------
// One reusable scorer: given the user's taste model + a movie's features, predict
// how this user would rate it (0-100) plus short human-readable reason fragments.
// The taste model is built from the Taste Profiles row (see taste_profile_edge.js):
//   { hasData, mean, imdbDelta, genres:{nameLower:aff}, decades:{decade:aff} }
// `aff` is the shrunk per-group rating minus the user's personal mean (in points).
// Features available at AI Picks rerank time: { genres:[names], year, vote_average }.
// People/runtime affinity live in the profile too and will feed the per-movie
// predictor once full movie details are available (e.g. the future swipe deck).
const TASTE_GENRE_WEIGHT = 1.0;        // genre affinity is the strongest available signal
const TASTE_KEYWORD_WEIGHT = 0.8;      // theme/keyword affinity (only when keywords are known)
const TASTE_DECADE_WEIGHT = 0.5;       // era is a weaker, noisier signal
const TASTE_CROWD_WEIGHT = 0.35;       // nudge toward what the crowd (TMDB) + imdb_delta implies
const TASTE_SWIPE_GENRE_WEIGHT = 0.2;  // Phase 3: right-swipe APPEAL — deliberately weak (aff is in ±100 lift-points, so this maxes ~±8)

// Discover deck: original languages to EXCLUDE from the candidate pool. The Indian
// subcontinent's commercial film industries draw enormous local audiences, so their
// films rack up huge TMDB vote/popularity counts and flood the popularity/trending
// sources regardless of the user's taste. This denylist removes them while keeping
// every OTHER foreign language (Korean/Japanese/French/Spanish/…) eligible. Friends-
// rated films are intentionally exempt from this filter. Edit this set to taste.
const DISCOVER_EXCLUDED_LANGS = new Set([
  "hi", // Hindi (Bollywood)
  "ta", // Tamil (Kollywood)
  "te", // Telugu (Tollywood)
  "ml", // Malayalam (Mollywood)
  "kn", // Kannada (Sandalwood)
  "mr", // Marathi
  "pa", // Punjabi
  "bn", // Bengali
  "gu", // Gujarati
  "ur", // Urdu
]);

function buildTasteModel(row) {
  if (!row || typeof row !== "object") return { hasData: false };
  const mean = Number(row?.mean_overall);
  if (!Number.isFinite(mean) || mean <= 0) return { hasData: false };

  const genres = {};
  const ga = row?.genre_affinity_json && typeof row.genre_affinity_json === "object" ? row.genre_affinity_json : {};
  for (const [name, info] of Object.entries(ga)) {
    const aff = Number(info?.aff);
    if (Number.isFinite(aff)) genres[String(name).toLowerCase()] = aff;
  }

  const decades = {};
  const db = row?.decade_bins_json && typeof row.decade_bins_json === "object" ? row.decade_bins_json : {};
  for (const [decade, info] of Object.entries(db)) {
    const aff = Number(info?.aff);
    if (Number.isFinite(aff)) decades[String(decade)] = aff;
  }

  // Keyword/theme affinity — only usable when a movie's keywords are known (e.g.
  // the future per-movie / swipe-deck predictor). AI Picks discover candidates
  // don't carry keywords, so this stays inert there but completes the model.
  const keywords = {};
  const ka = row?.keyword_affinity_json && typeof row.keyword_affinity_json === "object" ? row.keyword_affinity_json : {};
  for (const [name, info] of Object.entries(ka)) {
    const aff = Number(info?.aff);
    if (Number.isFinite(aff)) keywords[String(name).toLowerCase()] = aff;
  }

  // Swipe-appeal genre lift (Phase 3) — a weak, separate signal from the deck.
  const swipeGenres = {};
  const sga = row?.swipe_genre_affinity_json && typeof row.swipe_genre_affinity_json === "object" ? row.swipe_genre_affinity_json : {};
  for (const [name, info] of Object.entries(sga)) {
    const aff = Number(info?.aff);
    if (Number.isFinite(aff)) swipeGenres[String(name).toLowerCase()] = aff;
  }

  const hasData = Object.keys(genres).length > 0 || Object.keys(decades).length > 0
    || Object.keys(keywords).length > 0 || Object.keys(swipeGenres).length > 0;
  return { hasData, mean, imdbDelta: Number(row?.imdb_delta) || 0, genres, decades, keywords, swipeGenres };
}

function predictTasteScore(model, features) {
  if (!model || !model.hasData) return null;
  const feats = features && typeof features === "object" ? features : {};
  let score = model.mean;
  const reasons = [];

  // Genre: average affinity across the movie's genres.
  const genreNames = Array.isArray(feats.genres) ? feats.genres : [];
  const gAffs = [];
  for (const g of genreNames) {
    const aff = model.genres[String(g || "").toLowerCase()];
    if (typeof aff === "number") gAffs.push({ name: g, aff });
  }
  if (gAffs.length) {
    const avgAff = gAffs.reduce((a, x) => a + x.aff, 0) / gAffs.length;
    score += TASTE_GENRE_WEIGHT * avgAff;
    const best = gAffs.slice().sort((a, b) => b.aff - a.aff)[0];
    const worst = gAffs.slice().sort((a, b) => a.aff - b.aff)[0];
    if (best.aff >= 3) reasons.push(`you rate ${best.name} above your average`);
    if (worst.aff <= -4) reasons.push(`${worst.name} is usually below your average`);
  }

  // Swipe appeal (Phase 3): weak nudge from how the user right-swipes this genre in
  // the Discover deck. Separate from the ratings-based genre affinity above.
  if (model.swipeGenres && genreNames.length) {
    const swAffs = [];
    for (const g of genreNames) {
      const aff = model.swipeGenres[String(g || "").toLowerCase()];
      if (typeof aff === "number") swAffs.push(aff);
    }
    if (swAffs.length) {
      const avgAff = swAffs.reduce((a, x) => a + x, 0) / swAffs.length;
      score += TASTE_SWIPE_GENRE_WEIGHT * avgAff;
    }
  }

  // Keyword/theme affinity (only when the movie's keywords are provided).
  const kwNames = Array.isArray(feats.keywords) ? feats.keywords : [];
  const kAffs = [];
  for (const k of kwNames) {
    const aff = (model.keywords || {})[String(k || "").toLowerCase()];
    if (typeof aff === "number") kAffs.push({ name: k, aff });
  }
  if (kAffs.length) {
    const avgAff = kAffs.reduce((a, x) => a + x.aff, 0) / kAffs.length;
    score += TASTE_KEYWORD_WEIGHT * avgAff;
    const best = kAffs.slice().sort((a, b) => b.aff - a.aff)[0];
    if (best.aff >= 4) reasons.push(`leans into "${best.name}", a theme you like`);
  }

  // Decade.
  const year = Number(feats.year);
  if (Number.isFinite(year) && year > 1800) {
    const decade = Math.floor(year / 10) * 10;
    const aff = model.decades[String(decade)];
    if (typeof aff === "number") {
      score += TASTE_DECADE_WEIGHT * aff;
      if (aff >= 4) reasons.push(`${decade}s films land well with you`);
    }
  }

  // Crowd anchor: blend toward what TMDB's crowd rating + the user's imdb_delta imply.
  const vote = Number(feats.vote_average);
  if (Number.isFinite(vote) && vote > 0) {
    const crowdPred = vote * 10 + model.imdbDelta;
    score += TASTE_CROWD_WEIGHT * (crowdPred - model.mean);
  }

  const clamped = Math.max(0, Math.min(100, score));
  return { score: Math.round(clamped), reasons };
}

// Upsert a movie's TMDB keywords (theme tags like "heist"/"dystopia") into the
// Keywords + Movie Keywords tables (service role). `prefetched` = the keyword array
// from a details fetch (append_to_response=keywords → json.keywords.keywords); when
// absent it fetches /movie/{id}/keywords itself (used by the backfill action).
// Best-effort: returns { ok, count } or { ok:false, error } and never throws.
async function syncMovieKeywords(supabaseAdmin, tmdbHeaders, movieRowId, tmdbId, prefetched) {
  try {
    if (!movieRowId) return { ok: false, error: "Missing movie row id." };
    let kws = Array.isArray(prefetched) ? prefetched : null;
    if (!kws) {
      const res = await fetch(`https://api.themoviedb.org/3/movie/${Number(tmdbId)}/keywords`, { headers: tmdbHeaders });
      if (!res.ok) return { ok: false, error: `TMDb keywords HTTP ${res.status}` };
      const j = await res.json().catch(() => null);
      kws = Array.isArray(j?.keywords) ? j.keywords : [];
    }

    const clean = [];
    const seen = new Set();
    for (const k of kws) {
      const id = Number(k?.id);
      const name = String(k?.name ?? "").trim();
      if (!Number.isFinite(id) || id <= 0 || !name || seen.has(id)) continue;
      seen.add(id);
      clean.push({ tmdb_keyword_id: id, name });
    }

    const keywordIdByTmdb = new Map();
    if (clean.length) {
      const { data: upserted, error: upErr } = await supabaseAdmin
        .from("Keywords")
        .upsert(clean, { onConflict: "tmdb_keyword_id" })
        .select("id, tmdb_keyword_id");
      if (upErr) return { ok: false, error: `Keywords upsert: ${upErr.message}` };
      (upserted ?? []).forEach((r) => keywordIdByTmdb.set(Number(r.tmdb_keyword_id), r.id));
    }

    // Refresh the join rows for this movie (idempotent).
    const { error: delErr } = await supabaseAdmin
      .from("Movie Keywords")
      .delete()
      .eq("movie_id", movieRowId);
    if (delErr) return { ok: false, error: `Clear Movie Keywords: ${delErr.message}` };

    const joinRows = clean
      .map((c) => ({ movie_id: movieRowId, keyword_id: keywordIdByTmdb.get(c.tmdb_keyword_id) }))
      .filter((r) => r.keyword_id);
    if (joinRows.length) {
      const { error: insErr } = await supabaseAdmin.from("Movie Keywords").insert(joinRows);
      if (insErr) return { ok: false, error: `Insert Movie Keywords: ${insErr.message}` };
    }
    return { ok: true, count: joinRows.length };
  } catch (e) {
    return { ok: false, error: String(e?.message ?? e) };
  }
}

function mapGenreNamesToIds(names) {
  const list = Array.isArray(names) ? names : [];
  const ids = [];
  const seen = new Set();
  for (const raw of list) {
    const key = String(raw ?? "").trim().toLowerCase();
    if (!key) continue;
    const id = TMDB_MOVIE_GENRES_BY_NAME[key];
    if (!Number.isFinite(id)) continue;
    if (seen.has(id)) continue;
    seen.add(id);
    ids.push(id);
  }
  return ids;
}

