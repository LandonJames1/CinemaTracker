      const movieId = String(body?.movie_id ?? "").trim();
      if (!isUuid(movieId)) {
        return jsonResponse({ code: 400, message: "Valid movie_id is required." }, 400);
      }

      // Distinct people who recommended this movie to the caller.
      let recommenderIds = [];
      try {
        const { data: recRows } = await supabaseAdmin
          .from("Recommendations")
          .select("from_user_id")
          .eq("to_user_id", rater.id)
          .eq("movie_id", movieId);
        recommenderIds = Array.from(new Set(
          (Array.isArray(recRows) ? recRows : [])
            .map((x) => String(x.from_user_id || "").trim())
            .filter((x) => isUuid(x) && x !== rater.id),
        ));
      } catch (_) {}
      if (recommenderIds.length === 0) {
        return jsonResponse({ ok: true, movie_id: movieId, recommenders: 0, notified: 0 }, 200);
      }

      let movieTitle = "", movieYear = "";
      try {
        const { data: mrow } = await supabaseAdmin
          .from("Movies").select("title, release_year").eq("id", movieId).single();
        movieTitle = String(mrow?.title ?? "").trim();
        movieYear = (mrow?.release_year ?? "") === "" ? "" : String(mrow.release_year);
      } catch (_) {}
      let raterHandle = "";
      try {
        const { data: rrow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", rater.id).single();
        const uname = String(rrow?.username ?? "").trim();
        raterHandle = uname ? `@${uname}` : String(rrow?.display_name ?? "").trim();
      } catch (_) {}
      if (!raterHandle) raterHandle = "Someone";

      const titlePart = `"${movieTitle || "a movie"}${movieYear ? ` (${movieYear})` : ""}"`;
      let notified = 0;
      for (const recId of recommenderIds) {
        try {
          const badge = await computeUnseenBadge(supabaseAdmin, recId);
          const pushed = await sendPushToUser(supabaseAdmin, recId, {
            title: "Your rec got watched 🎬",
            body: `${raterHandle} reviewed ${titlePart} you recommended — check it out`,
            url: `/#review=${rater.id}:${movieId}`,
            badge,
            tag: `rec-review-${rater.id}-${movieId}`,
          });
          if (pushed > 0) notified++;
        } catch (_) {}
      }

      return jsonResponse({ ok: true, movie_id: movieId, recommenders: recommenderIds.length, notified }, 200);
    }

    // ---- Notify the OTHER members of a shared list of a new movie -------------
    // Fired when a member adds a movie to a shared list. Recipients = the list's
    // members (owner + List Members) minus the person who added it. The caller is
    // verified to be a member before anything is sent. Best-effort web push.
    if (action === "notify_list_add") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const adder = userData?.user || null;
      if (userErr || !adder?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }

      const isUuid = (v) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(v || "").trim());
      const listId = String(body?.list_id ?? "").trim();
      const movieId = String(body?.movie_id ?? "").trim();
      if (!isUuid(listId)) {
        return jsonResponse({ code: 400, message: "Valid list_id is required." }, 400);
      }

      // Resolve the list (owner + name) and its members.
      let ownerId = "", listName = "";
      try {
        const { data: lrow } = await supabaseAdmin
          .from("Lists").select("user_id, list_name").eq("id", listId).single();
        ownerId = String(lrow?.user_id ?? "").trim();
        listName = String(lrow?.list_name ?? "").trim();
      } catch (_) {}
      if (!ownerId) {
        return jsonResponse({ code: 404, message: "List not found." }, 404);
      }

      let memberIds = [];
      try {
        const { data: mrows } = await supabaseAdmin
          .from("List Members").select("user_id").eq("list_id", listId);
        memberIds = (Array.isArray(mrows) ? mrows : [])
          .map((x) => String(x.user_id || "").trim()).filter(isUuid);
      } catch (_) {}

      // The full member set = owner + member rows. Verify the caller belongs to it.
      const allMembers = Array.from(new Set([ownerId, ...memberIds].filter(isUuid)));
      if (!allMembers.includes(adder.id)) {
        return jsonResponse({ code: 403, message: "Not a member of this list." }, 403);
      }
      // Recipients = everyone in the list except the person who added the movie.
      const recipientIds = allMembers.filter((x) => x !== adder.id);
      if (recipientIds.length === 0) {
        return jsonResponse({ ok: true, list_id: listId, recipients: 0, notified: 0 }, 200);
      }

      // Movie title (+ year) + adder handle for the message.
      let movieTitle = "", movieYear = "";
      if (isUuid(movieId)) {
        try {
          const { data: mrow } = await supabaseAdmin
            .from("Movies").select("title, release_year").eq("id", movieId).single();
          movieTitle = String(mrow?.title ?? "").trim();
          movieYear = (mrow?.release_year ?? "") === "" ? "" : String(mrow.release_year);
        } catch (_) {}
      }
      let adderHandle = "";
      try {
        const { data: arow } = await supabaseAdmin
          .from("Users").select("username, display_name").eq("id", adder.id).single();
        const uname = String(arow?.username ?? "").trim();
        adderHandle = uname ? `@${uname}` : String(arow?.display_name ?? "").trim();
      } catch (_) {}
      if (!adderHandle) adderHandle = "Someone";

      const titlePart = `"${movieTitle || "a movie"}${movieYear ? ` (${movieYear})` : ""}"`;
      const listPart = listName || "a shared list";
      let notified = 0;
      for (const rid of recipientIds) {
        try {
          const badge = await computeUnseenBadge(supabaseAdmin, rid);
          const pushed = await sendPushToUser(supabaseAdmin, rid, {
            title: `Added to ${listPart} 🎬`,
            body: `${adderHandle} added ${titlePart} to ${listPart}`,
            url: `/#list=${listId}`,
            badge,
            tag: `list-add-${listId}-${movieId}`,
          });
          if (pushed > 0) notified++;
        } catch (_) {}
      }

      return jsonResponse({ ok: true, list_id: listId, recipients: recipientIds.length, notified }, 200);
    }

    // Admin/self test: send a real Web Push to the caller's own subscribed devices.
    if (action === "test_push") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }
      const sent = await sendPushToUser(supabaseAdmin, me.id, {
        title: "CinemaTracker 🍿",
        body: "✅ Push notifications are working!",
        url: "/",
      });
      return jsonResponse({
        ok: true,
        sent,
        reason: sent > 0
          ? undefined
          : "No push sent — enable push on this device first (Account → Push notifications), or VAPID secrets aren't set.",
      }, 200);
    }

    // Admin-only: generate a brand-new achievement (name, description, rule JSON,
    // family, suggested tier/points) PLUS several simple flat-SVG icon options
    // from a broad natural-language prompt. The client lets the admin pick/edit/
    // regenerate an icon and then writes the Achievements row. For franchise /
    // filmography prompts the model lists the films and we resolve them to real
    // TMDB ids so the movie_set rule works.
    if (action === "generate_achievement") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }
      const ADMIN_EMAIL = (Deno.env.get("ADMIN_EMAIL") || "landon.talus@gmail.com").trim().toLowerCase();
      if (String(me.email || "").trim().toLowerCase() !== ADMIN_EMAIL) {
        return jsonResponse({ code: 403, message: "Admin only." }, 403);
      }

      const ANTHROPIC_API_KEY = Deno.env.get("ANTHROPIC_API_KEY");
      if (!ANTHROPIC_API_KEY) {
        return jsonResponse({ code: 500, message: "Missing ANTHROPIC_API_KEY." }, 500);
      }
      const ANTHROPIC_MODEL_BUILDER = Deno.env.get("ANTHROPIC_MODEL_BUILDER") || "claude-sonnet-4-6";

      const prompt = String(body?.prompt ?? "").trim();
      if (!prompt) {
        return jsonResponse({ code: 400, message: "Missing prompt." }, 400);
      }
      const iconCountRaw = Number(body?.icon_count);
      const iconCount = Number.isFinite(iconCountRaw) ? Math.min(6, Math.max(3, Math.floor(iconCountRaw))) : 4;
      // When the admin is iterating on art for an already-decided achievement,
      // they can pass icons_only:true (+ icon_concept) to get fresh art without
      // re-deriving the name/rule/etc.
      const iconsOnly = body?.icons_only === true;
      const iconHint = String(body?.icon_concept ?? "").trim();

      // "More icon options" — no LLM needed: pull fresh icons from the library
      // using the concept (or any extra keywords the client passes), shuffled.
      if (iconsOnly) {
        const kw = Array.isArray(body?.keywords) && body.keywords.length
          ? body.keywords
          : [iconHint || prompt, prompt].filter(Boolean);
        const moreIcons = await iconsFromKeywords(kw, iconCount, true, true); // strict: respect typed terms
        return jsonResponse({ ok: true, icons: moreIcons, keywords: kw }, 200);
      }

      const TIERS = ["Bronze", "Silver", "Gold", "Platinum", "Diamond", "Emerald", "Ruby"];
      const RULE_HELP = [
        "rating_count   - watch/rate N movies total. rule: {type,threshold,source:'ratings'}",
        "rewatch_count  - rewatch one movie N times. rule: {type,threshold,source:'watch_logs'}",
        "director_count - rate N movies by a single director. rule: {type,threshold,source:'ratings'}",
        "genre_count    - rate movies across N distinct genres. rule: {type,threshold,source:'ratings'}",
        "decade_count   - rate movies from N distinct decades. rule: {type,threshold,source:'ratings'}",
        "daily_count    - watch N movies in one day. rule: {type,threshold,source:'watch_logs'}",
        "rolling_week_count - watch N movies within any 7 days. rule:{type,threshold,source:'watch_logs'}",
        "daily_streak   - watch movies N days in a row. rule: {type,threshold,source:'watch_logs'}",
        "weekly_streak  - watch movies N weeks in a row. rule: {type,threshold,source:'watch_logs'}",
        "recommend_count - recommend N movies to other users. rule: {type,threshold}",
        "follow_count   - follow N other users. rule: {type,threshold}",
        "follower_count - reach N followers. rule: {type,threshold}",
        "list_count     - create N custom lists. rule: {type,threshold}",
        "theater_count  - watch N movies in theaters. rule: {type,threshold}",
        "actor_count    - rate N movies starring the same actor. rule: {type,threshold}",
        "quote_count    - save N favourite movie quotes. rule: {type,threshold}",
        "series_count   - watch N TV series. rule: {type,threshold}",
        "runtime_hours  - watch N total HOURS of film (threshold is hours). rule: {type,threshold}",
        "high_rating_count - rate N movies at or above a score. rule: {type,threshold,min_overall:90} (min_overall 0-100, default 90)",
        "movie_set      - watch a SPECIFIC set of films (a franchise/saga/filmography). rule: {type:'movie_set', movies:[{title,year}], require_count?}",
      ].join("\n");

      const system = [
        "You design achievements for a movie-tracking app called CinemaTracker.",
        "Given a broad admin prompt, produce ONE achievement and a list of icon search keywords.",
        "",
        "RULE TYPES (pick the single best fit and fill its fields):",
        RULE_HELP,
        "",
        "For movie_set, also fill 'set_source' so the set can auto-update when new films release:",
        "  - a single DIRECTOR or ACTOR's filmography -> kind:'person', query:<their name>, role:'Director' or 'Actor'.",
        "  - a FRANCHISE/saga TMDB groups as a collection (e.g. Harry Potter, James Bond) -> kind:'collection', query:<franchise name>.",
        "  - a hand-picked/curated SUBSET TMDB does NOT track as one group (e.g. 'the 9 MAIN Star Wars films', excluding spinoffs) -> kind:'manual', and THEN list the exact films in rule.movies (title + year). Do NOT invent films.",
        "Prefer person/collection when possible (those self-update); use manual only for curated subsets.",
        "Pick a creative, evocative NAME (not just the prompt restated), and a clear one-sentence DESCRIPTION.",
        "Pick a 'family' = a short snake_case key shared by sibling tiers of the same progression",
        "(e.g. 'movies_rated', 'director_devotion', 'star_wars_saga'). Tiers in a family share one icon.",
        "Suggest a 'tier' from: " + TIERS.join(", ") + " (harder = higher tier) and integer 'points' (10-200, harder = more).",
        "",
        "LADDER: if this is any COUNT/THRESHOLD achievement (rating_count, rewatch_count, genre_count,",
        "decade_count, daily_count, rolling_week_count, daily_streak, weekly_streak, recommend_count,",
        "follow_count, follower_count, list_count, theater_count, actor_count, quote_count, series_count,",
        "runtime_hours, high_rating_count), ALSO propose a 'ladder'",
        "of 3-6 ADDITIONAL higher tiers of the SAME progression (same family + rule type, escalating threshold,",
        "rising tier toward Ruby, rising points) so the admin can create the whole set at once. Each ladder entry",
        "needs name + 1-line description + threshold + tier + points. Do NOT repeat the requested tier. For",
        "movie_set or genuinely one-off achievements, return an empty ladder.",
        "",
        "ICON KEYWORDS: give 8-12 'icon_keywords' to search an icon library with. NEVER use a proper",
        "noun (person, brand, franchise, title) — those don't exist as icons. Translate the THEME into",
        "concrete everyday OBJECTS associated with it, simplest/most-common first. The system also tries",
        "spelling/plural variants automatically, so plain head nouns work best. Examples:",
        "  'all Christopher Nolan movies' -> 'film','reel','clapperboard','director chair','camera','spinner','clock','maze'",
        "  Star Wars -> 'saber','sword','rocket','planet','robot','helmet','star','spaceship'",
        "  many-movies -> 'film','clapperboard','camera','popcorn','ticket','reel'",
        "  streaks/marathons -> 'fire','calendar','medal','trophy','crown','flame'.",
        "Mix SPECIFIC objects (e.g. 'saber') with several SAFE generic fallbacks ('film','trophy','star')",
        "so at least some icons are always found. Each keyword = a real object noun (1-2 words ok), no verbs.",
        "ALWAYS write multi-word objects as SEPARATE words — 'light saber' NOT 'lightsaber', 'director",
        "chair' NOT 'directorchair', 'death star' NOT 'deathstar'. Never glue words together.",
        "Also set 'icon_concept' to a 2-4 word subject summary.",
      ].filter(Boolean).join("\n");

      const schema = {
        type: "object",
        properties: {
          name: { type: "string" },
          description: { type: "string" },
          family: { type: "string", description: "snake_case key shared by sibling tiers" },
          tier: { type: "string", enum: TIERS },
          points: { type: "integer" },
          icon_concept: { type: "string", description: "2-4 word icon subject summary" },
          icon_keywords: {
            type: "array",
            items: { type: "string", description: "a single concrete object/symbol to search for" },
          },
          ladder: {
            type: "array",
            description: "for count/threshold achievements: ADDITIONAL higher sibling tiers to optionally create together (same family). Empty for movie_set / one-offs.",
            items: {
              type: "object",
              properties: {
                name: { type: "string" },
                description: { type: "string" },
                threshold: { type: "integer" },
                tier: { type: "string", enum: TIERS },
                points: { type: "integer" },
              },
              required: ["name", "threshold", "tier", "points"],
            },
          },
          set_source: {
            type: "object",
            description: "for movie_set: how the film set is defined so it can auto-update",
            properties: {
              kind: { type: "string", enum: ["person", "collection", "manual"] },
              query: { type: "string", description: "the person or franchise/collection name to search on TMDB" },
              role: { type: "string", enum: ["Director", "Actor"] },
            },
          },
          rule: {
            type: "object",
            properties: {
              type: { type: "string" },
              threshold: { type: "integer" },
              source: { type: "string" },
              require_count: { type: "integer" },
              movies: {
                type: "array",
                items: {
                  type: "object",
                  properties: { title: { type: "string" }, year: { type: "integer" } },
                  required: ["title"],
                },
              },
            },
            required: ["type"],
          },
        },
        required: ["name", "description", "family", "tier", "points", "rule", "icon_keywords"],
      };

      let draft;
      try {
        draft = await callAnthropicJson({
          apiKey: ANTHROPIC_API_KEY,
          model: ANTHROPIC_MODEL_BUILDER,
          schemaName: "achievement_draft",
          schema,
          system,
          user: "Admin prompt: " + prompt,
          maxTokens: 2048,
        });
      } catch (e) {
        return jsonResponse({ code: 502, message: "Generation failed: " + String(e?.message || e) }, 502);
      }

      // Pull real icons from the library using the LLM's keywords.
      const keywords = Array.isArray(draft?.icon_keywords) ? draft.icon_keywords : [];
      const icons = await iconsFromKeywords(
        keywords.length ? keywords : [String(draft?.icon_concept || prompt)],
        iconCount,
        false,
        false, // broad: auto AI keywords cast a wide net
      );

      const rule = draft?.rule && typeof draft.rule === "object" ? { ...draft.rule } : {};
      let resolvedMovies = [];
      let setSourceOut = null;

      if (String(rule.type || "") === "movie_set") {
        const ss = draft?.set_source && typeof draft.set_source === "object" ? draft.set_source : {};
        const kind = String(ss?.kind || "").toLowerCase();

        if (kind === "person" || kind === "collection") {
          // Resolve a TMDB person/collection -> store its id + current film list.
          const { source, films } = await resolveMovieSet(ss, TMDB_READ_ACCESS_TOKEN);
          applyMovieSetSourceToRule(rule, source, films);
          resolvedMovies = films;
          setSourceOut = source;
        } else if (Array.isArray(rule.movies)) {
          // Manual / curated subset: resolve the LLM's explicit titles to ids.
          const tmdbIds = [];
          for (const mv of rule.movies.slice(0, 60)) {
            const title = String(mv?.title || "").trim();
            if (!title) continue;
            const sJson = await tmdbGetJson("search/movie", { query: title, year: mv?.year }, TMDB_READ_ACCESS_TOKEN);
            const hit = Array.isArray(sJson?.results) ? sJson.results[0] : null;
            if (hit?.id) {
              tmdbIds.push(Number(hit.id));
              resolvedMovies.push({ title: hit.title || title, year: String(hit.release_date || "").slice(0, 4) || (mv?.year ? String(mv.year) : ""), tmdb_id: Number(hit.id), poster_path: hit.poster_path || null });
            } else {
              resolvedMovies.push({ title, year: mv?.year ? String(mv.year) : "", tmdb_id: null, poster_path: null });
            }
          }
          rule.source_kind = "manual";
          rule.tmdb_ids = tmdbIds;
          if (!rule.require_count) rule.require_count = tmdbIds.length;
          delete rule.movies;
          setSourceOut = { kind: "manual" };
        }
      }

      return jsonResponse({
        ok: true,
        draft: {
          name: String(draft?.name || "").trim(),
          description: String(draft?.description || "").trim(),
          family: String(draft?.family || "").trim(),
          tier: String(draft?.tier || "").trim(),
          points: Number(draft?.points) || 0,
          icon_concept: String(draft?.icon_concept || "").trim(),
          rule,
        },
        icons,
        keywords,
        set_source: setSourceOut,
        resolved_movies: resolvedMovies,
        ladder: (Array.isArray(draft?.ladder) ? draft.ladder : [])
          .filter((e) => e && e.name && Number.isFinite(Number(e.threshold)))
          .map((e) => ({
            name: String(e.name).trim(),
            description: String(e.description || "").trim(),
            threshold: Number(e.threshold),
            tier: String(e.tier || "").trim(),
            points: Number(e.points) || 0,
          })),
      }, 200);
    }

    // Admin-only: (re)resolve a movie_set source against TMDB so the builder can
    // CONFIRM the right person/collection + film list before saving.
    if (action === "resolve_movie_source") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, { global: { headers: { Authorization: authHeader } } });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      const ADMIN_EMAIL = (Deno.env.get("ADMIN_EMAIL") || "landon.talus@gmail.com").trim().toLowerCase();
      if (String(me.email || "").trim().toLowerCase() !== ADMIN_EMAIL) return jsonResponse({ code: 403, message: "Admin only." }, 403);

      const ss = body?.set_source && typeof body.set_source === "object"
        ? body.set_source
        : { kind: body?.kind, query: body?.query, role: body?.role };
      const { source, films } = await resolveMovieSet(ss, TMDB_READ_ACCESS_TOKEN);
      return jsonResponse({
        ok: true,
        source,
        resolved_movies: films,
        tmdb_ids: films.map((f) => f.tmdb_id),
        found: Boolean(source?.person_tmdb_id || source?.collection_tmdb_id),
      }, 200);
    }

    // Admin-only: resolve a list of TMDB movie ids -> display info (title/year/poster),
    // so the builder can show a stored manual movie_set as editable rows when editing.
    if (action === "tmdb_lookup") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, { global: { headers: { Authorization: authHeader } } });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      const ADMIN_EMAIL = (Deno.env.get("ADMIN_EMAIL") || "landon.talus@gmail.com").trim().toLowerCase();
      if (String(me.email || "").trim().toLowerCase() !== ADMIN_EMAIL) return jsonResponse({ code: 403, message: "Admin only." }, 403);

      const ids = (Array.isArray(body?.tmdb_ids) ? body.tmdb_ids : [])
        .map((x) => Number(x)).filter((n) => Number.isFinite(n) && n > 0).slice(0, 80);
      const films = (await mapWithConcurrency(ids, 6, async (id) => {
        const j = await tmdbGetJson(`movie/${id}`, {}, TMDB_READ_ACCESS_TOKEN);
        if (!j?.id) return null;
        return { tmdb_id: Number(j.id), title: String(j.title || j.name || "").trim(), year: String(j.release_date || "").slice(0, 4), poster_path: j.poster_path || null };
      })).filter(Boolean);
      // Preserve the caller's id order.
      films.sort((a, b) => ids.indexOf(a.tmdb_id) - ids.indexOf(b.tmdb_id));
      return jsonResponse({ ok: true, films }, 200);
    }

    // Admin-only: insert (or update, if id is provided) an Achievements row.
    // Uses the service role so it works regardless of table RLS, and is gated to
    // the admin email. When updating, the id is preserved so earned User
    // Achievements rows stay valid. The DB triggers re-award + recalc tiers.
    if (action === "save_achievement") {
      const authHeader = req.headers.get("Authorization") ?? "";
      if (!authHeader) {
        return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
      }
      const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        global: { headers: { Authorization: authHeader } },
      });
      const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
      const me = userData?.user || null;
      if (userErr || !me?.id) {
        return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
      }
      const ADMIN_EMAIL = (Deno.env.get("ADMIN_EMAIL") || "landon.talus@gmail.com").trim().toLowerCase();
      if (String(me.email || "").trim().toLowerCase() !== ADMIN_EMAIL) {
        return jsonResponse({ code: 403, message: "Admin only." }, 403);
      }

      const a = body?.achievement && typeof body.achievement === "object" ? body.achievement : {};
      const name = String(a?.name || "").trim();
      if (!name) return jsonResponse({ code: 400, message: "Missing achievement name." }, 400);
      const rule = a?.rule && typeof a.rule === "object" ? a.rule : null;

      const row = {
        name,
        description: String(a?.description || "").trim(),
        tier: String(a?.tier || "").trim() || null,
        points: Number(a?.points) || 0,
        family: String(a?.family || "").trim() || null,
        type: rule ? String(rule.type || "").trim() : (String(a?.type || "").trim() || null),
        rule,
        icon_url: String(a?.icon_url || "").trim() || null,
        is_active: a?.is_active === false ? false : true,
      };

      let result;
      const editId = String(a?.id || "").trim();
      if (editId) {
        result = await supabaseAdmin.from("Achievements").update(row).eq("id", editId).select("id").maybeSingle();
      } else {
        // When the admin adds a tier to an existing family and reuses its icon,
        // the row is still a distinct achievement (different name/threshold).
        result = await supabaseAdmin.from("Achievements").insert(row).select("id").maybeSingle();
      }
      if (result?.error) {
        return jsonResponse({ code: 500, message: "Save failed: " + String(result.error.message || result.error) }, 500);
      }

      // If editing a family's art, optionally push the new icon to every sibling.
      if (body?.apply_icon_to_family === true && row.family && row.icon_url) {
        await supabaseAdmin.from("Achievements").update({ icon_url: row.icon_url }).eq("family", row.family);
      }

      // On a NEW achievement, silently grant it to everyone who already qualifies
      // so it's not treated as "newly earned" (and animated) on their next save.
      if (!editId) {
        try { await supabaseAdmin.rpc("award_all_users"); } catch (_) {}
      }

      return jsonResponse({ ok: true, id: result?.data?.id || editId || null }, 200);
    }

    // Poster failsafe (Option B): on each invocation, opportunistically backfill missing Movies.poster_path.
    // NOTE: We skip this during `search` since search fires rapidly while typing.
    if (action !== "search") {
      const hintedRaw = body?.tmdb_id ?? body?.id;
      const hintedTmdbId = Number(hintedRaw);

      // Try the hinted movie first (if any), then repair as many missing posters as possible.
      try {
        if (Number.isFinite(hintedTmdbId) && hintedTmdbId > 0) {
          await tryRepairPosterPathByTmdbId({
            supabaseAdmin,
            tmdbId: hintedTmdbId,
            tmdbReadAccessToken: TMDB_READ_ACCESS_TOKEN,
            timeoutMs: 900,
          });
        }

        await tryRepairAllMissingPosterPathsUncapped({
          supabaseAdmin,
          tmdbReadAccessToken: TMDB_READ_ACCESS_TOKEN,
          pageSize: 150,
          perFetchTimeoutMs: 900,
          concurrency: 6,
        });
      } catch (_) {
        // Best-effort only: never fail the main request.
      }
    }

    // Public action: TMDb search (used by the Home search dropdown).
    // This intentionally does NOT require a logged-in Supabase user; saving still requires auth.
    if (action === "search") {
      const query = String(body?.query ?? "").trim();
      const pageRaw = body?.page === null || body?.page === undefined ? 1 : Number(body.page);
      const page = Number.isFinite(pageRaw) && pageRaw > 0 ? Math.floor(pageRaw) : 1;

      const yearRaw = body?.year ?? body?.release_year ?? body?.primary_release_year;
      const yearNum = yearRaw === null || yearRaw === undefined || String(yearRaw).trim() === ""
        ? null
        : Number(yearRaw);
      const year = Number.isFinite(yearNum) && yearNum > 1800 ? Math.floor(yearNum) : null;

      const mpaFilterRaw = String(body?.mpa ?? "").trim();
      const mpaFilter = mpaFilterRaw ? mpaFilterRaw.toUpperCase() : "";

      const limitRaw = body?.limit === null || body?.limit === undefined ? 8 : Number(body.limit);
      const limit = Number.isFinite(limitRaw) ? Math.max(1, Math.min(12, Math.floor(limitRaw))) : 8;

      // Do not search until the user types at least 3 characters.
      if (!query || query.length < 3) {
        return jsonResponse({ results: [], page, total_pages: 0 }, 200);
      }

      const url = new URL("https://api.themoviedb.org/3/search/movie");
      url.searchParams.set("query", query);
      url.searchParams.set("include_adult", "false");
      url.searchParams.set("language", "en-US");
      url.searchParams.set("page", String(page));
      if (year) url.searchParams.set("primary_release_year", String(year));

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb search failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();
      const results = Array.isArray(tmdbJson?.results) ? tmdbJson.results : [];

      const cleaned = results
        .map((r, idx) => ({ r, idx }))
        .filter(({ r }) => Number.isFinite(Number(r?.id)) && String(r?.title ?? "").trim());

      const scored = cleaned
        .map(({ r, idx }) => {
          const score = titleMatchScore({ query, title: r?.title });
          const pop = Number(r?.popularity ?? 0) || 0;
          return { r, idx, score, pop };
        })
        .sort((a, b) => (b.score - a.score) || (b.pop - a.pop) || (a.idx - b.idx));

      // If the user asked for MPA filtering, keep a slightly larger candidate pool so filtering doesn't empty the list.
      const candidateCount = mpaFilter ? 18 : Math.max(limit, 8);
      const candidates = scored.slice(0, candidateCount).map((x) => x.r);

      let filtered = candidates;
      if (mpaFilter) {
        const fetchCert = async (tmdbId) => {
          try {
            const rdUrl = new URL(`https://api.themoviedb.org/3/movie/${tmdbId}/release_dates`);
            const res = await fetch(rdUrl.toString(), { headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` } });
            if (!res.ok) return "";
            const json = await res.json().catch(() => null);
            return extractUsCertification(json) || "";
          } catch (_) {
            return "";
          }
        };

        const withCert = await mapWithConcurrency(filtered, 6, async (r) => {
          const cert = await fetchCert(Number(r?.id));
          return { r, cert: String(cert || "").trim().toUpperCase() };
        });

        filtered = withCert
          .filter(({ cert }) => {
            if (mpaFilter === "NR") return !cert || cert === "NR" || cert === "NOT RATED";
            return cert === mpaFilter;
          })
          .map(({ r }) => r);
      }

      const mapped = filtered
        .slice(0, limit)
        .map((r) => {
          const y = r?.release_date ? Number(String(r.release_date).slice(0, 4)) : null;
          const ids = Array.isArray(r?.genre_ids) ? r.genre_ids : [];
          const genres = uniqStrings(ids.map((id) => TMDB_MOVIE_GENRES[Number(id)]).filter(Boolean));
          const genre = genres.length ? genres.join(", ") : "Movie";
          return {
            id: Number(r.id),
            tmdb_id: Number(r.id),
            title: String(r.title).trim(),
            year: Number.isFinite(y) ? y : null,
            genres,
            genre,
            poster_path: r?.poster_path ? String(r.poster_path) : null,
          };
        });

      return jsonResponse(
        {
          results: mapped,
          page: Number(tmdbJson?.page ?? page) || page,
          total_pages: Number(tmdbJson?.total_pages ?? 0) || 0,
        },
        200,
      );
    }

    // Public action: TMDb person search (used for actor/director avatars).
    if (action === "person") {
      const query = String(body?.query ?? body?.name ?? "").trim();
      const departmentRaw = String(body?.department ?? "").trim().toLowerCase();
      const department = departmentRaw ? departmentRaw : null;
      const limitRaw = body?.limit === null || body?.limit === undefined ? 3 : Number(body.limit);
      const limit = Number.isFinite(limitRaw) ? Math.max(1, Math.min(10, Math.floor(limitRaw))) : 3;

      if (!query || query.length < 2) {
        return jsonResponse({ results: [] }, 200);
      }

      const url = new URL("https://api.themoviedb.org/3/search/person");
      url.searchParams.set("query", query);
      url.searchParams.set("include_adult", "false");
      url.searchParams.set("language", "en-US");
      url.searchParams.set("page", "1");

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb person search failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();
      let results = Array.isArray(tmdbJson?.results) ? tmdbJson.results : [];

      if (department) {
        results = results.filter((r) => String(r?.known_for_department ?? "").trim().toLowerCase() === department);
      }

      const mapped = results
        .slice(0, limit)
        .map((r) => ({
          id: Number(r?.id ?? 0) || null,
          name: String(r?.name ?? "").trim(),
          profile_path: r?.profile_path ? String(r.profile_path).trim() : null,
          known_for_department: String(r?.known_for_department ?? "").trim(),
        }));

      return jsonResponse({ results: mapped }, 200);
    }

    // Public action: fetch full movie details for prefill.
    if (action === "details") {
      const tmdb_id_raw = body?.tmdb_id ?? body?.id;
      const tmdb_id = Number(tmdb_id_raw);
      if (!Number.isFinite(tmdb_id) || tmdb_id <= 0) {
        return jsonResponse({ code: 400, message: "tmdb_id must be a positive number." }, 400);
      }

      const url = new URL(`https://api.themoviedb.org/3/movie/${tmdb_id}`);
      url.searchParams.set("language", "en-US");
      url.searchParams.set("append_to_response", "credits,release_dates,external_ids");

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb details fetch failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();

      const title = String(tmdbJson?.title ?? "").trim();
      const year = tmdbJson?.release_date ? Number(String(tmdbJson.release_date).slice(0, 4)) : null;
      const runtime = Number.isFinite(Number(tmdbJson?.runtime)) ? Number(tmdbJson.runtime) : null;
      const isSeries = Boolean(tmdbJson?.belongs_to_collection);
      const director = extractDirectorNameFromCredits(tmdbJson?.credits);

      const genres = uniqStrings(
        (Array.isArray(tmdbJson?.genres) ? tmdbJson.genres : []).map((g) => String(g?.name ?? "").trim()),
      );
      const genre = genres.length ? genres.join(", ") : "";

      const mpa = extractUsCertification(tmdbJson?.release_dates);

      const imdb_id_raw = String(tmdbJson?.external_ids?.imdb_id ?? "").trim();
      const imdb_id = imdb_id_raw ? imdb_id_raw : null;

      const OMDB_API_KEY = Deno.env.get("OMDB_API_KEY");
      let imdb_rating_pct = null;
      let imdb_rating_error = null;
      try {
        const r = await fetchOmdbImdbRatingPercent({
          imdb_id,
          title,
          year,
          omdbApiKey: OMDB_API_KEY,
        });
        imdb_rating_pct = r?.pct ?? null;
        imdb_rating_error = r?.ok ? null : (r?.reason ?? null);
      } catch (e) {
        imdb_rating_pct = null;
        imdb_rating_error = `OMDb fetch crashed: ${String(e?.message ?? e)}`;
      }

      return jsonResponse(
        {
          tmdb_id,
          title,
          year: Number.isFinite(year) ? year : null,
          runtime,
          mpa,
          isSeries,
          director: director || "",
          genres,
          genre,
          poster_path: tmdbJson?.poster_path ? String(tmdbJson.poster_path) : null,
          imdb_id,
          imdb_rating_pct,
          ...(imdb_rating_error ? { imdb_rating_error } : {}),
        },
        200,
      );
    }

    // Public action: fetch top movie backdrops for Theme Creator.
    if (action === "backdrops") {
      const tmdb_id_raw = body?.tmdb_id ?? body?.id;
      const tmdb_id = Number(tmdb_id_raw);
      if (!Number.isFinite(tmdb_id) || tmdb_id <= 0) {
        return jsonResponse({ code: 400, message: "tmdb_id must be a positive number." }, 400);
      }

      const url = new URL(`https://api.themoviedb.org/3/movie/${tmdb_id}/images`);
      url.searchParams.set("include_image_language", "en,null");

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb backdrops fetch failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();
      const backdrops = Array.isArray(tmdbJson?.backdrops) ? tmdbJson.backdrops : [];

      const parsed = backdrops
        .filter((b) => String(b?.file_path || "").trim())
        .map((b) => ({
          file_path: String(b.file_path).trim(),
          vote_average: Number(b?.vote_average ?? 0) || 0,
          vote_count: Number(b?.vote_count ?? 0) || 0,
          width: Number(b?.width ?? 0) || 0,
          height: Number(b?.height ?? 0) || 0,
          aspect_ratio: Number(b?.aspect_ratio ?? 0) || 0,
        }));

      const sizeScore = (b) => (Number(b.width) || 0) * (Number(b.height) || 0);
      const pickByMinWidth = (minWidth) => parsed
        .filter((b) => Number(b.width) >= minWidth)
        .sort((a, b) => sizeScore(b) - sizeScore(a));

      const tier1 = pickByMinWidth(3840);
      const tier2 = pickByMinWidth(2560);
      const tier3 = pickByMinWidth(1920);

      const mapped = (tier1.length ? tier1 : (tier2.length ? tier2 : tier3))
        .slice(0, 20);

      return jsonResponse({ tmdb_id, backdrops: mapped }, 200);
    }

    // Public action: TMDb trending movies (used by the Home "Trending Now" marquee).
    if (action === "trending") {
      const time_window_raw = String(body?.time_window ?? "day").trim().toLowerCase();
      const time_window = time_window_raw === "week" ? "week" : "day";
      const limit_raw = body?.limit === null || body?.limit === undefined ? 10 : Number(body.limit);
      const limit = Number.isFinite(limit_raw) && limit_raw > 0 ? Math.min(20, Math.floor(limit_raw)) : 10;

      const url = new URL(`https://api.themoviedb.org/3/trending/movie/${time_window}`);
      url.searchParams.set("language", "en-US");

      const tmdbRes = await fetch(url.toString(), {
        headers: { Authorization: `Bearer ${TMDB_READ_ACCESS_TOKEN}` },
      });

      if (!tmdbRes.ok) {
        const details = await tmdbRes.text().catch(() => "");
        return jsonResponse(
          {
            code: 502,
            message: "TMDb trending fetch failed.",
            details: `HTTP ${tmdbRes.status}${details ? `: ${details}` : ""}`,
          },
          502,
        );
      }

      const tmdbJson = await tmdbRes.json();
      const results = Array.isArray(tmdbJson?.results) ? tmdbJson.results : [];

      const mapped = results
        .filter((r) => Number.isFinite(Number(r?.id)) && String(r?.title ?? "").trim())
        // Prefer only items with posters since this drives a poster marquee.
        .filter((r) => Boolean(String(r?.poster_path ?? "").trim()))
        .slice(0, limit)
        .map((r) => {
          const year = r?.release_date ? Number(String(r.release_date).slice(0, 4)) : null;
          const ids = Array.isArray(r?.genre_ids) ? r.genre_ids : [];
          const genres = uniqStrings(ids.map((id) => TMDB_MOVIE_GENRES[Number(id)]).filter(Boolean));
          const genre = genres.length ? genres[0] : "";
          return {
            id: Number(r.id),
            tmdb_id: Number(r.id),
            title: String(r.title).trim(),
            year: Number.isFinite(year) ? year : null,
            genres,
            genre,
            poster_path: String(r.poster_path).trim(),
          };
        });

      return jsonResponse({ results: mapped, time_window, limit }, 200);
    }

    // Verify caller is authenticated (since Verify JWT is OFF at the platform layer)
    const authHeader = req.headers.get("Authorization") ?? "";
    if (!authHeader.toLowerCase().startsWith("bearer ")) {
      return jsonResponse({ code: 401, message: "Missing Authorization bearer token." }, 401);
    }

    const supabaseUserClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      global: { headers: { Authorization: authHeader } },
    });

    const { data: userData, error: userErr } = await supabaseUserClient.auth.getUser();
    if (userErr || !userData?.user?.id) {
      return jsonResponse({ code: 401, message: "Invalid or expired session." }, 401);
    }

    if (action === "ai_picks") {
      const ANTHROPIC_API_KEY = Deno.env.get("ANTHROPIC_API_KEY");
      const ANTHROPIC_MODEL_QUERY = Deno.env.get("ANTHROPIC_MODEL_QUERY") || "claude-haiku-4-5-20251001";
      const ANTHROPIC_MODEL_RERANK = Deno.env.get("ANTHROPIC_MODEL_RERANK") || "claude-sonnet-4-6";

      const debugEnabled = Boolean(body?.debug);

      const prompt = String(body?.prompt ?? "").trim();
      if (!prompt) {
        return jsonResponse({ code: 400, message: "Missing prompt." }, 400);
      }

      const filters = body?.filters && typeof body.filters === "object" ? body.filters : {};
      let tasteProfile = {};
      const similarMoviesRaw = Array.isArray(body?.similar_movie)
        ? body.similar_movie
        : (body?.similar_movie && typeof body.similar_movie === "object" ? [body.similar_movie] : []);
      const similarMovies = similarMoviesRaw.filter((m) => m && typeof m === "object").slice(0, 5);

      try {
        const { data: tasteRows, error: tasteErr } = await supabaseAdmin
          .from("Taste Profiles")
          .select("runtime_bins_json, decade_bins_json, imdb_delta, subrating_weights_json, people_affinity_json")
          .eq("user_id", userData.user.id)
          .limit(1);
        if (!tasteErr && Array.isArray(tasteRows) && tasteRows.length > 0) {
          const row = tasteRows[0] || {};

          const runtimeBins = row?.runtime_bins_json && typeof row.runtime_bins_json === "object"
            ? row.runtime_bins_json
            : {};
          const decadeBins = row?.decade_bins_json && typeof row.decade_bins_json === "object"
            ? row.decade_bins_json
            : {};

          const topRuntime = Object.entries(runtimeBins)
            .map(([bin, info]) => ({
              bin: Number(bin),
              avg: Number(info?.avg ?? 0),
              count: Number(info?.count ?? 0),
            }))
            .filter((x) => Number.isFinite(x.bin) && Number.isFinite(x.avg) && x.count > 0)
            .sort((a, b) => (b.avg - a.avg) || (b.count - a.count))
            .slice(0, 1);

          const topDecade = Object.entries(decadeBins)
            .map(([decade, info]) => ({
              decade: Number(decade),
              avg: Number(info?.avg ?? 0),
              count: Number(info?.count ?? 0),
            }))
            .filter((x) => Number.isFinite(x.decade) && Number.isFinite(x.avg) && x.count > 0)
            .sort((a, b) => (b.avg - a.avg) || (b.count - a.count))
            .slice(0, 1);

          tasteProfile = {
            taste_profile_query: {
              preferred_runtime_bin: topRuntime.length ? topRuntime[0] : null,
              preferred_decade: topDecade.length ? topDecade[0] : null,
            },
            taste_profile_rerank: {
              imdb_delta: Number(row?.imdb_delta ?? 0),
              subrating_weights: row?.subrating_weights_json && typeof row.subrating_weights_json === "object"
                ? row.subrating_weights_json
                : {},
              people_affinity: row?.people_affinity_json && typeof row.people_affinity_json === "object"
                ? row.people_affinity_json
                : {},
            },
          };
        }
      } catch (_) {
        tasteProfile = {};
      }

      const parserSchema = {
        type: "object",
        additionalProperties: false,
        required: ["criteria", "taste_hints"],
        properties: {
          criteria: {
            type: "object",
            additionalProperties: false,
            required: [
              "genres_include",
              "release_year_from",
              "release_year_to",
              "runtime_min",
              "runtime_max",
              "tmdb_rating_min",
              "watch_region",
              "watch_providers",
            ],
            properties: {
              genres_include: { type: "array", items: { type: "string" } },
              release_year_from: { type: "integer" },
              release_year_to: { type: "integer" },
              runtime_min: { type: "integer" },
              runtime_max: { type: "integer" },
              tmdb_rating_min: { type: "integer", minimum: 0, maximum: 100 },
              watch_region: { type: "string" },
              watch_providers: { type: "array", items: { type: "string" } },
