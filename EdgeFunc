// Send a Web Push to every device a user has opted into (push_subscriptions).
// Returns the number actually delivered; deletes dead subscriptions (404/410).
// Returns 0 if VAPID secrets aren't configured (caller then falls back to SMS).
async function sendPushToUser(supabaseAdmin, userId, payload) {
  const VAPID_PUBLIC = Deno.env.get("VAPID_PUBLIC");
  const VAPID_PRIVATE = Deno.env.get("VAPID_PRIVATE");
  if (!VAPID_PUBLIC || !VAPID_PRIVATE || !userId) return 0;
  try {
    webpush.setVapidDetails(
      Deno.env.get("VAPID_SUBJECT") || "mailto:landon.talus@gmail.com",
      VAPID_PUBLIC,
      VAPID_PRIVATE,
    );
  } catch (_) { return 0; }

  const { data: subs } = await supabaseAdmin
    .from("push_subscriptions")
    .select("endpoint, p256dh, auth")
    .eq("user_id", userId);
  const rows = Array.isArray(subs) ? subs : [];
  let sent = 0;
  for (const s of rows) {
    const subscription = { endpoint: s.endpoint, keys: { p256dh: s.p256dh, auth: s.auth } };
    try {
      await webpush.sendNotification(subscription, JSON.stringify(payload));
      sent++;
    } catch (e) {
      const code = e?.statusCode || e?.status;
      if (code === 404 || code === 410) {
        try { await supabaseAdmin.from("push_subscriptions").delete().eq("endpoint", s.endpoint); } catch (_) {}
      }
    }
  }
  return sent;
}

// Record in-app Activity-inbox rows (the bell icon → dropdown/sheet). Runs
// alongside sendPushToUser at each notify site so the inbox works even when a
// recipient has push disabled, and keeps a browsable history with per-item read
// state. Inserted with the service role (bypasses RLS — clients only READ their
// own rows + flip read_at). Best-effort: never throws, so a failure here can't
// break the push flow. See notifications.sql for the table + backfill.
async function recordNotifications(supabaseAdmin, rows) {
  try {
    const clean = (Array.isArray(rows) ? rows : []).filter((r) => r && r.user_id && r.type);
    if (!clean.length) return;
    const payload = clean.map((r) => ({
      user_id: r.user_id,
      actor_id: r.actor_id || null,
      type: r.type,
      title: r.title || null,
      body: r.body || null,
      url: r.url || null,
      meta: r.meta || null,
    }));
    await supabaseAdmin.from("Notifications").insert(payload);
  } catch (_) { /* table may not exist pre-migration; never block the push */ }
}

// Total "unseen" notification count for a user's home-screen app badge (the
// little red number on the iOS PWA icon). Combines new feed activity (ratings
// from people they follow since feed_seen_at) + recommendations received since
// recs_seen_at, so the badge matches the in-app nav badges in refreshNavBadges()
// (05-feed-library.js) and stays accurate no matter which push last fired.
async function computeUnseenBadge(supabaseAdmin, userId) {
  let feed = 0, recs = 0;
  try {
    const { data: u } = await supabaseAdmin
      .from("Users").select("feed_seen_at, recs_seen_at").eq("id", userId).single();

    // Recs received since last seen.
    {
      let q = supabaseAdmin.from("Recommendations").select("id", { count: "exact", head: true }).eq("to_user_id", userId);
      if (u?.recs_seen_at) q = q.gt("created_at", u.recs_seen_at);
      const { count } = await q;
      if (typeof count === "number") recs = count;
    }

    // Feed: ratings from people this user follows, since last seen.
    {
      const { data: fr } = await supabaseAdmin
        .from("Follows").select("followed_id").eq("follower_id", userId);
      const followed = (Array.isArray(fr) ? fr : []).map((x) => x.followed_id).filter(Boolean);
      if (followed.length) {
        // Keyed on created_at (original post time), matching the in-app feed +
        // badge in 05-feed-library.js — so editing an old review doesn't re-ping.
        let q = supabaseAdmin.from("Movie Ratings").select("id", { count: "exact", head: true }).in("user_id", followed);
        if (u?.feed_seen_at) q = q.gt("created_at", u.feed_seen_at);
        const { count } = await q;
        if (typeof count === "number") feed = count;
      }
    }
  } catch (_) {}
  return feed + recs;
}

