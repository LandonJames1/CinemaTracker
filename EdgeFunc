}

function promptMentionsRuntime(prompt) {
  const p = String(prompt ?? "").toLowerCase();
  if (!p) return false;
  const explicit = /\b(runtime|length|duration|minutes?|mins?|hours?|hrs?|hr\b)\b/.test(p);
  const numeric = /\b\d{1,3}\s*(min|mins|minutes|hr|hrs|hour|hours)\b/.test(p);
  const comparative = /\b(shorter|longer)\s+than\b/.test(p);
  return explicit || numeric || comparative;
}

